  "fw: closures $invalid/$feedback do topo de um _form.phtml": {
    "prefix": "fwinvalid",
    "description": "fw: closures $invalid/$feedback do topo de um _form.phtml",
    "body": [
      "\\$invalid = fn(string \\$field): string => \\$${1:event}->errors(\\$field) !== null ? ' is-invalid' : '';",
