+    public function test_price_should_accept_comma_and_be_saved_with_dot(): void
+    {
+        foreach ([['10,50', '10.50'], ['999999,99', '999999.99'], ['7,5', '7.50'], ['0', '0.00']] as [$typed, $stored]) {
+            $event = $this->createEvent(['price' => $typed]);
+            $this->assertSame(str_replace(',', '.', $typed), $event->price, 'vírgula vira ponto no model');
+
+            $found = Event::findById($event->id);
+            $this->assertInstanceOf(Event::class, $found);
+            $this->assertSame($stored, $found->price, $typed);
+        }
+    }
+
+    public function test_price_should_reject_invalid_values(): void
+    {
+        foreach (['1e3', '-1', '10,505', '1.234,50', '1000000', 'dez'] as $value) {
+            $event = new Event($this->params(['price' => $value]));
+
+            $this->assertFalse($event->save(), $value);
+            $this->assertEquals('deve ser um valor entre 0 e 999999,99, como 10,50!', $event->errors('price'));
+            $this->assertSame($value, $event->price, 'valor inválido não é convertido');
+        }
+
+        $this->assertCount(0, Event::all());
+    }
+
