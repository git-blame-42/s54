diff --git a/lib/Validations.php b/lib/Validations.php
index f456148..dbb42d6 100644
--- a/lib/Validations.php
+++ b/lib/Validations.php
@@ -93,6 +93,28 @@ class Validations
         return true;
     }
 
+    /**
+     * Número decimal não negativo com até $digits dígitos antes e $decimals depois do separador,
+     * que pode ser vírgula ou ponto ("10,50", "10.5", "0"). Sem sinal, sem milhar e sem notação
+     * científica: FILTER_VALIDATE_FLOAT aceitaria "1e3" e "-1". O limite de dígitos acompanha a
+     * coluna DECIMAL(digits + decimals, decimals), para o INSERT não estourar. O modificador D faz
+     * o `$` recusar "10\n" (sem ele, `$` aceita uma quebra de linha no fim).
+     */
+    public static function decimal($attribute, $obj, int $digits, int $decimals)
+    {
+        $value = $obj->$attribute;
+        $pattern = '/^\d{1,' . $digits . '}([.,]\d{1,' . $decimals . '})?$/D';
+        $text = is_int($value) || is_string($value) ? (string) $value : '';
+
+        if (preg_match($pattern, $text) !== 1) {
+            $max = str_repeat('9', $digits) . ',' . str_repeat('9', $decimals);
+            $obj->addError($attribute, "deve ser um valor entre 0 e {$max}, como 10,50!");
+            return false;
+        }
+
+        return true;
+    }
+
     /**
      * A data deve existir no calendário e estar no formato $format (padrão Y-m-d).
      */
