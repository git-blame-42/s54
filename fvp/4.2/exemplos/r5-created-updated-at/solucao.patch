diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..a2468ba 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -438,6 +438,92 @@ class EventTest extends TestCase
         $this->assertEquals('events.paginate', Event::paginate(1, 5)->getRouteName());
     }
 
+    /* ------------------- created_at / updated_at ------------------- */
+
+    public function test_save_should_set_created_at_and_updated_at_on_create(): void
+    {
+        $before = date('Y-m-d H:i:s');
+        $event = $this->createEvent();
+        $after = date('Y-m-d H:i:s');
+
+        $stored = Event::findById($event->id);
+        $this->assertNotNull($stored);
+        $this->assertNotNull($stored->created_at);
+        $this->assertGreaterThanOrEqual($before, $stored->created_at);
+        $this->assertLessThanOrEqual($after, $stored->created_at);
+        $this->assertSame($stored->created_at, $stored->updated_at);
+        $this->assertSame($event->created_at, $stored->created_at);
+    }
+
+    public function test_save_should_ignore_created_at_given_on_create(): void
+    {
+        $event = $this->createEvent(['created_at' => '2001-01-01 00:00:00', 'updated_at' => '2001-01-01 00:00:00']);
+
+        $stored = Event::findById($event->id);
+        $this->assertNotNull($stored);
+        $this->assertGreaterThan('2001-01-01 00:00:00', $stored->created_at);
+        $this->assertGreaterThan('2001-01-01 00:00:00', $stored->updated_at);
+    }
+
+    public function test_save_should_change_updated_at_and_keep_created_at_on_update(): void
+    {
+        $event = $this->createEvent();
+        // Recua as duas datas (update com updated_at explícito é respeitado): evita sleep no teste.
+        $event->update(['created_at' => '2026-01-10 08:00:00', 'updated_at' => '2026-01-10 08:00:00']);
+
+        $stored = Event::findById($event->id);
+        $this->assertNotNull($stored);
+        $stored->title = 'Título Novo';
+        $this->assertTrue($stored->save());
+
+        $reloaded = Event::findById($event->id);
+        $this->assertNotNull($reloaded);
+        $this->assertSame('2026-01-10 08:00:00', $reloaded->created_at);
+        $this->assertGreaterThan('2026-01-10 08:00:00', $reloaded->updated_at);
+        $this->assertSame($stored->updated_at, $reloaded->updated_at);
+    }
+
+    public function test_invalid_save_should_not_touch_the_timestamps(): void
+    {
+        $event = $this->createEvent();
+        $event->update(['updated_at' => '2026-01-10 08:00:00']);
+        $stored = Event::findById($event->id);
+        $this->assertNotNull($stored);
+
+        $stored->title = '';
+        $this->assertFalse($stored->save());
+
+        $this->assertSame('2026-01-10 08:00:00', $stored->updated_at);
+        $this->assertSame('2026-01-10 08:00:00', Event::findById($event->id)?->updated_at);
+    }
+
+    public function test_update_should_change_updated_at_with_php_time(): void
+    {
+        $event = $this->createEvent();
+        $event->update(['created_at' => '2026-01-10 08:00:00', 'updated_at' => '2026-01-10 08:00:00']);
+
+        $before = date('Y-m-d H:i:s');
+        $event->update(['location' => 'Sala Nova']);
+        $after = date('Y-m-d H:i:s');
+
+        $reloaded = Event::findById($event->id);
+        $this->assertNotNull($reloaded);
+        $this->assertSame('Sala Nova', $reloaded->location);
+        $this->assertSame('2026-01-10 08:00:00', $reloaded->created_at);
+        // Hora do PHP, não a do MySQL (UTC): fica entre os dois instantes medidos aqui.
+        $this->assertGreaterThanOrEqual($before, $reloaded->updated_at);
+        $this->assertLessThanOrEqual($after, $reloaded->updated_at);
+    }
+
+    public function test_formatted_timestamps_should_use_brazilian_format(): void
+    {
+        $event = new Event(['created_at' => '2026-03-07 09:05:42', 'updated_at' => '2026-03-08 18:30:00']);
+
+        $this->assertSame('07/03/2026 09:05', $event->formattedCreatedAt());
+        $this->assertSame('08/03/2026 18:30', $event->formattedUpdatedAt());
+        $this->assertSame('', (new Event())->formattedCreatedAt());
+    }
+
     /* ------------------- relações ------------------- */
 
     public function test_event_should_belong_to_its_creator(): void
