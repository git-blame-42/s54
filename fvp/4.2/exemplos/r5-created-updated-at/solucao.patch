         $this->assertStringContainsString("/admin/events/{$event->id}/edit", $response);
     }
 
+    public function test_show_renders_created_and_updated_at(): void
+    {
+        $event = $this->createEvent();
+        $event->update(['created_at' => '2026-02-03 14:07:00', 'updated_at' => '2026-02-04 09:15:30']);
+
+        $response = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertMatchesRegularExpression('/<dt[^>]*>Criado em<\/dt>\s*<dd[^>]*>03\/02\/2026 14:07<\/dd>/', $response);
+        $this->assertMatchesRegularExpression('/<dt[^>]*>Atualizado em<\/dt>\s*<dd[^>]*>04\/02\/2026 09:15<\/dd>/', $response);
+    }
+
+    public function test_update_through_controller_keeps_created_at_and_touches_updated_at(): void
+    {
+        $event = $this->createEvent();
+        $event->update(['created_at' => '2026-02-03 14:07:00', 'updated_at' => '2026-02-03 14:07:00']);
+
+        $this->put(
+            action: 'update',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $event->id, 'event' => $this->validParams([
+                'title' => 'Título Novo',
+                'created_at' => '1999-01-01 00:00:00',
+            ])]
+        );
+
+        $updated = Event::findById($event->id);
+        $this->assertNotNull($updated);
+        $this->assertSame('Título Novo', $updated->title);
+        $this->assertSame('2026-02-03 14:07:00', $updated->created_at);
+        $this->assertGreaterThan('2026-02-03 14:07:00', $updated->updated_at);
+    }
+
+    public function test_index_renders_created_and_updated_at_columns(): void
+    {
+        $event = $this->createEvent(['title' => 'Evento Datado', 'capacity' => 7]);
+        $event->update(['created_at' => '2026-02-03 14:07:00', 'updated_at' => '2026-02-04 09:15:30']);
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertMatchesRegularExpression('/<th>Vagas<\/th>\s*<th>Criado em<\/th>\s*<th>Atualizado em<\/th>/', $response);
+        $this->assertMatchesRegularExpression(
+            '/0\/7<\/td>\s*<td>03\/02\/2026 14:07<\/td>\s*<td>04\/02\/2026 09:15<\/td>/',
+            $response
+        );
+    }
+
     public function test_show_with_unknown_id_redirects_to_index(): void
