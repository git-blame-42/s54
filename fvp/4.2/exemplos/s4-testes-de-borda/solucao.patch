From 73283215f23e13f562e2d15eea26dd49ae22649a Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:15:17 -0300
Subject: [PATCH] test: Add edge case tests for events

Cover invalid capacity and dates, forged ids, partial and unchanged updates, unknown ids and participant access with method override. Document current behavior where the base accepts the value or throws on save.
---
 tests/Integration/Access/EventsAccessTest.php |  40 ++++
 .../Admin/EventsControllerTest.php            | 172 ++++++++++++++++++
 tests/Unit/Models/Events/EventTest.php        | 116 ++++++++++++
 3 files changed, 328 insertions(+)

diff --git a/tests/Integration/Access/EventsAccessTest.php b/tests/Integration/Access/EventsAccessTest.php
index 4396d14..58f5c23 100644
--- a/tests/Integration/Access/EventsAccessTest.php
+++ b/tests/Integration/Access/EventsAccessTest.php
@@ -136,6 +136,46 @@ class EventsAccessTest extends TestCase
         $this->assertEquals('/login', $response->getHeaderLine('Location'));
     }
 
+    #[DataProvider('methodOverrideRoutes')]
+    public function test_events_route_should_redirect_participant_with_method_override(string $method, string $uri): void
+    {
+        $response = $this->loggedClient($this->participant)->post($uri, ['form_params' => ['_method' => $method]]);
+
+        $this->assertEquals(302, $response->getStatusCode());
+        $this->assertEquals('/dashboard', $response->getHeaderLine('Location'));
+    }
+
+    public function test_participant_should_be_redirected_to_dashboard_even_for_an_unknown_event(): void
+    {
+        $response = $this->loggedClient($this->participant)->get('/admin/events/999999/edit');
+
+        $this->assertEquals(302, $response->getStatusCode());
+        $this->assertEquals('/dashboard', $response->getHeaderLine('Location'));
+    }
+
+    public function test_participant_should_not_update_or_destroy_with_method_override(): void
+    {
+        $client = $this->loggedClient($this->participant);
+        $uri = "/admin/events/{$this->event->id}";
+
+        $client->post($uri, ['form_params' => ['_method' => 'PUT', 'event' => [
+            'title' => 'Título Alterado',
+            'description' => 'Descrição alterada.',
+            'kind' => 'workshop',
+            'modality' => 'online',
+            'audience' => ['students'],
+            'starts_on' => date('Y-m-d', strtotime('+20 days')),
+            'location' => 'Outro lugar',
+            'capacity' => '50',
+        ]]]);
+        $client->post($uri, ['form_params' => ['_method' => 'DELETE']]);
+
+        $event = Event::findById($this->event->id);
+        $this->assertNotNull($event);
+        $this->assertEquals('Palestra de Acesso', $event->title);
+        $this->assertEquals(10, $event->capacity);
+    }
+
     public function test_participant_should_not_create_update_or_destroy_events(): void
     {
         $client = $this->loggedClient($this->participant);
diff --git a/tests/Integration/Controllers/Admin/EventsControllerTest.php b/tests/Integration/Controllers/Admin/EventsControllerTest.php
index bc62d1d..4c42120 100644
--- a/tests/Integration/Controllers/Admin/EventsControllerTest.php
+++ b/tests/Integration/Controllers/Admin/EventsControllerTest.php
@@ -6,6 +6,7 @@ use App\Models\Enrollment;
 use App\Models\Event;
 use App\Models\User;
 use Lib\Authentication\Auth;
