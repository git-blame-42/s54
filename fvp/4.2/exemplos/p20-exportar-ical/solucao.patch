         $this->render('admin/events/show', compact('event', 'title'));
     }
 
+    /**
+     * P20: baixa o Evento em iCalendar. Responde com header + echo, sem render() (que poria o
+     * layout HTML em volta) e sem exit (o teste de controller precisa que a ação retorne).
+     */
+    public function ics(Request $request): void
+    {
+        $event = $this->findEvent($request);
+        if ($event === null) {
+            $this->eventNotFound();
+            return;
+        }
+
+        header('Content-Type: text/calendar; charset=utf-8');
+        header("Content-Disposition: attachment; filename=\"evento-{$event->id}.ics\"");
+        echo $event->toICalendar();
+    }
+
     public function new(): void
     {
         $event = new Event();
