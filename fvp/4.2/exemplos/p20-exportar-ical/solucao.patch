+            'VERSION:2.0',
+            'PRODID:-//UTFPR TSI34D//Eventos//PT-BR',
+            'CALSCALE:GREGORIAN',
+            'METHOD:PUBLISH',
+            'BEGIN:VEVENT',
+            "UID:event-{$this->id}@eventos.utfpr",
+            'DTSTAMP:' . gmdate('Ymd\THis\Z'),
+            'DTSTART;VALUE=DATE:' . date('Ymd', $start),
+            'DTEND;VALUE=DATE:' . date('Ymd', strtotime('+1 day', $start)),
+            'SUMMARY:' . ICalendar::escape($this->title),
+            'DESCRIPTION:' . ICalendar::escape($this->description),
+            'LOCATION:' . ICalendar::escape($this->location),
+            'END:VEVENT',
+            'END:VCALENDAR',
+        ]);
+    }
