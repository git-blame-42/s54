+    /* ------------------- P20: iCalendar ------------------- */
+
+    public function test_to_icalendar_should_describe_an_all_day_event(): void
+    {
+        $startsOn = date('Y-m-d', strtotime('+30 days'));
+        $event = $this->createEvent([
+            'title' => 'Oficina de Git, ramos; PRs',
+            'description' => "Linha 1\nLinha 2",
+            'location' => 'Bloco B, Laboratório B203',
+            'starts_on' => $startsOn,
+        ]);
+
+        $ics = $event->toICalendar();
+        $lines = explode("\r\n", $ics);
+
+        $this->assertSame('BEGIN:VCALENDAR', $lines[0]);
+        $this->assertContains('VERSION:2.0', $lines);
+        $this->assertContains('BEGIN:VEVENT', $lines);
+        $this->assertContains("UID:event-{$event->id}@eventos.utfpr", $lines);
+        $this->assertContains('DTSTART;VALUE=DATE:' . date('Ymd', strtotime($startsOn)), $lines);
+        $this->assertContains('DTEND;VALUE=DATE:' . date('Ymd', strtotime($startsOn . ' +1 day')), $lines);
+        $this->assertContains('SUMMARY:Oficina de Git\\, ramos\\; PRs', $lines);
+        $this->assertContains('DESCRIPTION:Linha 1\\nLinha 2', $lines);
+        $this->assertContains('LOCATION:Bloco B\\, Laboratório B203', $lines);
+        $this->assertMatchesRegularExpression('/\r\nDTSTAMP:\d{8}T\d{6}Z\r\n/', $ics);
+        $this->assertStringEndsWith("END:VEVENT\r\nEND:VCALENDAR\r\n", $ics);
+    }
+
+    public function test_to_icalendar_should_use_only_crlf_line_endings(): void
+    {
+        $ics = $this->createEvent(['description' => str_repeat('Descrição longa. ', 20)])->toICalendar();
+
+        $this->assertSame(0, preg_match('/(?<!\r)\n/', $ics));
+        foreach (explode("\r\n", rtrim($ics, "\r\n")) as $line) {
+            $this->assertLessThanOrEqual(75, strlen($line), $line);
+        }
+    }
