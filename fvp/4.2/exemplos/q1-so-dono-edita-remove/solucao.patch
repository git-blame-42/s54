diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..a1709ce 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -28,7 +28,8 @@ class EventsController extends Controller
 
     public function show(Request $request): void
     {
-        $event = $this->findEvent($request);
+        // Ver continua liberado para qualquer Administrador; só editar e remover exigem ser o dono.
+        $event = Event::findById((int) $request->getParam('id'));
         if ($event === null) {
             $this->eventNotFound();
             return;
@@ -129,9 +130,15 @@ class EventsController extends Controller
         $event->setAudienceList(is_array($audience) ? array_filter($audience, 'is_scalar') : []);
     }
 
+    /**
+     * Busca o Evento entre os criados pelo Administrador logado: Evento de outro Administrador
+     * vira null e cai em eventNotFound (edit, update e destroy).
+     */
     private function findEvent(Request $request): ?Event
     {
-        return Event::findById((int) $request->getParam('id'));
+        $event = $this->currentUser()?->events()->findById((int) $request->getParam('id'));
+
+        return $event instanceof Event ? $event : null;
     }
 
     private function eventNotFound(): void
