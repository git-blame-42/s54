diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..b6f99d6 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -438,6 +438,86 @@ class EventTest extends TestCase
         $this->assertEquals('events.paginate', Event::paginate(1, 5)->getRouteName());
     }
 
+    /* ------------------- anterior / próximo ------------------- */
+
+    /**
+     * Cria Eventos com os dias informados (a partir de hoje), na ordem do array (que vira a ordem de id).
+     *
+     * @param array<string, int> $daysByTitle
+     * @return array<string, Event>
+     */
+    private function createEventsOn(array $daysByTitle): array
+    {
+        $events = [];
+        foreach ($daysByTitle as $title => $days) {
+            $events[$title] = $this->createEvent([
+                'title' => $title,
+                'starts_on' => date('Y-m-d', strtotime("+{$days} days")),
+            ]);
+        }
+
+        return $events;
+    }
+
+    public function test_previous_and_next_should_follow_starts_on_not_id(): void
+    {
+        // ids: C=1, A=2, B=3; datas: A < B < C.
+        $events = $this->createEventsOn(['C' => 30, 'A' => 10, 'B' => 20]);
+
+        $this->assertSame('B', $events['A']->next()?->title);
+        $this->assertSame('C', $events['B']->next()?->title);
+        $this->assertSame('A', $events['B']->previous()?->title);
+        $this->assertSame('B', $events['C']->previous()?->title);
+    }
+
+    public function test_first_has_no_previous_and_last_has_no_next(): void
+    {
+        $events = $this->createEventsOn(['A' => 10, 'B' => 20]);
+
+        $this->assertNull($events['A']->previous());
+        $this->assertNull($events['B']->next());
+    }
+
+    public function test_single_or_new_event_has_no_neighbors(): void
+    {
+        $only = $this->createEvent();
+
+        $this->assertNull($only->previous());
+        $this->assertNull($only->next());
+        $this->assertNull((new Event($this->params()))->next());
+    }
+
+    public function test_equal_dates_should_be_ordered_by_id(): void
+    {
+        // Três Eventos no mesmo dia, entre um antes e um depois: nenhum é pulado nem repetido.
+        $events = $this->createEventsOn(['Antes' => 5, 'X' => 15, 'Y' => 15, 'Z' => 15, 'Depois' => 25]);
+
+        $this->assertSame('X', $events['Antes']->next()?->title);
+        $this->assertSame('Y', $events['X']->next()?->title);
+        $this->assertSame('Z', $events['Y']->next()?->title);
+        $this->assertSame('Depois', $events['Z']->next()?->title);
+
+        $this->assertSame('Z', $events['Depois']->previous()?->title);
+        $this->assertSame('Y', $events['Z']->previous()?->title);
+        $this->assertSame('X', $events['Y']->previous()?->title);
+        $this->assertSame('Antes', $events['X']->previous()?->title);
+    }
+
+    public function test_walking_next_should_visit_every_event_once_in_order(): void
+    {
+        $events = $this->createEventsOn(['E3' => 12, 'E1' => 3, 'E4' => 12, 'E2' => 7, 'E5' => 40]);
+
+        $visited = [];
+        $current = $events['E1'];
+        while ($current !== null) {
+            $visited[] = $current->title;
+            $current = $current->next();
+        }
+
+        $this->assertSame(['E1', 'E2', 'E3', 'E4', 'E5'], $visited);
+        $this->assertInstanceOf(Event::class, $events['E5']->previous());
+    }
+
