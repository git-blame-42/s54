+    public function test_show_of_first_and_last_events_hide_the_missing_link(): void
+    {
+        $first = $this->createEvent(['title' => 'Primeiro', 'starts_on' => date('Y-m-d', strtotime('+5 days'))]);
+        $last = $this->createEvent(['title' => 'Último', 'starts_on' => date('Y-m-d', strtotime('+30 days'))]);
+
+        $firstPage = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $first->id]);
+        $lastPage = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $last->id]);
+
+        $this->assertStringNotContainsString('Anterior', $firstPage);
+        $this->assertStringContainsString("href=\"/admin/events/{$last->id}\"", $firstPage);
+        $this->assertStringContainsString('Próximo', $firstPage);
+
+        $this->assertStringNotContainsString('Próximo', $lastPage);
+        $this->assertStringContainsString("href=\"/admin/events/{$first->id}\"", $lastPage);
+        $this->assertStringContainsString('Anterior', $lastPage);
+    }
+
+    public function test_show_of_only_event_has_no_navigation_links(): void
+    {
+        $event = $this->createEvent();
+
+        $response = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertStringNotContainsString('previous_event', $response);
+        $this->assertStringNotContainsString('next_event', $response);
+    }
