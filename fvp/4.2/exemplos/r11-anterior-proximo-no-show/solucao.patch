 app/views/admin/events/show.phtml             | 21 +++++
 .../admin/events/NavigateEventsCest.php       | 39 +++++++++
 .../Admin/EventsControllerTest.php            | 45 +++++++++++
 tests/Unit/Models/Events/EventTest.php        | 80 +++++++++++++++++++
 5 files changed, 237 insertions(+)
 create mode 100644 tests/Acceptance/admin/events/NavigateEventsCest.php

diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..68704c1 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -4,6 +4,8 @@ namespace App\Models;
 
 use Core\Database\ActiveRecord\BelongsTo;
 use Core\Database\ActiveRecord\Model;
+use Core\Database\Database;
+use PDO;
 use Lib\Validations;
 use PDOException;
 
@@ -205,6 +207,56 @@ class Event extends Model
         $this->audience = implode(',', $values);
     }
 
+    /**
+     * Evento imediatamente anterior na ordem da listagem (starts_on, depois id), ou null se este é o primeiro.
+     */
+    public function previous(): ?Event
+    {
+        return $this->neighbor('<', 'DESC');
+    }
+
+    /**
+     * Evento imediatamente seguinte na ordem da listagem (starts_on, depois id), ou null se este é o último.
+     */
+    public function next(): ?Event
+    {
+        return $this->neighbor('>', 'ASC');
+    }
+
+    /**
+     * Vizinho pela data, com desempate por id (datas iguais não pulam nem repetem Eventos).
+     * $operator e $direction vêm só de previous()/next(), nunca da requisição; os valores vão por bindValue.
+     */
+    private function neighbor(string $operator, string $direction): ?Event
+    {
+        if ($this->newRecord()) {
+            return null;
+        }
+
+        $table = static::$table;
+        $attributes = implode(', ', static::$columns);
+        $sql = <<<SQL
+            SELECT id, {$attributes} FROM {$table}
+            WHERE starts_on {$operator} :starts_on
+               OR (starts_on = :same_starts_on AND id {$operator} :id)
+            ORDER BY starts_on {$direction}, id {$direction}
+            LIMIT 1
+        SQL;
+
+        $stmt = Database::getDatabaseConn()->prepare($sql);
+        $stmt->bindValue(':starts_on', $this->starts_on);
+        $stmt->bindValue(':same_starts_on', $this->starts_on);
+        $stmt->bindValue(':id', $this->id, PDO::PARAM_INT);
+        $stmt->execute();
+
+        $row = $stmt->fetch(PDO::FETCH_ASSOC);
+        if (!is_array($row)) {
+            return null;
+        }
+
+        return new static($row);
+    }
+
     public function hasAudience(string $value): bool
     {
         return in_array($value, $this->audienceList(), true);
