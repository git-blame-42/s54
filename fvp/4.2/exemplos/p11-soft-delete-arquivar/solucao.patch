From 6011e4c42e3a6a3e6894e8e731dbc55b6e87a0b9 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:25:51 -0300
Subject: [PATCH 1/2] feat: Support null conditions as IS NULL in Paginator

---
 lib/Paginator.php | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/lib/Paginator.php b/lib/Paginator.php
index 065ee46..b33dbba 100644
--- a/lib/Paginator.php
+++ b/lib/Paginator.php
@@ -150,9 +150,10 @@ class Paginator
             return '';
         }
 
-        $sqlConditions = array_map(function ($column) {
-            return "{$column} = :{$column}";
-        }, array_keys($this->conditions));
+        // Valor null vira IS NULL (`= NULL` nunca é verdadeiro no SQL); ex.: ['deleted_at' => null].
+        $sqlConditions = array_map(function ($column, $value) {
+            return $value === null ? "{$column} IS NULL" : "{$column} = :{$column}";
+        }, array_keys($this->conditions), $this->conditions);
 
         return ' WHERE ' . implode(' AND ', $sqlConditions);
     }
@@ -164,7 +165,9 @@ class Paginator
         }
 
         foreach ($this->conditions as $column => $value) {
-            $stmt->bindValue($column, $value);
+            if ($value !== null) {
+                $stmt->bindValue($column, $value);
+            }
         }
     }
 }
-- 
