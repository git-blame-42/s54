+    /** Tamanho máximo da base do slug, deixando espaço para o sufixo "-N" em VARCHAR(255). */
+    private const SLUG_MAX_LENGTH = 240;
+
     protected static string $table = 'events';
     protected static array $columns = [
         'user_id',
         'title',
+        'slug',
         'description',
