@@ -57,9 +63,53 @@ class Event extends Model
         'capacity',
     ];
 
+    /**
+     * Na criação, gera o slug a partir do título antes de validar e gravar. Na edição o slug
+     * não muda (mesmo com título novo), para o endereço do Evento continuar valendo.
+     */
+    public function save(): bool
+    {
+        if ($this->newRecord() && ($this->slug === null || $this->slug === '')) {
+            $this->slug = self::uniqueSlug((string) $this->title);
+        }
+
+        return parent::save();
+    }
+
+    /**
+     * Slug do título que ainda não existe na tabela: "titulo", "titulo-2", "titulo-3"...
+     */
+    public static function uniqueSlug(string $title): string
+    {
+        $base = substr(StringUtils::slugify($title), 0, self::SLUG_MAX_LENGTH);
+        $base = rtrim($base, '-');
+        if ($base === '') {
+            $base = 'evento';
+        }
+
+        $slug = $base;
+        for ($suffix = 2; self::exists(['slug' => $slug]); $suffix++) {
+            $slug = "{$base}-{$suffix}";
+        }
+
+        return $slug;
+    }
+
+    public static function findBySlug(string $slug): ?Event
+    {
+        $event = self::findBy(['slug' => $slug]);
+
+        return $event instanceof Event ? $event : null;
+    }
+
     public function validates(): void
     {
         Validations::notEmpty('title', $this);
+
+        // Registro novo ainda sem slug (isValid() antes do save()) não tem o que conferir.
+        if ($this->slug !== null && $this->slug !== '') {
+            Validations::uniqueness('slug', $this);
+        }
         Validations::notEmpty('description', $this);
         Validations::notEmpty('location', $this);
 
