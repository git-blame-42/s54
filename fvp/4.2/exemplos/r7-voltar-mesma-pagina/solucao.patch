From fbfe330cffc1dbc0a0b1a18350578a7efa7345e3 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:10:07 -0300
Subject: [PATCH] feat: Return to the same listing page after removing an event

The remove form sends the current page and destroy redirects back to it (or to the last page that still exists). The form's Cancel button goes to the event's show page when editing.
---
 app/Controllers/Admin/EventsController.php    |  19 ++-
 app/views/admin/events/_form.phtml            |   3 +-
 app/views/admin/events/edit.phtml             |   1 +
 app/views/admin/events/index.phtml            |   1 +
 app/views/admin/events/new.phtml              |   1 +
 .../admin/events/DeleteEventCest.php          |  20 +++
 .../admin/events/UpdateSuccessfullyCest.php   |  14 ++
 .../Admin/EventsControllerTest.php            | 126 ++++++++++++++++++
 8 files changed, 183 insertions(+), 2 deletions(-)

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..8eddf19 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -107,7 +107,24 @@ class EventsController extends Controller
             FlashMessage::danger($event->errors('base') ?? 'Não foi possível remover o evento!');
         }
 
-        $this->redirectTo(route('admin.events.index'));
+        $this->redirectTo($this->indexUrl($request->getParam('page')));
+    }
+
+    /**
+     * URL da listagem na página de onde o usuário veio (campo oculto `page` do form de remoção).
+     * Página ausente, inválida ou 1 volta para /admin/events. Se a página deixou de existir (removeu o
+     * último Evento dela), volta para a última página que ainda existe.
+     */
+    private function indexUrl(mixed $page): string
+    {
+        if (!is_string($page) || !ctype_digit($page) || (int) $page <= 1) {
+            return route('admin.events.index');
+        }
+
+        $lastPage = Event::paginate(page: 1, per_page: self::PER_PAGE)->totalOfPages();
+        $page = min((int) $page, $lastPage);
+
+        return $page > 1 ? route('admin.events.paginate', ['page' => $page]) : route('admin.events.index');
     }
 
     /**
