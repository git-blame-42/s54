diff --git a/tests/Integration/Controllers/Admin/EventsControllerTest.php b/tests/Integration/Controllers/Admin/EventsControllerTest.php
index bc62d1d..88ea3d4 100644
--- a/tests/Integration/Controllers/Admin/EventsControllerTest.php
+++ b/tests/Integration/Controllers/Admin/EventsControllerTest.php
@@ -265,6 +265,132 @@ class EventsControllerTest extends ControllerTestCase
         );
     }
 
+    /* ------------------- voltar à mesma página ------------------- */
+
+    /**
+     * @return array<int, Event>
+     */
+    private function createEvents(int $total): array
+    {
+        $events = [];
+        for ($i = 1; $i <= $total; $i++) {
+            $events[$i] = $this->createEvent(['title' => sprintf('Evento %02d', $i)]);
+        }
+
+        return $events;
+    }
+
+    public function test_index_remove_form_sends_the_current_page(): void
+    {
+        $this->createEvents(7);
+
+        $page1 = $this->get(action: 'index', controllerName: self::CONTROLLER);
+        $page2 = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['page' => 2]);
+
+        $this->assertStringContainsString('<input type="hidden" name="page" value="1">', $page1);
+        $this->assertStringContainsString('<input type="hidden" name="page" value="2">', $page2);
+    }
+
+    public function test_destroy_returns_to_the_page_it_came_from(): void
+    {
+        $events = $this->createEvents(12);
+
+        $response = $this->delete(
+            action: 'destroy',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $events[7]->id, 'page' => '2']
+        );
+
+        $this->assertNull(Event::findById($events[7]->id));
+        $this->assertSame('Location: /admin/events/page/2', $response);
+        $this->assertEquals('Evento removido com sucesso!', $_SESSION['flash']['success']);
+    }
+
+    public function test_destroy_with_missing_invalid_or_first_page_returns_to_index(): void
+    {
+        $events = $this->createEvents(12);
+
+        // null = sem o parâmetro page. Vem primeiro porque o Request do teste acumula os parâmetros
+        // entre chamadas (addParams): depois de enviar page uma vez, ele não fica mais ausente.
+        foreach ([null, '1', '0', 'abc', '-2', '2.5', ['2']] as $index => $page) {
+            $params = ['id' => $events[$index + 1]->id];
+            if ($page !== null) {
+                $params['page'] = $page;
+            }
+
+            $response = $this->delete(action: 'destroy', controllerName: self::CONTROLLER, params: $params);
+
+            $this->assertSame('Location: /admin/events', $response, var_export($page, true));
+            $this->assertNull(Event::findById($events[$index + 1]->id));
+        }
+    }
+
+    public function test_destroy_of_the_last_event_of_a_page_returns_to_the_previous_page(): void
+    {
+        $events = $this->createEvents(11);
+
+        $response = $this->delete(
+            action: 'destroy',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $events[11]->id, 'page' => '3']
+        );
+
+        $this->assertSame('Location: /admin/events/page/2', $response);
+    }
+
+    public function test_destroy_far_beyond_the_last_page_returns_to_the_last_one(): void
+    {
+        $events = $this->createEvents(12);
+
+        $response = $this->delete(
+            action: 'destroy',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $events[1]->id, 'page' => '99']
+        );
+
+        $this->assertSame('Location: /admin/events/page/3', $response);
+    }
+
+    public function test_blocked_destroy_also_returns_to_the_same_page(): void
+    {
+        $events = $this->createEvents(12);
+        $this->enroll($events[8]);
+
+        $response = $this->delete(
+            action: 'destroy',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $events[8]->id, 'page' => '2']
+        );
+
+        $this->assertNotNull(Event::findById($events[8]->id));
+        $this->assertSame('Location: /admin/events/page/2', $response);
+        $this->assertEquals('não é possível remover um evento com inscrições (1)!', $_SESSION['flash']['danger']);
+    }
+
+    public function test_cancel_goes_to_show_on_edit_and_to_index_on_new(): void
+    {
+        $event = $this->createEvent();
+
+        $edit = $this->get(action: 'edit', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+        $new = $this->get(action: 'new', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString("href=\"/admin/events/{$event->id}\">Cancelar</a>", $edit);
+        $this->assertStringContainsString('href="/admin/events">Cancelar</a>', $new);
+    }
+
+    public function test_invalid_update_keeps_cancel_pointing_to_show(): void
+    {
+        $event = $this->createEvent();
+
+        $response = $this->put(
+            action: 'update',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $event->id, 'event' => $this->validParams(['title' => ''])]
+        );
+
+        $this->assertStringContainsString("href=\"/admin/events/{$event->id}\">Cancelar</a>", $response);
+    }
+
     /**
      * @param array<string, mixed> $overrides
      * @return array<string, mixed>
