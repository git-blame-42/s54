index 0000000..4b3e83d
--- /dev/null
+++ b/tests/Acceptance/admin/events/ScriptInTitleCest.php
@@ -0,0 +1,39 @@
+<?php
+
+namespace Tests\Acceptance\admin\events;
+
+use App\Models\Event;
+use PHPUnit\Framework\Assert;
+use Tests\Support\AcceptanceTester;
+
+/**
+ * Título com HTML aparece como texto em todas as telas e nada executa: se o `<script>` rodasse, o
+ * `alert` abriria um diálogo e o próximo passo do Selenium falharia.
+ */
+class ScriptInTitleCest extends BaseEventsCest
+{
+    private const SCRIPT = '<script>alert(1)</script>';
+
+    public function scriptInTitleIsShownAsText(AcceptanceTester $page): void
+    {
+        $page->wantTo('Cadastrar Evento com <script> no título e ver o texto literal');
+        $page->amOnPage('/admin/events/new');
+        $this->fillEventForm($page, $this->validEventData(['title' => self::SCRIPT]));
+        $page->click('Salvar');
+
+        // O banco guarda o texto como foi digitado; o escape é só na saída.
+        $event = Event::findBy(['title' => self::SCRIPT]);
+        Assert::assertInstanceOf(Event::class, $event);
+
+        $page->seeCurrentUrlEquals("/admin/events/{$event->id}");
+        $page->see('Evento cadastrado com sucesso!');
+        $page->see(self::SCRIPT, 'h1');
+        $page->see(self::SCRIPT, 'dl');
+
+        $page->amOnPage('/admin/events/page/4');
+        $page->see(self::SCRIPT, 'table');
+
+        $page->amOnPage("/admin/events/{$event->id}/edit");
+        $page->seeInField('#event_title', self::SCRIPT);
+    }
+}
diff --git a/tests/Integration/Controllers/Admin/DashboardControllerTest.php b/tests/Integration/Controllers/Admin/DashboardControllerTest.php
new file mode 100644
index 0000000..2b00c91
--- /dev/null
+++ b/tests/Integration/Controllers/Admin/DashboardControllerTest.php
@@ -0,0 +1,28 @@
+<?php
+
+namespace Tests\Integration\Controllers\Admin;
+
+use App\Models\User;
+use Lib\Authentication\Auth;
+use Tests\Integration\Controllers\ControllerTestCase;
+
+class DashboardControllerTest extends ControllerTestCase
+{
+    public function test_index_escapes_admin_name(): void
+    {
+        $admin = new User([
+            'name' => '<b>Ana</b>',
+            'email' => 'ana@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456',
+            'role' => 'admin',
+        ]);
+        $admin->save();
+        Auth::login($admin);
+
+        $html = $this->get(action: 'index', controllerName: 'App\Controllers\Admin\DashboardController');
+
+        $this->assertStringContainsString('Olá, &lt;b&gt;Ana&lt;/b&gt;!', $html);
+        $this->assertStringNotContainsString('<b>Ana</b>', $html);
+    }
+}
diff --git a/tests/Integration/Controllers/Admin/EventsControllerTest.php b/tests/Integration/Controllers/Admin/EventsControllerTest.php
index bc62d1d..d8423f8 100644
--- a/tests/Integration/Controllers/Admin/EventsControllerTest.php
+++ b/tests/Integration/Controllers/Admin/EventsControllerTest.php
@@ -6,6 +6,7 @@ use App\Models\Enrollment;
 use App\Models\Event;
 use App\Models\User;
 use Lib\Authentication\Auth;
+use Lib\FlashMessage;
 use Tests\Integration\Controllers\ControllerTestCase;
 
 class EventsControllerTest extends ControllerTestCase
@@ -265,6 +266,69 @@ class EventsControllerTest extends ControllerTestCase
         );
     }
 
+    public function test_event_title_is_escaped_once(): void
+    {
+        $event = $this->createEvent(['title' => '<b>x</b>']);
+        $pages = [
+            'index' => [],
+            'show' => ['id' => $event->id],
+            'edit' => ['id' => $event->id],
+        ];
+
+        foreach ($pages as $action => $params) {
+            $html = $this->get(action: $action, controllerName: self::CONTROLLER, params: $params);
+
+            $this->assertStringContainsString('&lt;b&gt;x&lt;/b&gt;', $html, $action);
+            $this->assertStringNotContainsString('<b>x</b>', $html, $action);
+            $this->assertStringNotContainsString('&amp;lt;', $html, $action);
+        }
+    }
+
+    public function test_show_escapes_event_title_in_page_heading_once(): void
+    {
+        $event = $this->createEvent(['title' => '<script>alert(1)</script>']);
+
+        $html = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertMatchesRegularExpression('/<h1>\s*&lt;script&gt;alert\(1\)&lt;\/script&gt;\s*<\/h1>/', $html);
+        $this->assertStringNotContainsString('<script>alert(1)</script>', $html);
+    }
+
+    public function test_navbar_escapes_user_email(): void
+    {
+        $this->admin->update(['email' => '<i>a</i>@example.com']);
+
+        $html = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString('&lt;i&gt;a&lt;/i&gt;@example.com', $html);
+        $this->assertStringNotContainsString('<i>a</i>', $html);
+    }
+
+    public function test_flash_message_is_escaped(): void
+    {
+        FlashMessage::danger('<b>x</b>');
+
+        $html = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString('<div>&lt;b&gt;x&lt;/b&gt;</div>', $html);
+        $this->assertStringNotContainsString('<b>x</b>', $html);
+    }
+
+    public function test_event_title_is_stored_without_escape(): void
+    {
+        $this->post(
+            action: 'create',
+            controllerName: self::CONTROLLER,
+            params: ['event' => $this->validParams(['title' => '<b>x</b>'])]
+        );
+
+        $event = Event::findBy(['title' => '<b>x</b>']);
+        $this->assertInstanceOf(Event::class, $event);
+
+        $html = $this->get(action: 'edit', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+        $this->assertStringContainsString('value="&lt;b&gt;x&lt;/b&gt;"', $html);
+    }
+
