+        $this->assertMatchesRegularExpression('/Evento Cheio.*?2\/2\s*<span class="badge text-bg-danger">Lotado/s', $response);
+    }
+
+    public function test_show_full_event_has_badge(): void
+    {
+        $full = $this->createEvent(['capacity' => 1]);
+        $this->enroll($full);
+        $free = $this->createEvent(['capacity' => 5]);
+
+        $fullResponse = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $full->id]);
+        $freeResponse = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $free->id]);
+
+        $this->assertStringContainsString('Lotado', $fullResponse);
+        $this->assertStringContainsString('(0 disponíveis)', $fullResponse);
+        $this->assertStringNotContainsString('Lotado', $freeResponse);
+    }
+
     public function test_new_renders_form(): void
     {
         $response = $this->get(action: 'new', controllerName: self::CONTROLLER);
