+    /**
+     * Data vinda do formulário: precisa estar em dd/mm/aaaa e é convertida aqui para Y-m-d, antes de o
+     * save() fazer o bind. Data definida pelo código (populate, testes) ou lida do banco já está em Y-m-d.
+     * A conversão vem antes de validatesStartsOnNotPast(): lá o original (Y-m-d) é comparado com este valor.
+     */
+    private function validatesStartsOnFormat(): bool
+    {
+        if (!$this->startsOnFromInput) {
+            return Validations::validDate('starts_on', $this);
+        }
+
+        if (!Validations::validDate('starts_on', $this, self::STARTS_ON_INPUT_FORMAT)) {
+            return false;
+        }
+
+        $date = DateTimeImmutable::createFromFormat('!' . self::STARTS_ON_INPUT_FORMAT, $this->starts_on);
+        if ($date === false) {
+            return false;
+        }
+
+        $this->starts_on = $date->format('Y-m-d');
+        $this->startsOnFromInput = false;
+
+        return true;
+    }
+
     /**
      * A data não pode estar no passado ao criar. Na edição, só é cobrada quando `starts_on` muda:
      * assim um Evento que já aconteceu ainda pode ter a descrição, o local etc. corrigidos.
@@ -205,6 +238,36 @@ class Event extends Model
         $this->audience = implode(',', $values);
     }
 
+    /**
+     * Recebe a data como o usuário digitou no formulário (dd/mm/aaaa). A validação confere o formato e
+     * converte para Y-m-d; texto inválido fica como veio, para o formulário mostrá-lo de volta com o erro.
+     */
+    public function setStartsOnInput(string $value): void
+    {
+        $this->starts_on = $value;
+        $this->startsOnFromInput = true;
+    }
+
+    /**
+     * Valor do campo Data do formulário: dd/mm/aaaa a partir do Y-m-d. Texto digitado que não passou na
+     * validação volta exatamente como foi digitado.
+     */
+    public function startsOnInput(): string
+    {
+        $value = (string) $this->starts_on;
+
+        if ($this->startsOnFromInput) {
+            return $value;
+        }
+
+        $date = DateTimeImmutable::createFromFormat('!Y-m-d', $value);
+        if ($date === false || $date->format('Y-m-d') !== $value) {
+            return $value;
+        }
+
+        return $date->format(self::STARTS_ON_INPUT_FORMAT);
+    }
+
     public function hasAudience(string $value): bool
     {
         return in_array($value, $this->audienceList(), true);
