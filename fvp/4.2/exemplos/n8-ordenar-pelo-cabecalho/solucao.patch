+    /* ------------------- ordenar pelo cabeçalho ------------------- */
+
+    /**
+     * Confere que os textos aparecem na resposta nesta ordem.
+     *
+     * @param array<int, string> $texts
+     */
+    private function assertInOrder(string $response, array $texts): void
+    {
+        $previous = -1;
+        foreach ($texts as $text) {
+            $position = strpos($response, $text);
+            $this->assertNotFalse($position, "{$text} não aparece");
+            $this->assertGreaterThan($previous, $position, "{$text} fora de ordem");
+            $previous = $position;
+        }
+    }
+
+    private function createSortableEvents(): void
+    {
+        // [título, dias a partir de hoje, vagas], cadastrados fora de qualquer ordem.
+        foreach ([['Delta', 4, 30], ['Alfa', 2, 50], ['Charlie', 1, 10], ['Bravo', 3, 40]] as [$title, $days, $capacity]) {
+            $this->createEvent([
+                'title' => $title,
+                'starts_on' => date('Y-m-d', strtotime("+{$days} days")),
+                'capacity' => (string) $capacity,
+            ]);
+        }
+    }
+
+    public function test_index_orders_by_starts_on_asc_by_default(): void
+    {
+        $this->createSortableEvents();
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertInOrder($response, ['Charlie', 'Alfa', 'Bravo', 'Delta']);
+        $this->assertStringContainsString('Data ▲', $response);
+    }
+
+    public function test_index_orders_by_title_asc_and_desc(): void
+    {
+        $this->createSortableEvents();
+
+        $asc = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['sort' => 'title', 'dir' => 'asc']);
+        $desc = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['sort' => 'title', 'dir' => 'desc']);
+
+        $this->assertInOrder($asc, ['Alfa', 'Bravo', 'Charlie', 'Delta']);
+        $this->assertStringContainsString('Título ▲', $asc);
+        $this->assertInOrder($desc, ['Delta', 'Charlie', 'Bravo', 'Alfa']);
+        $this->assertStringContainsString('Título ▼', $desc);
+    }
+
+    public function test_index_orders_by_capacity_desc(): void
