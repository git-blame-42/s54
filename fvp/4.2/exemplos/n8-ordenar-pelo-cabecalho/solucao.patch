@@ -114,6 +124,31 @@ class Event extends Model
         }
     }
 
+    /**
+     * Ordenação pedida pela listagem, validada contra a lista fechada. Valor inválido cai no padrão.
+     *
+     * @return array{string, string} [coluna, direção]
+     */
+    public static function normalizeSort(mixed $sort, mixed $dir): array
+    {
+        $sort = is_string($sort) && array_key_exists($sort, self::SORTABLE) ? $sort : self::DEFAULT_SORT;
+        $dir = $dir === 'asc' || $dir === 'desc' ? $dir : self::DEFAULT_DIR;
+
+        return [$sort, $dir];
+    }
+
+    /**
+     * Cláusula ORDER BY para o Paginator. Só monta SQL com valores da lista fechada; o id desempata
+     * (sempre crescente) para a ordem não mudar entre páginas.
+     */
+    public static function orderByClause(mixed $sort, mixed $dir): string
+    {
+        [$sort, $dir] = self::normalizeSort($sort, $dir);
+        $direction = $dir === 'desc' ? 'DESC' : 'ASC';
+
+        return "{$sort} {$direction}, id ASC";
+    }
+
     public function user(): BelongsTo
     {
         return $this->belongsTo(User::class, 'user_id');
