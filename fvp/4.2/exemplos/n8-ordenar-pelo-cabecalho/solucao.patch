+        );
+
+        $this->assertInOrder($response, ['Charlie', 'Alfa', 'Bravo', 'Delta']);
+        $this->assertStringContainsString('Data ▲', $response);
+        $this->assertCount(4, Event::all());
+    }
+
+    public function test_index_header_links_toggle_the_direction_of_the_active_column(): void
+    {
+        $this->createSortableEvents();
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['sort' => 'title', 'dir' => 'asc']);
+
+        $this->assertStringContainsString('href="/admin/events?sort=title&amp;dir=desc"', $response);
+        $this->assertStringContainsString('href="/admin/events?sort=starts_on&amp;dir=asc"', $response);
+        $this->assertStringContainsString('href="/admin/events?sort=capacity&amp;dir=asc"', $response);
+    }
+
+    public function test_index_keeps_sort_in_the_page_links(): void
+    {
+        for ($i = 1; $i <= 7; $i++) {
+            $this->createEvent(['title' => "Evento {$i}"]);
+        }
+
+        $page1 = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['sort' => 'title', 'dir' => 'desc']);
+        $page2 = $this->get(
+            action: 'index',
+            controllerName: self::CONTROLLER,
+            params: ['sort' => 'title', 'dir' => 'desc', 'page' => 2]
+        );
+
+        $this->assertStringContainsString('href="/admin/events/page/2?sort=title&dir=desc"', $page1);
+        // Desc: 7, 6, 5, 4, 3 na página 1; 2 e 1 na página 2.
+        $this->assertInOrder($page1, ['Evento 7', 'Evento 6', 'Evento 5', 'Evento 4', 'Evento 3']);
+        $this->assertStringNotContainsString('Evento 2', $page1);
+        $this->assertInOrder($page2, ['Evento 2', 'Evento 1']);
+    }
+
+    public function test_index_with_default_sort_keeps_page_links_without_query(): void
+    {
+        for ($i = 1; $i <= 7; $i++) {
+            $this->createEvent(['title' => "Evento {$i}"]);
+        }
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString('href="/admin/events/page/2"', $response);
+    }
