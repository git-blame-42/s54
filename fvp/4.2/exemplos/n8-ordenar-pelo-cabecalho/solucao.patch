+
+        $this->assertInOrder($response, ['Alfa', 'Bravo', 'Delta', 'Charlie']);
+    }
+
+    public function test_index_with_invalid_sort_falls_back_to_default(): void
+    {
+        $this->createSortableEvents();
+
+        $response = $this->get(
+            action: 'index',
