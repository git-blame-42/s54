     {
+        [$sort, $dir] = Event::normalizeSort($request->getParam('sort'), $request->getParam('dir'));
+        $isDefaultSort = $sort === Event::DEFAULT_SORT && $dir === Event::DEFAULT_DIR;
+
         $paginator = Event::paginate(
             page: max(1, (int) $request->getParam('page', 1)),
             per_page: self::PER_PAGE,
-            route: 'admin.events.paginate'
+            route: 'admin.events.paginate',
