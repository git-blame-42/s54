<?php
use App\Models\Event;

/**
 * Cabeçalho ordenável: link para ordenar pela coluna; clicar de novo na coluna ativa inverte a direção.
 *
 * @var string $sort
 * @var string $dir
 */
$sortHeader = function (string $column) use ($sort, $dir): string {
    $active = $column === $sort;
    $nextDir = $active && $dir === 'asc' ? 'desc' : 'asc';
    $arrow = $active ? ($dir === 'asc' ? ' ▲' : ' ▼') : '';
    $url = route('admin.events.index', ['sort' => $column, 'dir' => $nextDir]);

    return '<a class="link-dark" href="' . htmlspecialchars($url) . '">' . Event::SORTABLE[$column] . $arrow . '</a>';
};
?>
<div class="mb-3">
    <a class="btn btn-primary" href="<?= route('admin.events.new') ?>">Novo Evento</a>
</div>

<?php if (empty($events)) : ?>
    <p>Nenhum evento cadastrado.</p>
<?php else : ?>
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th><?= $sortHeader('title') ?></th>
                <th>Tipo</th>
                <th><?= $sortHeader('starts_on') ?></th>
                <th>Local</th>
                <th><?= $sortHeader('capacity') ?></th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($events as $event) : ?>
                <tr>
                    <td><?= htmlspecialchars($event->title) ?></td>
                    <td><?= Event::KINDS[$event->kind] ?? htmlspecialchars($event->kind) ?></td>
                    <td><?= date('d/m/Y', strtotime($event->starts_on)) ?></td>
                    <td><?= htmlspecialchars($event->location) ?></td>
                    <td><?= $event->enrollmentsCount() ?>/<?= (int) $event->capacity ?></td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" href="<?= route('admin.events.show', ['id' => $event->id]) ?>">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" href="<?= route('admin.events.edit', ['id' => $event->id]) ?>">Editar</a>
                        <form class="d-inline" action="<?= route('admin.events.destroy', ['id' => $event->id]) ?>" method="post">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                        </form>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>

    <?php $paginator->renderPagesNavigation(); ?>
<?php endif; ?>
