From 035fce300300df6221c1b3b3768c5aba454d6768 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:13:26 -0300
Subject: [PATCH] refactor: Move event formatting to model helpers

Event gains formattedStartsOn(), excerpt(), kindLabel() and
kindBadgeClass() (from the new KIND_BADGES map). The listing shows a
truncated description and the kind as a colored badge; the show page
uses the same helpers.
---
 app/Models/Event.php                          | 42 +++++++++++++
 app/views/admin/events/index.phtml            |  8 ++-
 app/views/admin/events/show.phtml             |  6 +-
 .../admin/events/ListEventsCest.php           |  9 +++
 .../Admin/EventsControllerTest.php            | 29 +++++++++
 tests/Unit/Models/Events/EventTest.php        | 60 +++++++++++++++++++
 6 files changed, 150 insertions(+), 4 deletions(-)

diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..eb67b05 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -4,6 +4,7 @@ namespace App\Models;
 
 use Core\Database\ActiveRecord\BelongsTo;
 use Core\Database\ActiveRecord\Model;
+use DateTime;
 use Lib\Validations;
 use PDOException;
 
@@ -29,6 +30,14 @@ class Event extends Model
         'academic_week' => 'Semana acadêmica',
     ];
 
+    /** Cor do badge (classe `text-bg-*` do Bootstrap) de cada valor de `kind`. */
+    public const KIND_BADGES = [
+        'lecture' => 'primary',
+        'workshop' => 'success',
+        'short_course' => 'warning',
+        'academic_week' => 'info',
+    ];
+
     /** Valores do ENUM `modality`, com o rótulo exibido nos formulários. */
     public const MODALITIES = [
         'in_person' => 'Presencial',
@@ -205,6 +214,39 @@ class Event extends Model
         $this->audience = implode(',', $values);
     }
 
+    /* ------------------- apresentação (usado nas views) ------------------- */
+
+    /**
+     * Data no formato brasileiro (dd/mm/aaaa). Vazio se `starts_on` não for uma data Y-m-d.
+     */
+    public function formattedStartsOn(): string
+    {
+        $date = DateTime::createFromFormat('!Y-m-d', (string) $this->starts_on);
+
+        return $date !== false ? $date->format('d/m/Y') : '';
+    }
+
+    /**
+     * Descrição cortada em até $max caracteres (contando as reticências), sem quebrar acentos.
+     * Devolve texto puro: a view aplica htmlspecialchars depois de cortar.
+     */
+    public function excerpt(int $max = 80): string
+    {
+        return mb_strimwidth((string) $this->description, 0, $max, '...', 'UTF-8');
+    }
+
+    /** Rótulo do tipo (ex.: "Palestra"); o próprio valor se não estiver em KINDS. */
+    public function kindLabel(): string
+    {
+        return self::KINDS[$this->kind] ?? (string) $this->kind;
+    }
+
+    /** Classe do badge do tipo, a partir de KIND_BADGES (cinza se o tipo não estiver no mapa). */
+    public function kindBadgeClass(): string
+    {
+        return 'text-bg-' . (self::KIND_BADGES[$this->kind] ?? 'secondary');
+    }
+
     public function hasAudience(string $value): bool
     {
         return in_array($value, $this->audienceList(), true);
