diff --git a/tests/Acceptance/admin/events/ListEventsCest.php b/tests/Acceptance/admin/events/ListEventsCest.php
index 4ede4a9..153ccb4 100644
--- a/tests/Acceptance/admin/events/ListEventsCest.php
+++ b/tests/Acceptance/admin/events/ListEventsCest.php
@@ -37,6 +37,15 @@ class ListEventsCest extends BaseEventsCest
         $page->see('0/22', $this->rowOf('Evento 02'));
         $page->see('1/23', $this->rowOf('Evento 03'));
 
+        // Tipo como badge com a cor de Event::KIND_BADGES; descrição curta na listagem.
+        foreach ([1, 2, 3] as $number) {
+            $event = $this->events[$number];
+            $badge = $this->rowOf($this->title($number)) . "//span[contains(@class, 'badge')]";
+            $page->see(Event::KINDS[$event->kind], $badge);
+            $page->seeElement($badge . "[contains(@class, 'text-bg-" . Event::KIND_BADGES[$event->kind] . "')]");
+            $page->see($event->description, $this->rowOf($this->title($number)));
+        }
+
         // Os demais Eventos ficam nas outras páginas.
         $page->dontSee($this->title(6));
         $page->dontSee($this->title(16));
diff --git a/tests/Integration/Controllers/Admin/EventsControllerTest.php b/tests/Integration/Controllers/Admin/EventsControllerTest.php
index bc62d1d..9c3dead 100644
--- a/tests/Integration/Controllers/Admin/EventsControllerTest.php
+++ b/tests/Integration/Controllers/Admin/EventsControllerTest.php
@@ -67,6 +67,35 @@ class EventsControllerTest extends ControllerTestCase
         $this->assertStringContainsString('1/10', $response);
     }
 
+    public function test_index_shows_excerpt_kind_badge_and_formatted_date(): void
+    {
+        $description = 'Uma descrição bem longa, com acentuação e mais de oitenta caracteres para ser cortada na listagem.';
+        $this->createEvent([
+            'description' => $description,
+            'kind' => 'workshop',
+            'starts_on' => date('Y-m-d', strtotime('+12 days')),
+        ]);
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString(htmlspecialchars(mb_substr($description, 0, 77)) . '...', $response);
+        $this->assertStringNotContainsString($description, $response);
+        $this->assertStringContainsString('<span class="badge text-bg-success">Oficina</span>', $response);
+        $this->assertStringContainsString(date('d/m/Y', strtotime('+12 days')), $response);
+    }
+
+    public function test_show_keeps_full_description_and_shows_kind_badge(): void
+    {
+        $description = str_repeat('Descrição completa do evento. ', 5);
+        $event = $this->createEvent(['description' => $description, 'kind' => 'short_course']);
+
+        $response = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertStringContainsString(htmlspecialchars($description), $response);
+        $this->assertStringContainsString('<span class="badge text-bg-warning">Minicurso</span>', $response);
+        $this->assertStringContainsString(date('d/m/Y', strtotime('+10 days')), $response);
+    }
+
     public function test_new_renders_form(): void
     {
         $response = $this->get(action: 'new', controllerName: self::CONTROLLER);
diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..61a8b8c 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -438,6 +438,66 @@ class EventTest extends TestCase
         $this->assertEquals('events.paginate', Event::paginate(1, 5)->getRouteName());
     }
 
+    /* ------------------- apresentação ------------------- */
+
+    public function test_formatted_starts_on_should_use_brazilian_format(): void
+    {
+        $event = new Event(['starts_on' => '2026-03-07']);
+
+        $this->assertSame('07/03/2026', $event->formattedStartsOn());
+    }
+
+    public function test_formatted_starts_on_should_be_empty_without_a_valid_date(): void
+    {
+        $this->assertSame('', (new Event())->formattedStartsOn());
+        $this->assertSame('', (new Event(['starts_on' => '07/03/2026']))->formattedStartsOn());
+    }
+
+    public function test_excerpt_should_keep_short_descriptions(): void
+    {
+        $event = new Event(['description' => 'Palestras e minicursos.']);
+
+        $this->assertSame('Palestras e minicursos.', $event->excerpt());
+    }
+
+    public function test_excerpt_should_cut_long_descriptions_with_ellipsis(): void
+    {
+        $event = new Event(['description' => str_repeat('ação ', 30)]);
+
+        $excerpt = $event->excerpt();
+
+        $this->assertSame(80, mb_strlen($excerpt));
+        $this->assertStringEndsWith('...', $excerpt);
+        $this->assertSame(mb_substr(str_repeat('ação ', 30), 0, 77), mb_substr($excerpt, 0, 77));
+        $this->assertTrue(mb_check_encoding($excerpt, 'UTF-8'));
+    }
+
+    public function test_excerpt_should_accept_a_custom_size(): void
+    {
+        $event = new Event(['description' => 'Oficina prática de testes']);
+
+        $this->assertSame('Oficina...', $event->excerpt(10));
+        $this->assertSame('Oficina prática de testes', $event->excerpt(25));
+    }
+
+    public function test_kind_label_should_come_from_kinds(): void
+    {
+        $this->assertSame('Minicurso', (new Event(['kind' => 'short_course']))->kindLabel());
+        $this->assertSame('outro', (new Event(['kind' => 'outro']))->kindLabel());
+    }
+
+    public function test_kind_badge_class_should_come_from_kind_badges(): void
+    {
+        $this->assertSame('text-bg-primary', (new Event(['kind' => 'lecture']))->kindBadgeClass());
+        $this->assertSame('text-bg-success', (new Event(['kind' => 'workshop']))->kindBadgeClass());
+        $this->assertSame('text-bg-secondary', (new Event(['kind' => 'outro']))->kindBadgeClass());
+    }
+
+    public function test_every_kind_should_have_a_badge(): void
+    {
+        $this->assertSame(array_keys(Event::KINDS), array_keys(Event::KIND_BADGES));
+    }
+
     /* ------------------- relações ------------------- */
 
     public function test_event_should_belong_to_its_creator(): void
