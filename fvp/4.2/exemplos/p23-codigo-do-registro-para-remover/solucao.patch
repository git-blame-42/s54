 database/schema.sql                           |   2 +
 .../admin/events/DeleteEventCest.php          |  31 +++-
 tests/Integration/Access/EventsAccessTest.php |  20 +++
 .../Admin/EventsControllerTest.php            | 143 +++++++++++++++++-
 tests/Unit/Models/Events/EventTest.php        |  58 +++++++
 9 files changed, 305 insertions(+), 9 deletions(-)

