From 0fe3c48c0320c9fde1bf6fc2f14fe7f0a5b0a752 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:07:49 -0300
Subject: [PATCH] feat: Filter events by kind keeping the filter in pagination

?kind= is validated against Event::KINDS. Model::paginate now passes
conditions and extra query params to the Paginator, and page links keep
?kind= via Paginator::queryParams().
---
 app/Controllers/Admin/EventsController.php    | 19 ++++-
 app/views/admin/events/index.phtml            | 19 ++++-
 app/views/paginator/_pages.phtml              |  6 +-
 core/Database/ActiveRecord/Model.php          | 17 ++++-
 lib/Paginator.php                             | 17 ++++-
 .../Admin/EventsControllerTest.php            | 70 +++++++++++++++++++
 tests/Unit/Models/Events/EventTest.php        | 25 +++++++
 7 files changed, 163 insertions(+), 10 deletions(-)

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..f9e119a 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -15,15 +15,20 @@ class EventsController extends Controller
 
     public function index(Request $request): void
     {
+        $kind = $this->kindFilter($request);
+        $filter = $kind !== null ? ['kind' => $kind] : [];
+
         $paginator = Event::paginate(
             page: max(1, (int) $request->getParam('page', 1)),
             per_page: self::PER_PAGE,
-            route: 'admin.events.paginate'
+            route: 'admin.events.paginate',
+            conditions: $filter,
+            queryParams: $filter
         );
         $events = $paginator->registers();
 
         $title = 'Eventos';
-        $this->render('admin/events/index', compact('events', 'paginator', 'title'));
+        $this->render('admin/events/index', compact('events', 'paginator', 'kind', 'title'));
     }
 
     public function show(Request $request): void
@@ -129,6 +134,16 @@ class EventsController extends Controller
         $event->setAudienceList(is_array($audience) ? array_filter($audience, 'is_scalar') : []);
     }
 
+    /**
+     * `?kind=` só vale se for uma das chaves de Event::KINDS; senão, sem filtro.
+     */
+    private function kindFilter(Request $request): ?string
+    {
+        $kind = $request->getParam('kind');
+
+        return is_string($kind) && array_key_exists($kind, Event::KINDS) ? $kind : null;
+    }
+
     private function findEvent(Request $request): ?Event
     {
         return Event::findById((int) $request->getParam('id'));
