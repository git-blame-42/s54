From b54d2be547f33503c909f36b86213a3c78d33d9b Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:08:44 -0300
Subject: [PATCH] feat: Respond 404 for unknown events and 422 for invalid
 forms

Unknown event ids in show, edit, update and destroy now render an errors/404 page with status 404 instead of a flash and redirect. Invalid create and update set status 422 before rendering the form. Statuses are checked over HTTP in EventsAccessTest.
---
 app/Controllers/Admin/EventsController.php    | 14 +++-
 app/views/errors/404.phtml                    |  3 +
 .../admin/events/NotFoundEventCest.php        | 25 +++++++
 tests/Integration/Access/EventsAccessTest.php | 69 ++++++++++++++++++-
 .../Admin/EventsControllerTest.php            | 28 +++++++-
 5 files changed, 131 insertions(+), 8 deletions(-)
 create mode 100644 app/views/errors/404.phtml
 create mode 100644 tests/Acceptance/admin/events/NotFoundEventCest.php

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..7135179 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -57,6 +57,8 @@ class EventsController extends Controller
             $this->redirectTo(route('admin.events.show', ['id' => $event->id]));
         } else {
             FlashMessage::danger('Existem dados incorretos! Por favor, verifique!');
+            // 422: o pedido chegou, mas os dados não passaram na validação.
+            http_response_code(422);
             $title = 'Novo Evento';
             $this->render('admin/events/new', compact('event', 'title'));
         }
@@ -88,6 +90,8 @@ class EventsController extends Controller
             $this->redirectTo(route('admin.events.show', ['id' => $event->id]));
         } else {
             FlashMessage::danger('Existem dados incorretos! Por favor, verifique!');
+            // 422: o pedido chegou, mas os dados não passaram na validação.
+            http_response_code(422);
             $title = 'Editar Evento';
             $this->render('admin/events/edit', compact('event', 'title'));
         }
@@ -134,9 +138,15 @@ class EventsController extends Controller
         return Event::findById((int) $request->getParam('id'));
     }
 
+    /**
+     * Evento inexistente: responde 404 com uma página própria (sem flash nem redirect).
+     * http_response_code() vem antes do render, que já imprime a página.
+     */
     private function eventNotFound(): void
     {
-        FlashMessage::danger('Evento não encontrado!');
-        $this->redirectTo(route('admin.events.index'));
+        http_response_code(404);
+
+        $title = 'Evento não encontrado';
+        $this->render('errors/404', compact('title'));
     }
 }
