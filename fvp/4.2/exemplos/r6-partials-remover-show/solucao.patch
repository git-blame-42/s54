From ea87f09b0e796b4c058e2bb4a9374a622672b59a Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:10:04 -0300
Subject: [PATCH] feat: Reuse events table partials and add Remover to show

The events listing table goes to _table.phtml and the Ver/Editar/Remover buttons to _actions.phtml. The index includes the table with actions, and the show page reuses _actions.phtml, so it gets the Remover button too.
---
 app/views/admin/events/_actions.phtml         | 17 +++++++
 app/views/admin/events/_table.phtml           | 44 +++++++++++++++++++
 app/views/admin/events/index.phtml            | 35 ++-------------
 app/views/admin/events/show.phtml             |  7 ++-
 .../admin/events/DeleteEventCest.php          | 17 +++++++
 .../Admin/EventsControllerTest.php            | 29 ++++++++++++
 6 files changed, 116 insertions(+), 33 deletions(-)
 create mode 100644 app/views/admin/events/_actions.phtml
 create mode 100644 app/views/admin/events/_table.phtml

diff --git a/app/views/admin/events/_actions.phtml b/app/views/admin/events/_actions.phtml
new file mode 100644
index 0000000..9a98b27
--- /dev/null
+++ b/app/views/admin/events/_actions.phtml
@@ -0,0 +1,17 @@
+<?php
+/**
+ * Botões de ação de um Evento: Ver (opcional), Editar e Remover (form com _method=DELETE).
+ * Usado em cada linha de _table.phtml e no show.
+ *
+ * @var \App\Models\Event $event
+ * @var bool $withView quando true, mostra o botão Ver (no próprio show não faz sentido)
+ */
+?>
+<?php if ($withView) : ?>
+    <a class="btn btn-sm btn-outline-secondary" href="<?= route('admin.events.show', ['id' => $event->id]) ?>">Ver</a>
+<?php endif; ?>
+<a class="btn btn-sm btn-outline-primary" href="<?= route('admin.events.edit', ['id' => $event->id]) ?>">Editar</a>
+<form class="d-inline" action="<?= route('admin.events.destroy', ['id' => $event->id]) ?>" method="post">
+    <input type="hidden" name="_method" value="DELETE">
+    <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
+</form>
diff --git a/app/views/admin/events/_table.phtml b/app/views/admin/events/_table.phtml
new file mode 100644
index 0000000..8b46b85
--- /dev/null
+++ b/app/views/admin/events/_table.phtml
@@ -0,0 +1,44 @@
+<?php
+/**
+ * Tabela de Eventos (título, tipo, data, local, vagas e, opcionalmente, ações).
+ * Quem inclui define as variáveis antes do require (o render faz extract no mesmo escopo).
+ *
+ * @var array<\App\Models\Event> $events
+ * @var bool $showActions quando true, acrescenta a coluna Ações (Ver, Editar, Remover)
+ */
+use App\Models\Event;
+
+?>
+<table class="table table-striped align-middle">
+    <thead>
+        <tr>
+            <th>Título</th>
+            <th>Tipo</th>
+            <th>Data</th>
+            <th>Local</th>
+            <th>Vagas</th>
+            <?php if ($showActions) : ?>
+                <th>Ações</th>
+            <?php endif; ?>
+        </tr>
+    </thead>
+    <tbody>
+        <?php foreach ($events as $event) : ?>
+            <tr>
+                <td><?= htmlspecialchars($event->title) ?></td>
+                <td><?= Event::KINDS[$event->kind] ?? htmlspecialchars($event->kind) ?></td>
+                <td><?= date('d/m/Y', strtotime($event->starts_on)) ?></td>
+                <td><?= htmlspecialchars($event->location) ?></td>
+                <td><?= $event->enrollmentsCount() ?>/<?= (int) $event->capacity ?></td>
+                <?php if ($showActions) : ?>
+                    <td>
+                        <?php
+                        $withView = true;
+                        require __DIR__ . '/_actions.phtml';
+                        ?>
+                    </td>
+                <?php endif; ?>
+            </tr>
+        <?php endforeach; ?>
+    </tbody>
+</table>
