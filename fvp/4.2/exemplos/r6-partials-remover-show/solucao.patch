     }
 
+    public function test_show_has_edit_and_remove_but_not_view(): void
+    {
+        $event = $this->createEvent(['title' => 'Palestra Final']);
+
+        $response = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertStringContainsString(
+            "<form class=\"d-inline\" action=\"/admin/events/{$event->id}\" method=\"post\">",
+            $response
+        );
+        $this->assertStringContainsString('name="_method" value="DELETE"', $response);
+        $this->assertStringContainsString('>Remover</button>', $response);
+        $this->assertStringContainsString("href=\"/admin/events/{$event->id}/edit\">Editar</a>", $response);
+        $this->assertStringNotContainsString('>Ver</a>', $response);
+        $this->assertStringContainsString('href="/admin/events">Voltar</a>', $response);
+    }
+
+    public function test_index_rows_have_view_edit_and_remove_actions(): void
+    {
+        $event = $this->createEvent(['title' => 'Evento da Tabela']);
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString('<th>Ações</th>', $response);
+        $this->assertStringContainsString("href=\"/admin/events/{$event->id}\">Ver</a>", $response);
+        $this->assertStringContainsString("href=\"/admin/events/{$event->id}/edit\">Editar</a>", $response);
+        $this->assertStringContainsString("action=\"/admin/events/{$event->id}\" method=\"post\"", $response);
+    }
+
