diff --git a/tests/Acceptance/admin/events/DeleteEventCest.php b/tests/Acceptance/admin/events/DeleteEventCest.php
index a7af30a..525ad39 100644
--- a/tests/Acceptance/admin/events/DeleteEventCest.php
+++ b/tests/Acceptance/admin/events/DeleteEventCest.php
@@ -47,6 +47,23 @@ class DeleteEventCest extends BaseEventsCest
         Assert::assertCount(self::TOTAL_EVENTS, Event::all());
     }
 
+    public function deleteEventFromShowPage(AcceptanceTester $page): void
+    {
+        $event = $this->events[2];
+
+        $page->wantTo('Remoção do registro pela tela de detalhes');
+        $page->amOnPage("/admin/events/{$event->id}");
+        $page->see($event->title, 'h1');
+        $page->dontSeeLink('Ver');
+
+        $page->click('Remover', 'main');
+
+        $page->seeCurrentUrlEquals('/admin/events');
+        $page->see('Evento removido com sucesso!');
+        $page->dontSee('Evento 02', 'table');
+        Assert::assertNull(Event::findById((int) $event->id));
+    }
+
     private function clickRemove(AcceptanceTester $page, string $title): void
     {
         // Remover é um form com _method=DELETE e botão "Remover", sem confirm() (contrato-ui-eventos.md).
