Subject: [PATCH] feat: Add seminar to event kinds
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

New value in the kind ENUM of the schema and in Event::KINDS, with the
label Seminário. Model tests now save() every kind, which catches a
value missing from the ENUM.
---
 app/Models/Event.php                          |  1 +
 database/schema.sql                           |  2 +-
 .../admin/events/CreateSeminarCest.php        | 30 +++++++++++++++++++
 .../Admin/EventsControllerTest.php            | 21 +++++++++++++
 tests/Unit/Models/Events/EventTest.php        | 20 +++++++++++++
 5 files changed, 73 insertions(+), 1 deletion(-)
 create mode 100644 tests/Acceptance/admin/events/CreateSeminarCest.php

diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..09f9b52 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -27,6 +27,7 @@ class Event extends Model
         'workshop' => 'Oficina',
         'short_course' => 'Minicurso',
         'academic_week' => 'Semana acadêmica',
+        'seminar' => 'Seminário',
     ];
 
     /** Valores do ENUM `modality`, com o rótulo exibido nos formulários. */
diff --git a/database/schema.sql b/database/schema.sql
index fe7f1d6..015729c 100644
--- a/database/schema.sql
+++ b/database/schema.sql
@@ -23,7 +23,7 @@ CREATE TABLE events (
     user_id     INT NOT NULL,
     title       VARCHAR(255) NOT NULL,
     description TEXT NOT NULL,
-    kind        ENUM('lecture', 'workshop', 'short_course', 'academic_week') NOT NULL,
+    kind        ENUM('lecture', 'workshop', 'short_course', 'academic_week', 'seminar') NOT NULL,
     modality    ENUM('in_person', 'online', 'hybrid') NOT NULL DEFAULT 'in_person',
     audience    SET('students', 'professors', 'staff', 'community') NOT NULL,
     starts_on   DATE NOT NULL,
diff --git a/tests/Acceptance/admin/events/CreateSeminarCest.php b/tests/Acceptance/admin/events/CreateSeminarCest.php
new file mode 100644
index 0000000..db8ed5b
--- /dev/null
+++ b/tests/Acceptance/admin/events/CreateSeminarCest.php
@@ -0,0 +1,30 @@
+<?php
+
+namespace Tests\Acceptance\admin\events;
+
+use App\Models\Event;
+use PHPUnit\Framework\Assert;
+use Tests\Support\AcceptanceTester;
+
+class CreateSeminarCest extends BaseEventsCest
+{
+    public function createEventWithSeminarKind(AcceptanceTester $page): void
+    {
+        $data = $this->validEventData(['title' => 'Seminário de Pesquisa', 'kind' => Event::KINDS['seminar']]);
+
+        $page->wantTo('Cadastro de Evento com o tipo novo Seminário');
+        $page->amOnPage('/admin/events/new');
+        $page->see('Seminário', '#event_kind');
+
+        $this->fillEventForm($page, $data);
+        $page->click('Salvar');
+
+        $page->see('Evento cadastrado com sucesso!');
+        $page->see('Seminário de Pesquisa', 'h1');
+        $page->see('Seminário', 'dd');
+
+        $event = Event::findBy(['title' => 'Seminário de Pesquisa']);
+        Assert::assertNotNull($event);
+        Assert::assertSame('seminar', $event->kind);
+    }
+}
diff --git a/tests/Integration/Controllers/Admin/EventsControllerTest.php b/tests/Integration/Controllers/Admin/EventsControllerTest.php
index bc62d1d..8a3ec8e 100644
--- a/tests/Integration/Controllers/Admin/EventsControllerTest.php
+++ b/tests/Integration/Controllers/Admin/EventsControllerTest.php
@@ -98,6 +98,27 @@ class EventsControllerTest extends ControllerTestCase
         $this->assertEquals('Evento cadastrado com sucesso!', $_SESSION['flash']['success']);
     }
 
+    public function test_create_with_seminar_kind_saves_and_shows_label(): void
+    {
+        $form = $this->get(action: 'new', controllerName: self::CONTROLLER);
+        $this->assertStringContainsString('<option value="seminar" >Seminário</option>', $form);
+
+        $this->post(
+            action: 'create',
+            controllerName: self::CONTROLLER,
+            params: ['event' => $this->validParams(['title' => 'Seminário de Pesquisa', 'kind' => 'seminar'])]
+        );
+
+        $event = Event::findBy(['title' => 'Seminário de Pesquisa']);
+        $this->assertNotNull($event);
+        $this->assertSame('seminar', $event->kind);
+
+        $index = $this->get(action: 'index', controllerName: self::CONTROLLER);
+        $show = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+        $this->assertMatchesRegularExpression('/Seminário de Pesquisa<\/td>\s*<td>Seminário<\/td>/', $index);
+        $this->assertMatchesRegularExpression('/<dt[^>]*>Tipo<\/dt>\s*<dd[^>]*>Seminário<\/dd>/', $show);
+    }
+
     public function test_create_ignores_user_id_sent_by_the_form(): void
     {
         $this->post(
diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..5ee14e5 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -144,6 +144,26 @@ class EventTest extends TestCase
         }
     }
 
+    public function test_kind_should_save_every_enum_value(): void
+    {
+        // save() faz o INSERT: pega valor que está em KINDS mas falta no ENUM do schema (isValid() não pega).
+        foreach (array_keys(Event::KINDS) as $kind) {
+            $event = $this->createEvent(['title' => "Evento {$kind}", 'kind' => $kind]);
+
+            $this->assertSame($kind, Event::findById($event->id)?->kind, $kind);
+        }
+    }
+
+    public function test_kind_seminar_should_be_saved_with_its_label(): void
+    {
+        $event = $this->createEvent(['kind' => 'seminar']);
+
+        $stored = Event::findById($event->id);
+        $this->assertNotNull($stored);
+        $this->assertSame('seminar', $stored->kind);
+        $this->assertSame('Seminário', Event::KINDS[$stored->kind]);
+    }
+
     public function test_kind_outside_enum_should_be_invalid(): void
     {
         $event = new Event($this->params(['kind' => 'concert']));
