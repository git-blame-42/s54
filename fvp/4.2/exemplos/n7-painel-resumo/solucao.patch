@@ -4,7 +4,9 @@ namespace App\Models;
 
 use Core\Database\ActiveRecord\BelongsTo;
 use Core\Database\ActiveRecord\Model;
+use Core\Database\Database;
 use Lib\Validations;
+use PDO;
 use PDOException;
 
 /**
@@ -114,6 +116,59 @@ class Event extends Model
         }
     }
 
+    /**
+     * Total de Eventos por tipo, numa consulta só (GROUP BY). Todo tipo de KINDS aparece, com 0 se não
+     * houver Evento dele; a ordem é a de KINDS.
+     *
+     * @return array<string, int>
+     */
+    public static function countByKind(): array
+    {
+        $table = static::$table;
+        $sql = <<<SQL
+            SELECT kind, COUNT(*) AS total FROM {$table} GROUP BY kind;
+        SQL;
+
+        $stmt = Database::getDatabaseConn()->prepare($sql);
+        $stmt->execute();
+
+        $counts = array_fill_keys(array_keys(self::KINDS), 0);
+        foreach ($stmt->fetchAll(PDO::FETCH_ASSOC) as $row) {
+            $counts[(string) $row['kind']] = (int) $row['total'];
+        }
+
+        return $counts;
+    }
+
+    /**
+     * Próximos Eventos: data de hoje em diante, do mais próximo ao mais distante (empate pelo id).
+     *
+     * @return array<static>
+     */
+    public static function upcoming(int $limit = 3): array
+    {
+        $table = static::$table;
+        $attributes = implode(', ', static::$columns);
+        $sql = <<<SQL
+            SELECT id, {$attributes} FROM {$table}
+            WHERE starts_on >= :today
+            ORDER BY starts_on ASC, id ASC
+            LIMIT :limit;
+        SQL;
+
+        $stmt = Database::getDatabaseConn()->prepare($sql);
+        $stmt->bindValue(':today', date('Y-m-d'));
+        $stmt->bindValue(':limit', max(0, $limit), PDO::PARAM_INT);
+        $stmt->execute();
+
+        $events = [];
+        foreach ($stmt->fetchAll(PDO::FETCH_ASSOC) as $row) {
+            $events[] = new static($row);
+        }
+
+        return $events;
+    }
+
     public function user(): BelongsTo
     {
         return $this->belongsTo(User::class, 'user_id');
