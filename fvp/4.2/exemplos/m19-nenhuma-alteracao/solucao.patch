diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..27f36b0 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -114,6 +114,50 @@ class Event extends Model
         }
     }
 
+    /**
+     * Diz se algum campo difere do que está gravado. O original é buscado UMA vez e
+     * comparado coluna a coluna, com os valores normalizados (ver comparableValue).
+     * Registro novo (ou que sumiu do banco) sempre tem alterações.
+     */
+    public function hasChanges(): bool
+    {
+        if ($this->newRecord()) {
+            return true;
+        }
+
+        $original = self::findById($this->id);
+        if ($original === null) {
+            return true;
+        }
+
+        foreach (static::$columns as $column) {
+            if (self::comparableValue($column, $original->$column) !== self::comparableValue($column, $this->$column)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    /**
+     * Valor em forma comparável. O banco devolve capacity como int (20) e o formulário como
+     * string ('20'); o SET volta na ordem da definição da coluna, não na ordem enviada; o
+     * navegador envia as quebras de linha do textarea como \r\n.
+     */
+    private static function comparableValue(string $column, mixed $value): string
+    {
+        $value = is_scalar($value) ? (string) $value : '';
+
+        if ($column === 'audience') {
+            $values = explode(',', $value);
+            sort($values);
+
+            return implode(',', $values);
+        }
+
+        return str_replace("\r\n", "\n", $value);
+    }
+
     public function user(): BelongsTo
     {
         return $this->belongsTo(User::class, 'user_id');
diff --git a/lib/FlashMessage.php b/lib/FlashMessage.php
