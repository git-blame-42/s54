     }
 
+    public static function warning(string $value): void
+    {
+        self::message('warning', $value);
+    }
+
     public static function get(): array
     {
         $flash = $_SESSION['flash'] ?? [];
diff --git a/tests/Acceptance/admin/events/UpdateSuccessfullyCest.php b/tests/Acceptance/admin/events/UpdateSuccessfullyCest.php
index 0f64d87..9bf9ffb 100644
--- a/tests/Acceptance/admin/events/UpdateSuccessfullyCest.php
+++ b/tests/Acceptance/admin/events/UpdateSuccessfullyCest.php
@@ -90,4 +90,38 @@ class UpdateSuccessfullyCest extends BaseEventsCest
         Assert::assertEquals(10, $stored->capacity);
         Assert::assertSame(3, $stored->enrollmentsCount());
     }
+
+    public function saveWithoutChangesShowsWarning(AcceptanceTester $page): void
+    {
+        $event = $this->events[3];
+        // Quebra de linha gravada como \n: o navegador devolve o textarea com \r\n.
+        Assert::assertTrue($event->update(['description' => "Linha 1\nLinha 2"]));
+
+        $page->wantTo('Salvar sem mudar nada avisa "Nenhuma alteração" e não diz que atualizou');
+        $page->amOnPage("/admin/events/{$event->id}/edit");
+        $page->click('Salvar');
+
+        $page->seeCurrentUrlEquals("/admin/events/{$event->id}");
+        $page->see('Nenhuma alteração foi feita no evento.', '.alert-warning');
+        $page->dontSee('Evento atualizado com sucesso!');
+        $page->see('Evento 03', 'h1');
+
+        $stored = Event::findById((int) $event->id);
+        Assert::assertNotNull($stored);
+        Assert::assertSame("Linha 1\nLinha 2", $stored->description);
+        Assert::assertSame(['students', 'professors'], $stored->audienceList());
+    }
+
+    public function saveAfterChangingOnlyOneFieldStillUpdates(AcceptanceTester $page): void
+    {
+        $event = $this->events[3];
+
+        $page->wantTo('Mudar só a capacidade continua atualizando');
+        $page->amOnPage("/admin/events/{$event->id}/edit");
+        $this->fillEventForm($page, ['capacity' => (string) ((int) $event->capacity + 1)]);
+        $page->click('Salvar');
+
+        $page->see('Evento atualizado com sucesso!', '.alert-success');
+        $page->dontSee('Nenhuma alteração foi feita no evento.');
+    }
 }
