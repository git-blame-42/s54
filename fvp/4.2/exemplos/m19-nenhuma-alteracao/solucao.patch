diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..889ebac 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -681,4 +681,78 @@ class EventTest extends TestCase
 
         $event->destroy();
     }
+
+    /* ------------------- hasChanges (nenhuma alteração) ------------------- */
+
+    public function test_has_changes_should_be_true_for_a_new_record(): void
+    {
+        $this->assertTrue((new Event($this->params()))->hasChanges());
+    }
+
+    public function test_has_changes_should_be_false_right_after_loading(): void
+    {
+        $event = $this->createEvent();
+
+        $found = Event::findById($event->id);
+
+        $this->assertInstanceOf(Event::class, $found);
+        $this->assertFalse($found->hasChanges());
+    }
+
+    public function test_has_changes_should_be_false_with_the_same_values_as_form_strings(): void
+    {
+        $event = $this->createEvent(['capacity' => 20]);
+
+        // O formulário entrega tudo como string: capacity '20' contra o int 20 do banco.
+        foreach ($this->params(['capacity' => 20]) as $column => $value) {
+            $event->$column = (string) $value;
+        }
+
+        $this->assertFalse($event->hasChanges());
+    }
+
+    public function test_has_changes_should_ignore_the_order_of_audience(): void
+    {
+        $event = $this->createEvent(['audience' => 'students,professors']);
+
+        $event->setAudienceList(['professors', 'students']);
+
+        $this->assertFalse($event->hasChanges());
+    }
+
+    public function test_has_changes_should_ignore_crlf_line_breaks_in_description(): void
+    {
+        $event = $this->createEvent(['description' => "Linha 1\nLinha 2"]);
+
+        $event->description = "Linha 1\r\nLinha 2";
+
+        $this->assertFalse($event->hasChanges());
+    }
+
+    /**
+     * @return array<string, array{string, string}>
+     */
+    public static function changedFieldProvider(): array
+    {
+        return [
+            'title' => ['title', 'Outro título'],
+            'description' => ['description', 'Outra descrição.'],
+            'kind' => ['kind', 'workshop'],
+            'modality' => ['modality', 'online'],
+            'audience' => ['audience', 'students'],
+            'starts_on' => ['starts_on', date('Y-m-d', strtotime('+31 days'))],
+            'location' => ['location', 'Bloco B'],
+            'capacity' => ['capacity', '11'],
+        ];
+    }
+
+    #[DataProvider('changedFieldProvider')]
+    public function test_has_changes_should_detect_each_changed_field(string $field, string $value): void
+    {
+        $event = $this->createEvent();
+
+        $event->$field = $value;
+
+        $this->assertTrue($event->hasChanges());
+    }
 }
