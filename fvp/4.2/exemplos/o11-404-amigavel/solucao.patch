diff --git a/core/Errors/ErrorsHandler.php b/core/Errors/ErrorsHandler.php
index 048c727..815f544 100644
--- a/core/Errors/ErrorsHandler.php
+++ b/core/Errors/ErrorsHandler.php
@@ -2,7 +2,10 @@
 
 namespace Core\Errors;
 
+use Core\Constants\Constants;
 use Core\Exceptions\HTTPException;
+use ErrorException;
+use Throwable;
 
 class ErrorsHandler
 {
@@ -23,6 +26,13 @@ class ErrorsHandler
         return function ($e) {
             ob_end_clean(); // Discard the buffered output
 
+            // APP_ENV é lido aqui, e não no init(): o bootstrap chama init() antes do EnvLoader::init().
+            $view = self::viewFor($e, self::currentEnv());
+            if ($view !== null) {
+                self::sendFriendlyPage($view);
+                return;
+            }
+
             if ($e instanceof HTTPException) {
                 header('HTTP/1.1 ' . $e->getStatusCode() . ' ' . $e->getMessage());
             } else {
@@ -51,6 +61,12 @@ class ErrorsHandler
         return function ($errorNumber, $errorStr, $file, $line) {
             ob_end_clean(); // Discard the buffered output
 
+            $view = self::viewFor(new ErrorException($errorStr, 0, $errorNumber, $file, $line), self::currentEnv());
+            if ($view !== null) {
+                self::sendFriendlyPage($view);
+                exit();
+            }
+
             header('HTTP/1.1 500 Internal Server Error');
 
             switch ($errorNumber) {
@@ -85,4 +101,54 @@ class ErrorsHandler
             exit();
         };
     }
+
+    /**
+     * View amigável para o erro: 'errors/404' para HTTPException 404, 'errors/500' para o resto.
+     * Em development devolve null: o handler mantém mensagem, arquivo, linha e stack trace.
+     */
+    public static function viewFor(Throwable $e, string $env): ?string
+    {
+        if ($env === 'development') {
+            return null;
+        }
+
+        if ($e instanceof HTTPException && $e->getStatusCode() === 404) {
+            return 'errors/404';
+        }
+
+        return 'errors/500';
+    }
+
+    /**
+     * APP_ENV vem do $_ENV (o EnvLoader grava só ali, sem putenv; no php_test ele copia o
+     * APP_ENV=testing do compose). Sem valor (erro antes do EnvLoader), vale 'production'.
+     */
+    public static function currentEnv(): string
+    {
+        $env = $_ENV['APP_ENV'] ?? null;
+
+        return is_string($env) && $env !== '' ? $env : 'production';
+    }
+
+    /**
+     * HTML da view de erro. A view é incluída direto (sem Controller::render()): o layout depende
+     * de sessão e usuário, e se ele falhar o handler entraria em laço.
+     */
+    public static function friendlyPage(string $view): string
+    {
+        ob_start();
+        require Constants::rootPath()->join("app/views/{$view}.phtml");
+        return (string) ob_get_clean();
+    }
+
+    private static function sendFriendlyPage(string $view): void
+    {
+        if ($view === 'errors/404') {
+            header('HTTP/1.1 404 Not Found');
+        } else {
+            header('HTTP/1.1 500 Internal Server Error');
+        }
+
+        echo self::friendlyPage($view);
+    }
 }
diff --git a/tests/Acceptance/errors/NotFoundCest.php b/tests/Acceptance/errors/NotFoundCest.php
new file mode 100644
index 0000000..8310c54
--- /dev/null
+++ b/tests/Acceptance/errors/NotFoundCest.php
@@ -0,0 +1,27 @@
+<?php
+
+namespace Tests\Acceptance\errors;
+
+use Tests\Acceptance\BaseAcceptanceCest;
+use Tests\Support\AcceptanceTester;
+
+/**
+ * O navegador de teste usa a porta 8080 (php_test, APP_ENV=testing): fora de development a rota
+ * inexistente mostra a página amigável, sem stack trace.
+ */
+class NotFoundCest extends BaseAcceptanceCest
+{
+    public function seeFriendlyNotFoundPage(AcceptanceTester $page): void
+    {
+        $page->amOnPage('/rota-que-nao-existe');
+
+        $page->see('Página não encontrada', '//h1');
+        $page->see('404', '#error_status');
+        $page->dontSee('Stack Trace');
+        $page->dontSee('Router.php');
+
+        $page->click('Voltar ao início');
+        $page->seeCurrentUrlEquals('/');
+        $page->see('Home Page', '//h1');
+    }
+}
diff --git a/tests/Integration/Access/NotFoundAccessTest.php b/tests/Integration/Access/NotFoundAccessTest.php
new file mode 100644
index 0000000..02ad1fe
--- /dev/null
+++ b/tests/Integration/Access/NotFoundAccessTest.php
@@ -0,0 +1,39 @@
+<?php
+
+namespace Tests\Integration\Access;
+
+use GuzzleHttp\Client;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Rota inexistente pela porta 8080 (php_test, APP_ENV=testing, ou seja, fora de development):
+ * 404 com a página amigável, sem stack trace nem caminho de arquivo.
+ */
+class NotFoundAccessTest extends TestCase
+{
+    private Client $client;
+
+    public function setUp(): void
+    {
+        parent::setUp();
+        $this->client = new Client([
+            'allow_redirects' => false,
+            'http_errors' => false,
+            'base_uri' => 'http://web:8080'
+        ]);
+    }
+
+    public function test_unknown_route_returns_friendly_404_page(): void
+    {
+        $response = $this->client->get('/rota-que-nao-existe');
+        $body = (string) $response->getBody();
+
+        $this->assertEquals(404, $response->getStatusCode());
+        $this->assertEquals('Not Found', $response->getReasonPhrase());
+        $this->assertStringContainsString('Página não encontrada', $body);
+        $this->assertStringContainsString('Voltar ao início', $body);
+        $this->assertStringNotContainsString('Stack Trace', $body);
+        $this->assertStringNotContainsString('rota-que-nao-existe', $body);
+        $this->assertStringNotContainsString('/var/www', $body);
+    }
+}
diff --git a/tests/Unit/Core/Errors/ErrorsHandlerTest.php b/tests/Unit/Core/Errors/ErrorsHandlerTest.php
new file mode 100644
index 0000000..77a182c
--- /dev/null
+++ b/tests/Unit/Core/Errors/ErrorsHandlerTest.php
@@ -0,0 +1,87 @@
+<?php
+
+namespace Tests\Unit\Core\Errors;
+
+use Core\Errors\ErrorsHandler;
+use Core\Exceptions\HTTPException;
+use ErrorException;
+use PHPUnit\Framework\TestCase;
+use RuntimeException;
+
+class ErrorsHandlerTest extends TestCase
+{
+    private mixed $originalEnv;
+
+    public function setUp(): void
+    {
+        $this->originalEnv = $_ENV['APP_ENV'] ?? null;
+    }
+
+    public function tearDown(): void
+    {
+        if ($this->originalEnv === null) {
+            unset($_ENV['APP_ENV']);
+        } else {
+            $_ENV['APP_ENV'] = $this->originalEnv;
+        }
+    }
+
+    public function test_view_for_not_found_outside_development_is_404_page(): void
+    {
+        $e = new HTTPException('URI /x not found.', 404);
+
+        $this->assertSame('errors/404', ErrorsHandler::viewFor($e, 'production'));
+        $this->assertSame('errors/404', ErrorsHandler::viewFor($e, 'testing'));
+    }
+
+    public function test_view_for_other_errors_outside_development_is_500_page(): void
+    {
+        $this->assertSame('errors/500', ErrorsHandler::viewFor(new RuntimeException('falhou'), 'production'));
+        $this->assertSame('errors/500', ErrorsHandler::viewFor(new \Error('erro fatal'), 'production'));
+        $this->assertSame('errors/500', ErrorsHandler::viewFor(new ErrorException('warning'), 'production'));
+        $this->assertSame('errors/500', ErrorsHandler::viewFor(new HTTPException('teapot', 418), 'production'));
+    }
+
+    public function test_view_for_in_development_is_null_to_keep_stack_trace(): void
+    {
+        $this->assertNull(ErrorsHandler::viewFor(new HTTPException('URI /x not found.', 404), 'development'));
+        $this->assertNull(ErrorsHandler::viewFor(new RuntimeException('falhou'), 'development'));
+    }
+
+    public function test_current_env_reads_dot_env_values(): void
+    {
+        $_ENV['APP_ENV'] = 'development';
+
+        $this->assertSame('development', ErrorsHandler::currentEnv());
+    }
+
+    public function test_current_env_defaults_to_production_when_missing(): void
+    {
+        unset($_ENV['APP_ENV']);
+        $this->assertSame('production', ErrorsHandler::currentEnv());
+
+        $_ENV['APP_ENV'] = '';
+        $this->assertSame('production', ErrorsHandler::currentEnv());
+    }
+
+    public function test_friendly_404_page_has_no_technical_details(): void
+    {
+        $html = ErrorsHandler::friendlyPage('errors/404');
+
+        $this->assertStringContainsString('Página não encontrada', $html);
+        $this->assertStringContainsString('<a href="/"', $html);
+        $this->assertStringContainsString('Voltar ao início', $html);
+        $this->assertStringNotContainsString('Stack Trace', $html);
+        $this->assertStringNotContainsString('.php', $html);
+    }
+
+    public function test_friendly_500_page_has_no_technical_details(): void
+    {
+        $html = ErrorsHandler::friendlyPage('errors/500');
+
+        $this->assertStringContainsString('Erro interno', $html);
+        $this->assertStringContainsString('<a href="/"', $html);
+        $this->assertStringNotContainsString('Stack Trace', $html);
+        $this->assertStringNotContainsString('.php', $html);
+    }
+}
