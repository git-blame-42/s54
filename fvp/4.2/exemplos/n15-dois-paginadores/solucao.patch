+    /**
+     * Eventos de hoje em diante (tabela "Próximos" da listagem), paginados, do mais próximo ao mais distante.
+     *
+     * @param array<string, mixed> $routeParams parâmetros fixos dos links de página
+     */
+    public static function paginateUpcoming(
+        int $page = 1,
+        int $per_page = 10,
+        ?string $route = null,
+        string $pageParam = 'page',
+        array $routeParams = []
+    ): Paginator {
+        return self::paginateByStartsOn('>=', 'starts_on, id', $page, $per_page, $route, $pageParam, $routeParams);
+    }
+
+    /**
+     * Eventos anteriores a hoje (tabela "Passados" da listagem), paginados, do mais recente ao mais antigo.
+     *
+     * @param array<string, mixed> $routeParams parâmetros fixos dos links de página
+     */
+    public static function paginatePast(
+        int $page = 1,
+        int $per_page = 10,
+        ?string $route = null,
+        string $pageParam = 'page',
+        array $routeParams = []
+    ): Paginator {
+        return self::paginateByStartsOn('<', 'starts_on DESC, id DESC', $page, $per_page, $route, $pageParam, $routeParams);
+    }
+
+    /**
+     * "Hoje" vem do PHP (date), o mesmo relógio da validação "não pode estar no passado!".
+     * ORDER BY explícito: com o WHERE por starts_on o MySQL pode ler pelo índice da coluna,
+     * e a ordem "do banco" deixa de ser a do id.
+     *
+     * @param array<string, mixed> $routeParams
+     */
+    private static function paginateByStartsOn(
+        string $operator,
+        string $orderBy,
+        int $page,
+        int $per_page,
+        ?string $route,
+        string $pageParam,
+        array $routeParams
+    ): Paginator {
+        return new Paginator(
+            class: static::class,
+            page: $page,
+            per_page: $per_page,
+            table: static::table(),
+            attributes: static::columns(),
+            route: $route,
+            routeParams: $routeParams,
+            pageParam: $pageParam,
+            comparisons: ['starts_on' => [$operator, date('Y-m-d')]],
+            orderBy: $orderBy
+        );
+    }
+
     /**
      * Remove o Evento sem lançar exceção (P03): se houver Inscrições, não remove,
      * retorna false e registra o motivo em errors('base').
