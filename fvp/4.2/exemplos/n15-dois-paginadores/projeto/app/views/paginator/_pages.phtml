<?php
// Link de cada página: parâmetro de página deste paginador + parâmetros fixos (ex.: a página da outra tabela).
// htmlspecialchars: com mais de um parâmetro na query string, o href leva '&' (vira '&amp;').
$pageUrl = fn (int $page): string => htmlspecialchars(route($paginator->getRouteName(), $paginator->routeParams($page)));
?>
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-end">

        <?php if ($paginator->hasPreviousPage()) : ?>
            <li class="page-item">
                <a class="page-link" href="<?= $pageUrl($paginator->previousPage()) ?>">Anterior</a>
            </li>
        <?php else : ?>
            <li class="page-item disabled">
                <a class="page-link">Anterior</a>
            </li>
        <?php endif; ?>

        <?php for ($page = 1; $page <= $paginator->totalOfPages(); $page++) : ?>
            <li class="page-item <?= $paginator->isPage($page) ? 'active' : '' ?>">
                <a class="page-link" href="<?= $pageUrl($page) ?>"><?= $page ?></a>
            </li>
        <?php endfor; ?>

        <?php if ($paginator->hasNextPage()) : ?>
            <li class="page-item">
                <a class="page-link" href="<?= $pageUrl($paginator->nextPage()) ?>">Próxima</a>
            </li>
        <?php else : ?>
            <li class="page-item disabled">
                <a class="page-link">Próxima</a>
            </li>
        <?php endif; ?>
    </ul>
</nav>

<div class="d-flex justify-content-end"><?= $paginator->entriesInfo() ?></div>