diff --git a/lib/Validations.php b/lib/Validations.php
index f456148..0244592 100644
--- a/lib/Validations.php
+++ b/lib/Validations.php
@@ -72,6 +72,27 @@ class Validations
         return true;
     }
 
+    /**
+     * O valor do atributo deve ser o id de um registro de $modelClass (ex.: user_id -> User).
+     * $conditions acrescenta filtros de igualdade à busca (ex.: ['role' => 'admin']).
+     * A consulta é a do próprio model (Model::exists), sem SQL aqui.
+     *
+     * @param class-string<\Core\Database\ActiveRecord\Model> $modelClass
+     * @param array<string, mixed> $conditions
+     */
+    public static function exists(string $attribute, string $modelClass, $obj, array $conditions = [])
+    {
+        $value = $obj->$attribute;
+        $id = is_int($value) || is_string($value) ? filter_var($value, FILTER_VALIDATE_INT) : false;
+
+        if ($id === false || !$modelClass::exists(['id' => $id] + $conditions)) {
+            $obj->addError($attribute, 'não existe!');
+            return false;
+        }
+
+        return true;
+    }
+
     /**
      * O valor deve ser um número inteiro maior ou igual a $min (aceita string numérica, como vem de um form).
      */
