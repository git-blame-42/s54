diff --git a/tests/Unit/Lib/Validations/ExistsValidationsTest.php b/tests/Unit/Lib/Validations/ExistsValidationsTest.php
new file mode 100644
index 0000000..e5c26b1
--- /dev/null
+++ b/tests/Unit/Lib/Validations/ExistsValidationsTest.php
@@ -0,0 +1,87 @@
+<?php
+
+namespace Tests\Unit\Lib\Validations;
+
+use App\Models\User;
+use Core\Database\ActiveRecord\Model;
+use Lib\Validations;
+use Tests\TestCase;
+
+/**
+ * Validations::exists: o atributo deve ser o id de um registro do model informado (aqui, User).
+ */
+class ExistsValidationsTest extends TestCase
+{
+    private Model $model;
+    private User $admin;
+    private User $participant;
+
+    public function setUp(): void
+    {
+        parent::setUp();
+
+        $this->model = new class () extends Model {
+            protected static array $columns = ['user_id'];
+        };
+
+        $this->admin = $this->createUser('admin@example.com', 'admin');
+        $this->participant = $this->createUser('participante@example.com', 'participant');
+    }
+
+    private function createUser(string $email, string $role): User
+    {
+        $user = new User([
+            'name' => 'Usuário',
+            'email' => $email,
+            'password' => '123456',
+            'password_confirmation' => '123456',
+            'role' => $role,
+        ]);
+        $user->save();
+
+        return $user;
+    }
+
+    public function test_exists_should_accept_an_existing_id(): void
+    {
+        $this->model->user_id = $this->admin->id; // @phpstan-ignore-line
+
+        $this->assertTrue(Validations::exists('user_id', User::class, $this->model));
+        $this->assertNull($this->model->errors('user_id'));
+    }
+
+    public function test_exists_should_accept_a_numeric_string_id(): void
+    {
+        $this->model->user_id = (string) $this->admin->id; // @phpstan-ignore-line
+
+        $this->assertTrue(Validations::exists('user_id', User::class, $this->model));
+    }
+
+    public function test_exists_should_reject_an_unknown_id(): void
+    {
+        $this->model->user_id = 9999; // @phpstan-ignore-line
+
+        $this->assertFalse(Validations::exists('user_id', User::class, $this->model));
+        $this->assertEquals('não existe!', $this->model->errors('user_id'));
+    }
+
+    public function test_exists_should_reject_null_text_and_array_values(): void
+    {
+        $this->assertFalse(Validations::exists('user_id', User::class, $this->model));
+
+        $this->model->user_id = 'abc'; // @phpstan-ignore-line
+        $this->assertFalse(Validations::exists('user_id', User::class, $this->model));
+
+        $this->model->user_id = [$this->admin->id]; // @phpstan-ignore-line
+        $this->assertFalse(Validations::exists('user_id', User::class, $this->model));
+    }
+
+    public function test_exists_should_apply_extra_conditions(): void
+    {
+        $this->model->user_id = $this->participant->id; // @phpstan-ignore-line
+        $this->assertFalse(Validations::exists('user_id', User::class, $this->model, ['role' => 'admin']));
+
+        $this->model->user_id = $this->admin->id; // @phpstan-ignore-line
+        $this->assertTrue(Validations::exists('user_id', User::class, $this->model, ['role' => 'admin']));
+    }
+}
diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..84cf634 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -95,6 +95,52 @@ class EventTest extends TestCase
         }
     }
 
+    public function test_user_id_should_be_required(): void
+    {
+        $event = new Event($this->params(['user_id' => null]));
+
+        $this->assertFalse($event->isValid());
+        $this->assertEquals('não pode ser vazio!', $event->errors('user_id'));
+    }
+
+    public function test_unknown_user_id_should_be_invalid_instead_of_a_foreign_key_error(): void
+    {
+        $event = new Event($this->params(['user_id' => 9999]));
+
+        $this->assertFalse($event->isValid());
+        $this->assertFalse($event->save());
+        $this->assertEquals('não existe!', $event->errors('user_id'));
+        $this->assertCount(0, Event::all());
+    }
+
+    public function test_participant_as_creator_should_be_invalid(): void
+    {
+        $participant = $this->createUser('Participante', 'participante@example.com');
+        $event = new Event($this->params(['user_id' => $participant->id]));
+
+        $this->assertFalse($event->save());
+        $this->assertEquals('deve ser um administrador!', $event->errors('user_id'));
+        $this->assertCount(0, Event::all());
+    }
+
+    public function test_user_id_with_trailing_text_should_be_invalid(): void
+    {
+        foreach (["{$this->admin->id}abc", '1.5', 'abc'] as $value) {
+            $event = new Event($this->params(['user_id' => $value]));
+
+            $this->assertFalse($event->isValid(), $value);
+            $this->assertEquals('não existe!', $event->errors('user_id'), $value);
+        }
+    }
+
+    public function test_admin_as_creator_should_be_valid(): void
+    {
+        $event = new Event($this->params(['user_id' => (string) $this->admin->id]));
+
+        $this->assertTrue($event->isValid());
+        $this->assertNull($event->errors('user_id'));
+    }
+
     /**
      * @return array<string, array{string}>
      */
