@@ -17,6 +17,13 @@ class EventsController extends Controller
     {
         [$filters, $errors] = Event::listingFilters($request->getParams());
 
+        // Quem pede JSON é um programa: parâmetro inválido responde 422 com os erros, antes de consultar.
+        if ($errors !== [] && $request->acceptJson()) {
+            http_response_code(422);
+            $this->renderJson('admin/events/index', compact('errors'));
+            return;
+        }
+
         $paginator = Event::listingPage(
             $filters,
             page: $this->pageParam($request),
@@ -27,7 +34,7 @@ class EventsController extends Controller
 
