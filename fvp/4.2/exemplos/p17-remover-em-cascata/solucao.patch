+    public function removedEnrollments(): int
+    {
+        return $this->removedEnrollments;
+    }
+
+    /**
+     * Apaga as Inscrições e depois o Evento na MESMA conexão, dentro de uma transação:
+     * ou some tudo, ou nada. (Database::getDatabaseConn() abre uma conexão nova a cada
+     * chamada, por isso não dá para usar Enrollment::destroy() + $this->destroy() aqui.)
+     */
+    private function destroyWithEnrollments(): bool
+    {
+        $pdo = Database::getDatabaseConn();
+
+        try {
+            $pdo->beginTransaction();
+
+            $stmt = $pdo->prepare('DELETE FROM event_user WHERE event_id = :event_id;');
+            $stmt->bindValue(':event_id', $this->id);
+            $stmt->execute();
+            $removed = $stmt->rowCount();
+
+            $stmt = $pdo->prepare('DELETE FROM events WHERE id = :id;');
+            $stmt->bindValue(':id', $this->id);
+            $stmt->execute();
+
+            if ($stmt->rowCount() !== 1) {
+                $pdo->rollBack();
+                $this->addError('base', 'não foi possível remover o evento!');
+                return false;
+            }
+
+            $pdo->commit();
+            $this->removedEnrollments = $removed;
+
+            return true;
+        } catch (PDOException $e) {
+            if ($pdo->inTransaction()) {
+                $pdo->rollBack();
+            }
+            $this->addError('base', 'não foi possível remover o evento e suas inscrições!');
+            return false;
+        }
+    }
