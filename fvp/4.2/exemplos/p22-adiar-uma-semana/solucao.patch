+    /* ------------------- adiar ------------------- */
+
+    public function test_postpone_should_add_seven_days_to_starts_on(): void
+    {
+        $event = $this->createEvent(['starts_on' => date('Y-m-d', strtotime('+30 days'))]);
+        $expected = date('Y-m-d', strtotime('+37 days'));
+
+        $this->assertTrue($event->postpone());
+        $this->assertSame($expected, $event->starts_on);
+        $this->assertEquals($expected, Event::findById($event->id)->starts_on);
+    }
+
+    public function test_postpone_should_accept_other_amounts_of_days(): void
+    {
+        $event = $this->createEvent(['starts_on' => '2099-12-30']);
+
+        $this->assertTrue($event->postpone(3));
+        $this->assertEquals('2100-01-02', Event::findById($event->id)->starts_on);
+    }
+
+    public function test_postpone_should_keep_capacity_and_enrollments(): void
+    {
+        $event = $this->createEvent(['capacity' => 5]);
+        $this->enroll($event, 2);
+
+        $this->assertTrue($event->postpone());
+
+        $found = Event::findById($event->id);
+        $this->assertEquals(5, $found->capacity);
+        $this->assertSame(2, $found->enrollmentsCount());
+        $this->assertCount(1, Event::all());
+    }
+
+    public function test_postpone_should_reject_a_still_past_date(): void
+    {
+        $event = $this->createPastEvent();
+        $original = $event->starts_on;
+
+        $this->assertFalse($event->postpone());
+        $this->assertEquals('não pode estar no passado!', $event->errors('starts_on'));
+        $this->assertEquals($original, $event->starts_on, 'o objeto volta para a data original');
+        $this->assertEquals($original, Event::findById($event->id)->starts_on);
