@@ -4,6 +4,7 @@ namespace App\Models;
 
 use Core\Database\ActiveRecord\BelongsTo;
 use Core\Database\ActiveRecord\Model;
+use DateTimeImmutable;
 use Lib\Validations;
 use PDOException;
 
@@ -44,6 +45,9 @@ class Event extends Model
         'community' => 'Comunidade externa',
     ];
 
+    /** Dias que o botão "Adiar uma semana" soma à data do Evento. */
+    public const POSTPONE_DAYS = 7;
+
     protected static string $table = 'events';
     protected static array $columns = [
         'user_id',
@@ -114,6 +118,43 @@ class Event extends Model
         }
     }
 
+    /**
+     * Adia o Evento $days dias a partir da data atual dele (não de hoje) e grava com save():
+     * a data nova passa pelas validações de sempre (não pode ficar no passado). A capacidade não muda.
+     * Se não gravar, o objeto volta para a data original e o motivo fica em errors().
+     */
+    public function postpone(int $days = self::POSTPONE_DAYS): bool
+    {
+        $this->errors = [];
+
+        if ($this->newRecord()) {
+            // save() faria INSERT: adiar criaria um Evento novo.
+            $this->addError('base', 'o evento não existe!');
+            return false;
+        }
+
+        if ($days < 1) {
+            $this->addError('base', 'adie pelo menos 1 dia!');
+            return false;
+        }
+
+        $original = $this->starts_on;
+        $date = DateTimeImmutable::createFromFormat('!Y-m-d', $original);
+        if ($date === false) {
+            $this->addError('starts_on', 'não é uma data válida!');
+            return false;
+        }
+
+        $this->starts_on = $date->modify("+{$days} days")->format('Y-m-d');
+        if ($this->save()) {
+            return true;
+        }
+
+        $this->starts_on = $original;
+
+        return false;
+    }
+
     public function user(): BelongsTo
     {
         return $this->belongsTo(User::class, 'user_id');
