+
+    public function test_postpone_moves_event_one_week_and_redirects_to_show(): void
+    {
+        $event = $this->createEvent(['starts_on' => date('Y-m-d', strtotime('+10 days'))]);
+
+        $response = $this->put(action: 'postpone', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertSame("Location: /admin/events/{$event->id}", $response);
+        $this->assertEquals(date('Y-m-d', strtotime('+17 days')), Event::findById($event->id)->starts_on);
+        $this->assertEquals(
+            'Evento adiado para ' . date('d/m/Y', strtotime('+17 days')) . '!',
+            $_SESSION['flash']['success']
+        );
+    }
+
+    public function test_postpone_with_unknown_id_redirects_to_index(): void
+    {
+        $response = $this->put(action: 'postpone', controllerName: self::CONTROLLER, params: ['id' => 9999]);
+
+        $this->assertSame('Location: /admin/events', $response);
+        $this->assertEquals('Evento não encontrado!', $_SESSION['flash']['danger']);
+        $this->assertCount(0, Event::all());
+    }
+
+    public function test_postpone_keeps_date_when_it_would_still_be_in_the_past(): void
+    {
+        $event = $this->createEvent();
+        $past = date('Y-m-d', strtotime('-10 days'));
+        $this->assertTrue($event->update(['starts_on' => $past]));
+
+        $response = $this->put(action: 'postpone', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertSame("Location: /admin/events/{$event->id}", $response);
+        $this->assertEquals($past, Event::findById($event->id)->starts_on);
+        $this->assertEquals('Não foi possível adiar: não pode estar no passado!', $_SESSION['flash']['danger']);
+    }
+
+    public function test_show_has_postpone_button_as_put_form(): void
+    {
+        $event = $this->createEvent();
+
+        $show = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertMatchesRegularExpression(
+            '/<form[^>]*action="\/admin\/events\/' . $event->id . '\/postpone" method="post">\s*'
+                . '<input type="hidden" name="_method" value="PUT">\s*'
