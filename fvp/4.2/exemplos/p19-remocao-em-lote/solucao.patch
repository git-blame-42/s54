+    /* ------------------- P19: remoção em lote ------------------- */
+
+    public function test_index_shows_bulk_destroy_form_and_checkboxes(): void
+    {
+        $event = $this->createEvent();
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString('id="bulk_destroy_form"', $response);
