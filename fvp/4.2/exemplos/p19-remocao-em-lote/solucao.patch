+
+    public function test_destroy_many_removes_the_selected_events(): void
+    {
+        $first = $this->createEvent(['title' => 'Primeiro']);
+        $second = $this->createEvent(['title' => 'Segundo']);
+        $kept = $this->createEvent(['title' => 'Fica']);
+
+        $response = $this->delete(
+            action: 'destroyMany',
+            controllerName: self::CONTROLLER,
+            params: ['ids' => [(string) $first->id, (string) $second->id]]
+        );
+
+        $this->assertSame('Location: /admin/events', $response);
+        $this->assertEquals('2 evento(s) removido(s) com sucesso!', $_SESSION['flash']['success']);
+        $this->assertArrayNotHasKey('danger', $_SESSION['flash']);
+        $this->assertCount(1, Event::all());
+        $this->assertNotNull(Event::findById($kept->id));
+    }
+
+    public function test_destroy_many_keeps_events_with_enrollments_with_one_flash_per_type(): void
+    {
+        $free = $this->createEvent(['title' => 'Livre']);
+        $busy = $this->createEvent(['title' => 'Ocupado']);
+        $this->enroll($busy);
+
+        $this->delete(
+            action: 'destroyMany',
+            controllerName: self::CONTROLLER,
+            params: ['ids' => [(string) $free->id, (string) $busy->id, '9999']]
+        );
+
+        $this->assertNull(Event::findById($free->id));
+        $this->assertNotNull(Event::findById($busy->id));
+        $this->assertEquals('1 evento(s) removido(s) com sucesso!', $_SESSION['flash']['success']);
+        $this->assertEquals(
+            'Não é possível remover eventos com inscrições: Ocupado; 1 evento(s) não encontrado(s)!',
+            $_SESSION['flash']['danger']
+        );
+    }
