+    /**
+     * DELETE /admin/events: remove os Eventos marcados (ids[]). Cada um passa pela regra do safeDestroy();
+     * um flash por tipo (success e danger), porque o FlashMessage guarda uma mensagem por tipo.
+     */
+    public function destroyMany(Request $request): void
+    {
+        $ids = $this->selectedIds($request->getParam('ids'));
+
+        if ($ids === null) {
+            FlashMessage::danger('Selecione ao menos um evento válido para remover!');
+            $this->redirectTo(route('admin.events.index'));
+            return;
+        }
+
+        $result = Event::destroyMany($ids);
+
+        if ($result['removed'] !== []) {
+            FlashMessage::success(count($result['removed']) . ' evento(s) removido(s) com sucesso!');
+        }
+
+        $problems = [];
+        if ($result['blocked'] !== []) {
+            $problems[] = 'não é possível remover eventos com inscrições: ' . implode(', ', $result['blocked']);
+        }
+        if ($result['missing'] !== []) {
+            $problems[] = count($result['missing']) . ' evento(s) não encontrado(s)';
+        }
+        if ($problems !== []) {
+            FlashMessage::danger(ucfirst(implode('; ', $problems)) . '!');
+        }
+
+        $this->redirectTo(route('admin.events.index'));
+    }
+
+    /**
+     * ids[] do formulário: precisa ser um array não vazio só com inteiros positivos em texto ("12").
+     * Qualquer item inválido invalida a seleção inteira (nada é removido).
+     *
+     * @return array<int, int>|null
+     */
+    private function selectedIds(mixed $ids): ?array
+    {
+        if (!is_array($ids) || $ids === []) {
+            return null;
+        }
+
+        foreach ($ids as $id) {
+            if (!is_string($id) || !ctype_digit($id) || (int) $id === 0) {
+                return null;
+            }
+        }
+
+        return array_values(array_map('intval', $ids));
+    }
+
     private function findEvent(Request $request): ?Event
     {
         return Event::findById((int) $request->getParam('id'));
diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..895c358 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -172,6 +172,32 @@ class Event extends Model
         }
     }
 
+    /**
+     * Remoção em lote: aplica a mesma regra do safeDestroy() (P03) a cada id.
+     * Devolve os títulos removidos, os barrados (com o motivo) e os ids que não existem.
+     *
+     * @param array<int, int> $ids
+     * @return array{removed: array<int, string>, blocked: array<int, string>, missing: array<int, int>}
+     */
+    public static function destroyMany(array $ids): array
+    {
+        $result = ['removed' => [], 'blocked' => [], 'missing' => []];
+
+        foreach (array_unique($ids) as $id) {
+            $event = self::findById($id);
+
+            if ($event === null) {
+                $result['missing'][] = $id;
+            } elseif ($event->safeDestroy()) {
+                $result['removed'][] = $event->title;
+            } else {
+                $result['blocked'][] = $event->title;
+            }
+        }
+
+        return $result;
+    }
+
