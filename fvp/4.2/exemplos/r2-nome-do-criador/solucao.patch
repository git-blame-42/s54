                     <td><?= date('d/m/Y', strtotime($event->starts_on)) ?></td>
                     <td><?= htmlspecialchars($event->location) ?></td>
                     <td><?= $event->enrollmentsCount() ?>/<?= (int) $event->capacity ?></td>
+                    <td><?= htmlspecialchars($event->creatorName()) ?></td>
                     <td>
                         <a class="btn btn-sm btn-outline-secondary" href="<?= route('admin.events.show', ['id' => $event->id]) ?>">Ver</a>
                         <a class="btn btn-sm btn-outline-primary" href="<?= route('admin.events.edit', ['id' => $event->id]) ?>">Editar</a>
diff --git a/app/views/admin/events/show.phtml b/app/views/admin/events/show.phtml
index 6cab74e..a13ad9b 100644
--- a/app/views/admin/events/show.phtml
+++ b/app/views/admin/events/show.phtml
@@ -30,6 +30,9 @@ $audience = array_map(fn(string $value) => Event::AUDIENCES[$value] ?? $value, $
         <?= $event->enrollmentsCount() ?>/<?= (int) $event->capacity ?>
         (<?= $event->availableSpots() ?> disponíveis)
     </dd>
+
+    <dt class="col-sm-3">Criado por</dt>
