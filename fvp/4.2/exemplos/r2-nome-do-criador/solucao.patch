From a7c3aa56649b9f3347f6c45af3c3af6617fe3c0a Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:10:40 -0300
Subject: [PATCH] feat: Show event creator name in listing and show

Event::creatorName() reads the name through the user() BelongsTo
relation; the listing gets a "Criado por" column and the show page a
"Criado por" item.
---
 app/Models/Event.php                          | 11 +++++
 app/views/admin/events/index.phtml            |  2 +
 app/views/admin/events/show.phtml             |  3 ++
 .../admin/events/ListEventsCest.php           |  4 ++
 .../Admin/EventsControllerTest.php            | 47 +++++++++++++++++++
 tests/Unit/Models/Events/EventTest.php        | 10 ++++
 6 files changed, 77 insertions(+)

diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..e411f29 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -119,6 +119,17 @@ class Event extends Model
         return $this->belongsTo(User::class, 'user_id');
     }
 
+    /**
+     * Nome de quem cadastrou o Evento (relação BelongsTo com users).
+     * A FK fk_events_user garante que o usuário existe.
+     */
+    public function creatorName(): string
+    {
+        $creator = $this->user()->get();
+
+        return $creator instanceof User ? $creator->name : '';
+    }
+
     /**
      * Total de Inscrições (linhas em event_user) deste Evento.
      */
