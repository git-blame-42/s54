+    /**
+     * Listagem paginada só com os Eventos cujo `starts_on` está no período [from, to] (as duas pontas
+     * entram). `null` numa ponta deixa o período aberto daquele lado. `from` e `to` vão para os links
+     * de página (`queryParams`), para a página 2 manter o filtro.
+     */
+    public static function paginateBetween(
+        ?string $from,
+        ?string $to,
+        int $page = 1,
+        int $per_page = 10,
+        ?string $route = null
+    ): Paginator {
+        return new Paginator(
+            class: static::class,
+            page: $page,
+            per_page: $per_page,
+            table: static::$table,
+            attributes: static::$columns,
+            route: $route,
+            queryParams: array_filter(['from' => $from, 'to' => $to], fn(?string $value) => $value !== null),
+            ranges: ['starts_on' => [$from ?? self::MIN_DATE, $to ?? self::MAX_DATE]]
+        );
+    }
+
     public function user(): BelongsTo
     {
         return $this->belongsTo(User::class, 'user_id');
