<div class="mb-3">
    <a class="btn btn-primary" href="<?= route('admin.events.new') ?>">Novo Evento</a>
</div>

<?php $filtered = $error === null && ($from !== '' || $to !== ''); ?>
<form class="row g-2 align-items-end mb-3" method="get" action="<?= route('admin.events.index') ?>" novalidate>
    <div class="col-auto">
        <label class="form-label" for="filter_from">De</label>
        <input type="date" class="form-control <?= $error !== null ? 'is-invalid' : '' ?>" id="filter_from" name="from"
            value="<?= htmlspecialchars($from) ?>">
    </div>
    <div class="col-auto">
        <label class="form-label" for="filter_to">Até</label>
        <input type="date" class="form-control <?= $error !== null ? 'is-invalid' : '' ?>" id="filter_to" name="to"
            value="<?= htmlspecialchars($to) ?>">
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <a class="btn btn-outline-secondary" href="<?= route('admin.events.index') ?>">Limpar</a>
    </div>
</form>

<?php if (empty($events)) : ?>
    <p><?= $filtered ? 'Nenhum evento no período.' : 'Nenhum evento cadastrado.' ?></p>
<?php else : ?>
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Tipo</th>
                <th>Data</th>
                <th>Local</th>
                <th>Vagas</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($events as $event) : ?>
                <tr>
                    <td><?= htmlspecialchars($event->title) ?></td>
                    <td><?= \App\Models\Event::KINDS[$event->kind] ?? htmlspecialchars($event->kind) ?></td>
                    <td><?= date('d/m/Y', strtotime($event->starts_on)) ?></td>
                    <td><?= htmlspecialchars($event->location) ?></td>
                    <td><?= $event->enrollmentsCount() ?>/<?= (int) $event->capacity ?></td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" href="<?= route('admin.events.show', ['id' => $event->id]) ?>">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" href="<?= route('admin.events.edit', ['id' => $event->id]) ?>">Editar</a>
                        <form class="d-inline" action="<?= route('admin.events.destroy', ['id' => $event->id]) ?>" method="post">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                        </form>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>

    <?php $paginator->renderPagesNavigation(); ?>
