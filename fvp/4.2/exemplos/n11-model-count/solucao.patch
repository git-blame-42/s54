diff --git a/core/Database/ActiveRecord/HasMany.php b/core/Database/ActiveRecord/HasMany.php
index 6f94760..6fe0bec 100644
--- a/core/Database/ActiveRecord/HasMany.php
+++ b/core/Database/ActiveRecord/HasMany.php
@@ -21,6 +21,14 @@ class HasMany
         return $this->related::where([$this->foreignKey => $this->model->id]);
     }
 
+    /**
+     * Total de registros relacionados, com SELECT COUNT(*) (não carrega os objetos como get()).
+     */
+    public function count(): int
+    {
+        return $this->related::count([$this->foreignKey => $this->model->id]);
+    }
