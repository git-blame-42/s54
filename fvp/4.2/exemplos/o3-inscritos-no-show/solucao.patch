@@ -32,5 +32,28 @@ $audience = array_map(fn(string $value) => Event::AUDIENCES[$value] ?? $value, $
     </dd>
 </dl>
 
+<?php $participants = $event->participants()->get(); ?>
+<h2 class="h5">Inscritos</h2>
+<?php if (empty($participants)) : ?>
+    <p>Nenhuma inscrição.</p>
+<?php else : ?>
+    <table class="table table-sm">
+        <thead>
+            <tr>
+                <th>Nome</th>
+                <th>E-mail</th>
+            </tr>
+        </thead>
+        <tbody>
+            <?php foreach ($participants as $participant) : ?>
+                <tr>
+                    <td><?= htmlspecialchars($participant->name) ?></td>
+                    <td><?= htmlspecialchars($participant->email) ?></td>
+                </tr>
+            <?php endforeach; ?>
+        </tbody>
+    </table>
+<?php endif; ?>
+
 <a class="btn btn-primary" href="<?= route('admin.events.edit', ['id' => $event->id]) ?>">Editar</a>
 <a class="btn btn-secondary" href="<?= route('admin.events.index') ?>">Voltar</a>
diff --git a/tests/Acceptance/admin/events/ShowParticipantsCest.php b/tests/Acceptance/admin/events/ShowParticipantsCest.php
new file mode 100644
index 0000000..d4d52bf
--- /dev/null
+++ b/tests/Acceptance/admin/events/ShowParticipantsCest.php
@@ -0,0 +1,36 @@
+<?php
+
+namespace Tests\Acceptance\admin\events;
+
+use Tests\Support\AcceptanceTester;
+
+class ShowParticipantsCest extends BaseEventsCest
+{
+    public function showListsParticipants(AcceptanceTester $page): void
+    {
+        $event = $this->events[1];
+
+        $page->wantTo('Visualização do registro (inscritos com nome e e-mail)');
+        $page->amOnPage('/admin/events');
+        $page->click('Ver', $this->rowOf('Evento 01'));
+
+        $page->seeCurrentUrlEquals("/admin/events/{$event->id}");
+        $page->see('Inscritos', 'h2');
+        // Evento 01 da base: os 3 Participantes inscritos.
+        for ($i = 1; $i <= 3; $i++) {
+            $page->see("Participante {$i}", 'table');
+            $page->see("participante{$i}@example.com", 'table');
+        }
+    }
+
+    public function showWithoutEnrollments(AcceptanceTester $page): void
+    {
+        $event = $this->events[2];
+
+        $page->wantTo('Visualização do registro (Evento sem inscritos)');
+        $page->amOnPage("/admin/events/{$event->id}");
+
+        $page->see('Inscritos', 'h2');
+        $page->see('Nenhuma inscrição.');
+    }
+}
