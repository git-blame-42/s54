diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..daa27a2 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -490,6 +490,31 @@ class EventTest extends TestCase
         $this->assertEquals(3, $event->availableSpots());
     }
 
+    public function test_participants_should_return_the_enrolled_users(): void
+    {
+        $event = $this->createEvent();
+        $other = $this->createEvent(['title' => 'Outro evento']);
+        $this->enroll($event, 2);
+        $this->enroll($other, 1);
+
+        $participants = $event->participants()->get();
+
+        $this->assertCount(2, $participants);
+        $emails = [];
+        foreach ($participants as $participant) {
+            $this->assertInstanceOf(User::class, $participant);
+            $emails[] = $participant->email;
+        }
+        sort($emails);
+        $this->assertSame(["p{$event->id}-1@example.com", "p{$event->id}-2@example.com"], $emails);
+        $this->assertSame(2, $event->participants()->count());
+    }
+
+    public function test_participants_should_be_empty_without_enrollments(): void
+    {
+        $this->assertSame([], $this->createEvent()->participants()->get());
+    }
