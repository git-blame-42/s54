From ea5ab92037d3d6da9fd9f15898eb69e1b1fbb8c5 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:41:36 -0300
Subject: [PATCH 1/2] feat: Add beforeValidation hook to Model::isValid

isValid() now calls the protected beforeValidation() hook right before
validates(), so subclasses can normalize attributes first. The default
hook is empty. update() does not go through isValid(), so the hook only
runs on save().
---
 core/Database/ActiveRecord/Model.php          |  9 +++
 .../ActiveRecord/BeforeValidationTest.php     | 64 +++++++++++++++++++
 .../Core/Database/ActiveRecord/PlainModel.php | 22 +++++++
 .../Database/ActiveRecord/TrimmingModel.php   | 36 +++++++++++
 4 files changed, 131 insertions(+)
 create mode 100644 tests/Unit/Core/Database/ActiveRecord/BeforeValidationTest.php
 create mode 100644 tests/Unit/Core/Database/ActiveRecord/PlainModel.php
 create mode 100644 tests/Unit/Core/Database/ActiveRecord/TrimmingModel.php

diff --git a/core/Database/ActiveRecord/Model.php b/core/Database/ActiveRecord/Model.php
index c6a7dab..f161f29 100644
--- a/core/Database/ActiveRecord/Model.php
+++ b/core/Database/ActiveRecord/Model.php
@@ -104,11 +104,20 @@ abstract class Model
     {
         $this->errors = [];
 
+        $this->beforeValidation();
         $this->validates();
 
         return empty($this->errors);
     }
 
+    /**
+     * Gancho: a subclasse normaliza atributos (ex.: trim) antes das validações.
+     * Roda só via isValid(), ou seja, em save(); update() não passa por aqui.
+     */
+    protected function beforeValidation(): void
+    {
+    }
+
     public function newRecord(): bool
     {
         return $this->id === null;
diff --git a/tests/Unit/Core/Database/ActiveRecord/BeforeValidationTest.php b/tests/Unit/Core/Database/ActiveRecord/BeforeValidationTest.php
new file mode 100644
