From b1087e573b791a31cc88799a173a4cf9b4efbfb9 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:41:36 -0300
Subject: [PATCH 2/2] feat: Trim Event title, description and location before
 validation

A title made only of spaces used to pass notEmpty. Event overrides the
new hook and trims the free text fields when they are strings.
---
 app/Models/Event.php                          | 14 ++++
 .../admin/events/CreateSuccessfullyCest.php   | 24 ++++++
 .../events/CreateWithInvalidDataCest.php      | 25 ++++++
 tests/Unit/Models/Events/EventTest.php        | 82 +++++++++++++++++++
 4 files changed, 145 insertions(+)

diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..bfa84a0 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -57,6 +57,20 @@ class Event extends Model
         'capacity',
     ];
 
+    /**
+     * Tira os espaços das pontas dos campos de texto livre (title, description, location): sem
+     * isso, um título só com espaços passaria no notEmpty. Valores que não são string (ex.: null)
+     * ficam como estão. Os demais campos são ENUM/SET/data/número e já são validados por valor.
+     */
+    protected function beforeValidation(): void
+    {
+        foreach (['title', 'description', 'location'] as $field) {
+            if (is_string($this->$field)) {
+                $this->$field = trim($this->$field);
+            }
+        }
+    }
+
     public function validates(): void
     {
         Validations::notEmpty('title', $this);
