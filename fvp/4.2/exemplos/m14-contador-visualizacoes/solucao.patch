 app/Models/Event.php                          | 33 +++++++++++
 app/views/admin/events/index.phtml            |  2 +
 app/views/admin/events/show.phtml             |  3 +
 database/Populate/populate.php                |  1 +
 database/schema.sql                           |  2 +
 .../admin/events/ViewsCountCest.php           | 32 +++++++++++
 .../Admin/EventsControllerTest.php            | 38 +++++++++++++
 tests/Unit/Models/Events/EventTest.php        | 56 +++++++++++++++++++
 9 files changed, 169 insertions(+)
 create mode 100644 tests/Acceptance/admin/events/ViewsCountCest.php

