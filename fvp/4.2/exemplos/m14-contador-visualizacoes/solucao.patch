@@ -0,0 +1,32 @@
+<?php
+
+namespace Tests\Acceptance\admin\events;
+
+use App\Models\Event;
+use PHPUnit\Framework\Assert;
+use Tests\Support\AcceptanceTester;
+
+/**
+ * Cada abertura do show do Evento soma uma visualização, exibida no show e na listagem.
+ */
+class ViewsCountCest extends BaseEventsCest
+{
+    public function showCountsViews(AcceptanceTester $page): void
+    {
+        $event = $this->events[2];
+
+        $page->wantTo('Abrir o detalhe do Evento duas vezes e ver o contador subir');
+        $page->amOnPage('/admin/events');
+        $page->see('0', $this->rowOf('Evento 02') . "//td[@class='views-count']");
+
+        $page->click('Ver', $this->rowOf('Evento 02'));
+        $page->see('1', '#event_views_count');
+
+        $page->amOnPage("/admin/events/{$event->id}");
+        $page->see('2', '#event_views_count');
+
+        $page->amOnPage('/admin/events');
+        $page->see('2', $this->rowOf('Evento 02') . "//td[@class='views-count']");
+        Assert::assertEquals(2, Event::findById((int) $event->id)?->views_count);
+    }
+}
diff --git a/tests/Integration/Controllers/Admin/EventsControllerTest.php b/tests/Integration/Controllers/Admin/EventsControllerTest.php
index bc62d1d..b23db88 100644
--- a/tests/Integration/Controllers/Admin/EventsControllerTest.php
+++ b/tests/Integration/Controllers/Admin/EventsControllerTest.php
@@ -265,6 +265,44 @@ class EventsControllerTest extends ControllerTestCase
         );
     }
 
+    public function test_show_increments_views_count_once_per_access(): void
+    {
+        $event = $this->createEvent();
+
+        $first = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+        $this->assertEquals(1, Event::findById($event->id)->views_count);
+        $this->assertMatchesRegularExpression('/id="event_views_count">1</', $first);
+
+        $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+        $this->assertEquals(2, Event::findById($event->id)->views_count);
+    }
+
+    public function test_index_and_edit_do_not_count_views_and_index_shows_them(): void
+    {
+        $event = $this->createEvent();
+        $event->registerView();
+
+        $index = $this->get(action: 'index', controllerName: self::CONTROLLER);
+        $this->get(action: 'edit', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertEquals(1, Event::findById($event->id)->views_count);
+        $this->assertStringContainsString('<th>Visualizações</th>', $index);
+        $this->assertStringContainsString('<td class="views-count">1</td>', $index);
+    }
+
+    public function test_update_does_not_take_views_count_from_the_form(): void
+    {
+        $event = $this->createEvent();
+
+        $this->put(
+            action: 'update',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $event->id, 'event' => $this->validParams(['views_count' => '999'])]
+        );
+
+        $this->assertEquals(0, Event::findById($event->id)->views_count);
+    }
+
     /**
      * @param array<string, mixed> $overrides
      * @return array<string, mixed>
diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..7dfec68 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -681,4 +681,60 @@ class EventTest extends TestCase
 
         $event->destroy();
     }
+
+    /* ------------------- Visualizações ------------------- */
+
+    public function test_views_count_should_default_to_zero(): void
+    {
+        $event = new Event($this->params());
+        $this->assertSame(0, $event->views_count);
+
+        $event->save();
+        $this->assertEquals(0, Event::findById($event->id)->views_count);
+    }
+
+    public function test_register_view_should_increment_views_count(): void
+    {
+        $event = $this->createEvent();
+
+        $event->registerView();
+        $event->registerView();
+
+        $this->assertEquals(2, $event->views_count);
+        $this->assertEquals(2, Event::findById($event->id)->views_count);
+    }
+
+    public function test_register_view_should_not_run_the_validation(): void
+    {
+        $event = $this->createPastEvent();
+        $event->capacity = 0;
+
+        $event->registerView();
+
+        $stored = Event::findById($event->id);
+        $this->assertEquals(1, $stored->views_count);
+        $this->assertEquals(10, $stored->capacity);
+    }
+
+    public function test_register_view_on_new_record_should_do_nothing(): void
+    {
+        $event = new Event($this->params());
+
+        $event->registerView();
+
+        $this->assertSame(0, $event->views_count);
+        $this->assertCount(0, Event::all());
+    }
+
+    public function test_save_should_keep_the_views_count(): void
+    {
+        $event = $this->createEvent();
+        $event->registerView();
+
+        $loaded = Event::findById($event->id);
+        $loaded->title = 'Outro título';
+        $this->assertTrue($loaded->save());
+
+        $this->assertEquals(1, Event::findById($event->id)->views_count);
+    }
 }
