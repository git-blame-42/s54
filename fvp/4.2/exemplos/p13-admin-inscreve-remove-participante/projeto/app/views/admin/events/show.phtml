<?php
use App\Models\Event;

$audience = array_map(fn(string $value) => Event::AUDIENCES[$value] ?? $value, $event->audienceList());
?>
<dl class="row">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9"><?= htmlspecialchars($event->title) ?></dd>

    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9"><?= nl2br(htmlspecialchars($event->description)) ?></dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9"><?= Event::KINDS[$event->kind] ?? htmlspecialchars($event->kind) ?></dd>

    <dt class="col-sm-3">Modalidade</dt>
    <dd class="col-sm-9"><?= Event::MODALITIES[$event->modality] ?? htmlspecialchars($event->modality) ?></dd>

    <dt class="col-sm-3">Público-alvo</dt>
    <dd class="col-sm-9"><?= htmlspecialchars(implode(', ', $audience)) ?></dd>

    <dt class="col-sm-3">Data</dt>
    <dd class="col-sm-9"><?= date('d/m/Y', strtotime($event->starts_on)) ?></dd>

    <dt class="col-sm-3">Local</dt>
    <dd class="col-sm-9"><?= htmlspecialchars($event->location) ?></dd>

    <dt class="col-sm-3">Vagas</dt>
    <dd class="col-sm-9">
        <?= $event->enrollmentsCount() ?>/<?= (int) $event->capacity ?>
        (<?= $event->availableSpots() ?> disponíveis)
    </dd>
</dl>

<?php
$enrollments = $event->enrollments()->get();
$enrollable = $event->enrollableParticipants();
?>
<h2 class="h5">Inscritos</h2>
<?php if (empty($enrollments)) : ?>
    <p>Nenhuma inscrição.</p>
<?php else : ?>
    <table class="table table-sm" id="enrollments">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($enrollments as $enrollment) : ?>
                <?php $participant = $enrollment->user()->get(); ?>
                <tr>
                    <td><?= htmlspecialchars($participant->name) ?></td>
                    <td><?= htmlspecialchars($participant->email) ?></td>
                    <td>
                        <form class="d-inline" method="post"
                              action="<?= route('admin.events.enrollments.destroy', [
                                  'event_id' => $event->id,
                                  'id' => $enrollment->id,
                              ]) ?>">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                        </form>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
<?php endif; ?>

<?php if (empty($enrollable)) : ?>
    <p>Todos os Participantes já estão inscritos.</p>
<?php else : ?>
    <form class="row g-2 align-items-end mb-4" method="post"
          action="<?= route('admin.events.enrollments.create', ['event_id' => $event->id]) ?>">
        <div class="col-auto">
            <label for="enrollment_user_id" class="form-label">Inscrever Participante</label>
            <select class="form-select" id="enrollment_user_id" name="enrollment[user_id]">
                <option value="">Selecione...</option>
                <?php foreach ($enrollable as $user) : ?>
                    <?php $label = "{$user->name} ({$user->email})"; ?>
                    <option value="<?= (int) $user->id ?>"><?= htmlspecialchars($label) ?></option>
                <?php endforeach; ?>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-success">Inscrever</button>
        </div>
    </form>
<?php endif; ?>

<a class="btn btn-primary" href="<?= route('admin.events.edit', ['id' => $event->id]) ?>">Editar</a>
<a class="btn btn-secondary" href="<?= route('admin.events.index') ?>">Voltar</a>
