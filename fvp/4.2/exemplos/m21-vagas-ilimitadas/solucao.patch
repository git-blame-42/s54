@@ -131,11 +136,24 @@ class Event extends Model
         return count(Enrollment::where(['event_id' => $this->id]));
     }
 
+    /**
+     * Sem limite de vagas (capacity NULL no banco; em branco no formulário).
+     */
+    public function hasUnlimitedCapacity(): bool
+    {
+        return $this->capacity === null || $this->capacity === '';
+    }
+
     /**
      * Vagas restantes (capacity - Inscrições), nunca negativo. Calculado, não armazenado.
+     * Retorna null quando as vagas são ilimitadas: o Evento nunca lota.
      */
-    public function availableSpots(): int
+    public function availableSpots(): ?int
     {
+        if ($this->hasUnlimitedCapacity()) {
+            return null;
+        }
+
         return max(0, (int) $this->capacity - $this->enrollmentsCount());
     }
 
