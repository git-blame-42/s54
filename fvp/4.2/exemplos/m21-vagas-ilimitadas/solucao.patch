+    /* ------------------- vagas ilimitadas (capacity NULL) ------------------- */
+
+    public function test_blank_capacity_should_save_as_unlimited(): void
+    {
+        $event = new Event($this->params(['capacity' => '']));
+
+        $this->assertTrue($event->hasUnlimitedCapacity());
+        $this->assertTrue($event->save());
+        $this->assertNull($event->capacity);
+
+        $found = Event::findById($event->id);
+        $this->assertNull($found->capacity);
+        $this->assertTrue($found->hasUnlimitedCapacity());
+    }
+
+    public function test_null_capacity_should_be_valid(): void
+    {
+        $event = new Event($this->params(['capacity' => null]));
+
+        $this->assertTrue($event->isValid());
+        $this->assertNull($event->errors('capacity'));
+    }
+
+    public function test_event_with_capacity_should_not_be_unlimited(): void
+    {
+        $event = new Event($this->params(['capacity' => 1]));
+
+        $this->assertFalse($event->hasUnlimitedCapacity());
+    }
+
+    public function test_unlimited_event_should_never_be_full(): void
+    {
+        $event = $this->createEvent(['capacity' => null]);
+        $this->assertNull($event->availableSpots());
+
+        $this->enroll($event, 3);
+
+        // Com (int) null seria 0: "0 disponíveis" num Evento sem limite.
+        $this->assertNull($event->availableSpots());
+        $this->assertEquals(3, $event->enrollmentsCount());
+    }
+
+    public function test_limited_event_with_enrollments_can_become_unlimited(): void
+    {
+        $event = $this->createEvent(['capacity' => 3]);
+        $this->enroll($event, 3);
+
+        $event->capacity = '';
+
+        $this->assertTrue($event->save());
+        $this->assertNull(Event::findById($event->id)->capacity);
+    }
+
+    public function test_unlimited_event_cannot_get_capacity_below_enrollments(): void
+    {
+        $event = $this->createEvent(['capacity' => null]);
+        $this->enroll($event, 3);
+
+        $event->capacity = '2';
+
+        $this->assertFalse($event->save());
+        $this->assertEquals('não pode ser menor que o total de inscrições (3)!', $event->errors('capacity'));
+        $this->assertNull(Event::findById($event->id)->capacity);
+    }
+
+    public function test_database_should_still_reject_capacity_below_one(): void
+    {
+        $event = $this->createEvent();
+
+        // update() grava direto, sem validates(): quem barra é o CHECK do schema.
+        $this->expectException(PDOException::class);
+        $event->update(['capacity' => 0]);
+    }
+
