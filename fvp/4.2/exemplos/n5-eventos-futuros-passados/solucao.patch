+    /**
+     * Eventos de hoje em diante, do mais próximo ao mais distante.
+     *
+     * @return array<static>
+     */
+    public static function upcoming(): array
+    {
+        return self::byStartsOn('starts_on >= :today ORDER BY starts_on, id');
+    }
+
+    /**
+     * Eventos que já aconteceram (antes de hoje), do mais recente ao mais antigo.
+     *
+     * @return array<static>
+     */
+    public static function past(): array
+    {
+        return self::byStartsOn('starts_on < :today ORDER BY starts_on DESC, id DESC');
+    }
+
+    /**
+     * "Hoje" vem do PHP (mesmo fuso da validação de data), não do CURDATE() do MySQL.
+     * `$condition` é sempre um texto fixo deste model, nunca entrada do usuário.
+     *
+     * @return array<static>
+     */
+    private static function byStartsOn(string $condition): array
+    {
+        $columns = implode(', ', static::$columns);
+        $table = static::$table;
+
+        $stmt = Database::getDatabaseConn()->prepare("SELECT id, {$columns} FROM {$table} WHERE {$condition}");
+        $stmt->bindValue(':today', date('Y-m-d'));
+        $stmt->execute();
+
+        $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
+
+        return array_map(fn($row) => new static($row), $rows);
+    }
+
