diff --git a/lib/Config.php b/lib/Config.php
new file mode 100644
index 0000000..72841ee
--- /dev/null
+++ b/lib/Config.php
@@ -0,0 +1,26 @@
+<?php
+
+namespace Lib;
+
+/**
+ * Leitura de configurações do .env (gravadas em $_ENV pelo EnvLoader).
+ */
+class Config
+{
+    /**
+     * Inteiro da chave $key entre $min e $max. O valor do .env é sempre string ("" para chave vazia):
+     * só aceita dígitos; ausente, vazio, não numérico ou fora da faixa devolve $default.
+     */
+    public static function int(string $key, int $default, int $min, int $max): int
+    {
+        $value = $_ENV[$key] ?? null;
+
+        if (!is_string($value) || !ctype_digit($value)) {
+            return $default;
+        }
+
+        $number = (int) $value;
+
+        return ($number >= $min && $number <= $max) ? $number : $default;
+    }
+}
diff --git a/lib/Validations.php b/lib/Validations.php
index f456148..3ac7979 100644
--- a/lib/Validations.php
+++ b/lib/Validations.php
@@ -93,6 +93,27 @@ class Validations
         return true;
     }
 
+    /**
+     * O valor deve ser um número inteiro menor ou igual a $max (aceita string numérica, como vem de um form).
+     */
+    public static function integerMax($attribute, $obj, int $max)
+    {
+        $value = $obj->$attribute;
+        $number = is_int($value) || is_string($value) ? filter_var($value, FILTER_VALIDATE_INT) : false;
+
+        if ($number === false) {
+            $obj->addError($attribute, 'deve ser um número inteiro!');
+            return false;
+        }
+
+        if ($number > $max) {
+            $obj->addError($attribute, "deve ser menor ou igual a {$max}!");
+            return false;
+        }
+
+        return true;
+    }
+
     /**
      * A data deve existir no calendário e estar no formato $format (padrão Y-m-d).
      */
