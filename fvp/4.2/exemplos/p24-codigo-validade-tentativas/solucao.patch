+use Lib\CodeCheck;
 use Lib\FlashMessage;
 
 class EventsController extends Controller
@@ -34,6 +35,9 @@ class EventsController extends Controller
             return;
         }
 
+        // Código expirado ou esgotado é trocado ao voltar para a tela; o que ainda vale é mantido.
+        $event->currentConfirmationCode();
+
         $title = htmlspecialchars($event->title);
         $this->render('admin/events/show', compact('event', 'title'));
     }
@@ -102,8 +106,9 @@ class EventsController extends Controller
         }
 
         // Confere o código antes do safeDestroy: código errado não revela se o Evento tem Inscrições.
-        if (!$event->confirmsCode($request->getParam('confirmation_code'))) {
-            FlashMessage::danger('Código de confirmação incorreto!');
+        $result = $event->checkConfirmationCode($request->getParam('confirmation_code'));
+        if ($result !== CodeCheck::Ok) {
+            FlashMessage::danger($result->message());
             $this->redirectTo(route('admin.events.show', ['id' => $event->id]));
             return;
         }
