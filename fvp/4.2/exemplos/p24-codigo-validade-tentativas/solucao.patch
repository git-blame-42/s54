 app/Models/Event.php                          | 104 ++++++++
 app/views/admin/events/show.phtml             |   3 +
 database/schema.sql                           |   3 +
 lib/CodeCheck.php                             |  24 ++
 .../admin/events/DeleteEventCest.php          |  51 +++-
 tests/Integration/Access/EventsAccessTest.php |   2 +-
 .../Admin/EventsControllerTest.php            |  86 ++++++-
 .../Events/EventConfirmationCodeTest.php      | 230 ++++++++++++++++++
 9 files changed, 505 insertions(+), 7 deletions(-)
 create mode 100644 lib/CodeCheck.php
 create mode 100644 tests/Unit/Models/Events/EventConfirmationCodeTest.php

