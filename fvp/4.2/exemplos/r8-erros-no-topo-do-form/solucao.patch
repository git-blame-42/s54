+    public function test_create_with_invalid_data_lists_every_error_on_top(): void
+    {
+        $params = $this->validParams(['title' => '', 'capacity' => '0']);
+        unset($params['audience']);
+
+        $response = $this->post(action: 'create', controllerName: self::CONTROLLER, params: ['event' => $params]);
+
+        $this->assertStringContainsString('id="form_errors"', $response);
+        $this->assertStringContainsString('<li>Título: não pode ser vazio!</li>', $response);
+        $this->assertStringContainsString('<li>Público-alvo: não pode ser vazio!</li>', $response);
+        $this->assertStringContainsString('<li>Vagas: deve ser maior ou igual a 1!</li>', $response);
+        $start = (int) strpos($response, 'id="form_errors"');
+        $list = substr($response, $start, (int) strpos($response, '</ul>', $start) - $start);
+        $this->assertSame(3, substr_count($list, '<li>'));
+        // A lista vem antes do formulário e o feedback por campo continua.
+        $this->assertLessThan(strpos($response, '<form'), strpos($response, 'id="form_errors"'));
+        $this->assertStringContainsString('<div class="invalid-feedback">não pode ser vazio!</div>', $response);
+    }
+
+    public function test_update_with_invalid_data_lists_errors_on_top(): void
+    {
+        $event = $this->createEvent(['capacity' => 5]);
+        $this->enroll($event);
+        $this->enroll($event, 'outra@example.com');
+
+        $response = $this->put(
+            action: 'update',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $event->id, 'event' => $this->validParams(['capacity' => '1'])]
+        );
+
+        $this->assertStringContainsString(
+            '<li>Vagas: não pode ser menor que o total de inscrições (2)!</li>',
+            $response
+        );
+    }
+
+    public function test_valid_forms_do_not_show_the_error_list(): void
+    {
+        $event = $this->createEvent();
+
+        $new = $this->get(action: 'new', controllerName: self::CONTROLLER);
+        $edit = $this->get(action: 'edit', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertStringNotContainsString('id="form_errors"', $new);
+        $this->assertStringNotContainsString('id="form_errors"', $edit);
+    }
+
+    public function test_error_list_escapes_labels_and_messages(): void
+    {
+        $event = new Event();
+        $event->addError('title', '<b>negrito</b> & "aspas"');
+        $event->addError('<i>campo</i>', 'mensagem');
+
+        ob_start();
+        require __DIR__ . '/../../../../app/views/admin/events/_errors.phtml';
+        $html = (string) ob_get_clean();
+
+        $this->assertStringContainsString('<li>Título: &lt;b&gt;negrito&lt;/b&gt; &amp; &quot;aspas&quot;</li>', $html);
+        $this->assertStringContainsString('<li>&lt;i&gt;campo&lt;/i&gt;: mensagem</li>', $html);
+        $this->assertStringNotContainsString('<b>', $html);
+    }
+
