From 13d0765c508ea20f24591e0ebdb591228e287acb Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:17:51 -0300
Subject: [PATCH] feat: Confirm before removing an event

The remove form gets a data-confirm attribute and the new public/assets/js/events.js asks for confirmation on submit, with no inline JS in the view. DeleteEventCest accepts the dialog and covers canceling it.
---
 app/views/admin/events/index.phtml            |  3 ++-
 app/views/layouts/application.phtml           |  1 +
 public/assets/js/events.js                    | 11 ++++++++++
 .../admin/events/DeleteEventCest.php          | 21 ++++++++++++++++++-
 .../Admin/EventsControllerTest.php            | 15 +++++++++++++
 5 files changed, 49 insertions(+), 2 deletions(-)
 create mode 100644 public/assets/js/events.js

diff --git a/app/views/admin/events/index.phtml b/app/views/admin/events/index.phtml
index 6835d74..99efa20 100644
--- a/app/views/admin/events/index.phtml
+++ b/app/views/admin/events/index.phtml
@@ -27,7 +27,8 @@
                     <td>
                         <a class="btn btn-sm btn-outline-secondary" href="<?= route('admin.events.show', ['id' => $event->id]) ?>">Ver</a>
                         <a class="btn btn-sm btn-outline-primary" href="<?= route('admin.events.edit', ['id' => $event->id]) ?>">Editar</a>
-                        <form class="d-inline" action="<?= route('admin.events.destroy', ['id' => $event->id]) ?>" method="post">
+                        <form class="d-inline" action="<?= route('admin.events.destroy', ['id' => $event->id]) ?>" method="post"
+                              data-confirm="Remover o evento &quot;<?= htmlspecialchars($event->title) ?>&quot;?">
                             <input type="hidden" name="_method" value="DELETE">
                             <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                         </form>
diff --git a/app/views/layouts/application.phtml b/app/views/layouts/application.phtml
index 5e52801..c7e7281 100644
--- a/app/views/layouts/application.phtml
+++ b/app/views/layouts/application.phtml
@@ -7,6 +7,7 @@
 
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
     <script src="/assets/js/application.js"></script>
+    <script src="/assets/js/events.js"></script>
 
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
diff --git a/public/assets/js/events.js b/public/assets/js/events.js
new file mode 100644
index 0000000..c879307
--- /dev/null
+++ b/public/assets/js/events.js
@@ -0,0 +1,11 @@
+// Pede confirmação antes de enviar qualquer formulário com o atributo data-confirm
+// (ex.: o botão Remover da listagem de Eventos). O texto vem do próprio atributo.
+document.addEventListener("DOMContentLoaded", function () {
+  document.querySelectorAll("form[data-confirm]").forEach(function (form) {
+    form.addEventListener("submit", function (event) {
+      if (!window.confirm(form.dataset.confirm)) {
+        event.preventDefault();
+      }
+    });
+  });
+});
diff --git a/tests/Acceptance/admin/events/DeleteEventCest.php b/tests/Acceptance/admin/events/DeleteEventCest.php
index a7af30a..55b568f 100644
--- a/tests/Acceptance/admin/events/DeleteEventCest.php
+++ b/tests/Acceptance/admin/events/DeleteEventCest.php
@@ -47,9 +47,28 @@ class DeleteEventCest extends BaseEventsCest
         Assert::assertCount(self::TOTAL_EVENTS, Event::all());
     }
 
+    public function cancelingConfirmationKeepsEvent(AcceptanceTester $page): void
+    {
+        $event = $this->events[2];
+
+        $page->wantTo('Remoção do registro (cancelar a confirmação não remove)');
+        $page->amOnPage('/admin/events');
+
+        $page->click('Remover', $this->rowOf('Evento 02'));
+        $page->seeInPopup('Remover o evento "Evento 02"?');
+        $page->cancelPopup();
+
+        $page->seeCurrentUrlEquals('/admin/events');
+        $page->dontSee('Evento removido com sucesso!');
+        $page->see('Evento 02', 'table');
+        Assert::assertNotNull(Event::findById((int) $event->id));
+    }
+
     private function clickRemove(AcceptanceTester $page, string $title): void
     {
-        // Remover é um form com _method=DELETE e botão "Remover", sem confirm() (contrato-ui-eventos.md).
+        // Remover é um form com _method=DELETE e data-confirm: o events.js abre o confirm() antes de enviar.
         $page->click('Remover', $this->rowOf($title));
+        $page->seeInPopup("Remover o evento \"{$title}\"?");
+        $page->acceptPopup();
     }
 }
