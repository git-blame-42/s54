 app/Models/Event.php                          | 20 +++++++
 app/views/admin/events/index.phtml            |  4 ++
 config/routes.php                             |  2 +
 .../admin/events/DuplicateEventCest.php       | 40 ++++++++++++++
 tests/Integration/Access/EventsAccessTest.php | 20 ++++++-
 .../Admin/EventsControllerTest.php            | 52 +++++++++++++++++++
 7 files changed, 156 insertions(+), 1 deletion(-)
 create mode 100644 tests/Acceptance/admin/events/DuplicateEventCest.php

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..6a2da36 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -110,6 +110,25 @@ class EventsController extends Controller
         $this->redirectTo(route('admin.events.index'));
     }
 
+    public function duplicate(Request $request): void
+    {
+        $event = $this->findEvent($request);
+        if ($event === null) {
+            $this->eventNotFound();
+            return;
+        }
+
+        $copy = $event->duplicate();
+
+        if ($copy->save()) {
+            FlashMessage::success('Evento duplicado! Revise os dados.');
+            $this->redirectTo(route('admin.events.edit', ['id' => $copy->id]));
+        } else {
+            FlashMessage::danger('Não foi possível duplicar o evento!');
+            $this->redirectTo(route('admin.events.show', ['id' => $event->id]));
+        }
+    }
+
     /**
      * Copia para o Evento só os campos do formulário (nunca user_id nem id).
      */
diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..e0708f7 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -114,6 +114,26 @@ class Event extends Model
         }
     }
 
+    /**
+     * P6: cópia do Evento, ainda não salva (o controller chama save()). Copia todas as colunas,
+     * acrescenta " (cópia)" ao título e marca a data para daqui a 7 dias. Inscrições não são
+     * copiadas: ficam em event_user, e a cópia nasce sem nenhuma.
+     */
+    public function duplicate(): Event
+    {
+        $copy = new Event();
+
+        foreach (static::$columns as $column) {
+            $copy->$column = $this->$column;
+        }
+
+        // title é VARCHAR(255) e " (cópia)" tem 8 caracteres.
+        $copy->title = mb_substr($this->title, 0, 247) . ' (cópia)';
+        $copy->starts_on = date('Y-m-d', strtotime('+7 days'));
+
+        return $copy;
+    }
+
     public function user(): BelongsTo
     {
         return $this->belongsTo(User::class, 'user_id');
