From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:08:03 -0300
Subject: [PATCH] feat: Export events listing as CSV

Add GET /admin/events/export (admin.events.export) before /admin/events/{id}. The action writes the CSV to php://output with fputcsv, without layout, and the listing gets an Exportar CSV link.
---
 app/Controllers/Admin/EventsController.php    | 32 +++++++++++++++++
 app/views/admin/events/index.phtml            |  1 +
 config/routes.php                             |  4 ++-
 .../admin/events/ExportEventsCest.php         | 17 +++++++++
 tests/Integration/Access/EventsAccessTest.php | 15 +++++++-
 .../Admin/EventsControllerTest.php            | 35 +++++++++++++++++++
 6 files changed, 102 insertions(+), 2 deletions(-)
 create mode 100644 tests/Acceptance/admin/events/ExportEventsCest.php

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..9b222e2 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -26,6 +26,38 @@ class EventsController extends Controller
         $this->render('admin/events/index', compact('events', 'paginator', 'title'));
     }
 
+    /**
+     * Baixa todos os Eventos em CSV (sem layout): a resposta é o próprio arquivo.
+     */
+    public function export(): void
+    {
+        header('Content-Type: text/csv; charset=UTF-8');
+        header('Content-Disposition: attachment; filename="eventos.csv"');
+
+        $output = fopen('php://output', 'w');
+        if ($output === false) {
+            return;
+        }
+
+        // BOM UTF-8: sem ele o Excel mostra os acentos errados.
+        fwrite($output, "\xEF\xBB\xBF");
+        fputcsv($output, ['Título', 'Tipo', 'Modalidade', 'Data', 'Local', 'Inscrições', 'Capacidade']);
+
+        foreach (Event::all() as $event) {
+            fputcsv($output, [
+                $event->title,
+                Event::KINDS[$event->kind] ?? $event->kind,
+                Event::MODALITIES[$event->modality] ?? $event->modality,
+                date('d/m/Y', (int) strtotime($event->starts_on)),
+                $event->location,
+                $event->enrollmentsCount(),
+                (int) $event->capacity,
+            ]);
+        }
+
+        fclose($output);
+    }
+
     public function show(Request $request): void
     {
         $event = $this->findEvent($request);
