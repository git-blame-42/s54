+    public function test_export_returns_csv_with_header_and_events(): void
+    {
+        $event = $this->createEvent([
+            'title' => 'Oficina, com vírgula',
+            'kind' => 'workshop',
+            'modality' => 'online',
+            'starts_on' => date('Y-m-d', strtotime('+10 days')),
+            'location' => 'Bloco B',
+            'capacity' => 10,
+        ]);
+        $this->enroll($event);
+        $this->createEvent(['title' => 'Outro Evento']);
+
+        $response = $this->get(action: 'export', controllerName: self::CONTROLLER);
+
+        $this->assertStringStartsWith("\xEF\xBB\xBF", $response);
+        $lines = array_map('str_getcsv', explode("\n", trim(substr($response, 3))));
+
+        $this->assertCount(3, $lines);
+        $this->assertSame(['Título', 'Tipo', 'Modalidade', 'Data', 'Local', 'Inscrições', 'Capacidade'], $lines[0]);
+        $this->assertSame(
+            ['Oficina, com vírgula', 'Oficina', 'Online', date('d/m/Y', strtotime('+10 days')), 'Bloco B', '1', '10'],
+            $lines[1]
+        );
+        $this->assertSame('Outro Evento', $lines[2][0]);
+        $this->assertStringNotContainsString('<html', $response);
+    }
+
+    public function test_index_links_to_csv_export(): void
+    {
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
