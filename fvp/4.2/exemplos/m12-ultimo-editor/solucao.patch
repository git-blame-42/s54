         return $this->belongsTo(User::class, 'user_id');
     }
 
+    /**
+     * Último usuário que editou o Evento (coluna updated_by).
+     */
+    public function editor(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'updated_by');
+    }
+
+    /**
+     * Nome do último editor, ou '' se o Evento nunca foi editado.
+     */
+    public function editorName(): string
+    {
+        if ($this->updated_by === null) {
+            return '';
+        }
+
+        $editor = $this->editor()->get();
+
+        return $editor instanceof User ? $editor->name : '';
+    }
+
     /**
      * Total de Inscrições (linhas em event_user) deste Evento.
      */
