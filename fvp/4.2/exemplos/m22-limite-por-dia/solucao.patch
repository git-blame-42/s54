+    /* ------------------- limite de Eventos por dia ------------------- */
+
+    public function test_day_should_accept_up_to_the_limit_of_events(): void
+    {
+        for ($i = 1; $i <= Event::MAX_EVENTS_PER_DAY; $i++) {
+            $this->createEvent(['title' => "Evento {$i}"]);
+        }
+
+        $this->assertCount(Event::MAX_EVENTS_PER_DAY, Event::where(['starts_on' => $this->params()['starts_on']]));
+    }
+
+    public function test_day_over_the_limit_should_be_invalid(): void
+    {
+        for ($i = 1; $i <= Event::MAX_EVENTS_PER_DAY; $i++) {
+            $this->createEvent(['title' => "Evento {$i}"]);
+        }
+
+        $event = new Event($this->params(['title' => 'Evento a mais']));
+
+        $this->assertFalse($event->save());
+        $this->assertEquals('já tem 3 eventos neste dia, escolha outra data!', $event->errors('starts_on'));
+        $this->assertCount(Event::MAX_EVENTS_PER_DAY, Event::all());
+    }
+
+    public function test_other_day_should_not_count_for_the_limit(): void
+    {
+        for ($i = 1; $i <= Event::MAX_EVENTS_PER_DAY; $i++) {
+            $this->createEvent(['title' => "Evento {$i}"]);
+        }
+
+        $event = new Event($this->params(['starts_on' => date('Y-m-d', strtotime('+31 days'))]));
+
+        $this->assertTrue($event->save());
+    }
+
+    public function test_update_on_a_full_day_should_not_count_the_event_itself(): void
+    {
+        $events = [];
+        for ($i = 1; $i <= Event::MAX_EVENTS_PER_DAY; $i++) {
+            $events[] = $this->createEvent(['title' => "Evento {$i}"]);
+        }
+
+        $event = Event::findById($events[0]->id);
+        $this->assertInstanceOf(Event::class, $event);
+        $event->title = 'Título corrigido';
+
+        $this->assertTrue($event->save());
+        $this->assertEquals('Título corrigido', Event::findById($event->id)?->title);
+    }
+
+    public function test_past_date_on_a_full_day_should_show_the_past_date_error(): void
+    {
+        $past = date('Y-m-d', strtotime('-5 days'));
+        for ($i = 1; $i <= Event::MAX_EVENTS_PER_DAY; $i++) {
+            // update() grava sem validar: é o único jeito de ter Eventos no passado.
+            $this->assertTrue($this->createEvent(['title' => "Evento {$i}"])->update(['starts_on' => $past]));
+        }
+
+        $event = new Event($this->params(['title' => 'Evento a mais', 'starts_on' => $past]));
+
+        $this->assertFalse($event->save());
+        $this->assertEquals('não pode estar no passado!', $event->errors('starts_on'));
+        $this->assertCount(Event::MAX_EVENTS_PER_DAY, Event::all());
+    }
+
+    public function test_update_moving_to_a_full_day_should_be_invalid(): void
+    {
+        for ($i = 1; $i <= Event::MAX_EVENTS_PER_DAY; $i++) {
+            $this->createEvent(['title' => "Evento {$i}"]);
+        }
+        $other = $this->createEvent(['title' => 'Outro dia', 'starts_on' => date('Y-m-d', strtotime('+31 days'))]);
+
+        $other->starts_on = $this->params()['starts_on'];
+
+        $this->assertFalse($other->save());
+        $this->assertEquals('já tem 3 eventos neste dia, escolha outra data!', $other->errors('starts_on'));
+        $this->assertEquals(date('Y-m-d', strtotime('+31 days')), Event::findById($other->id)?->starts_on);
+    }
+
     /* ------------------- P02: capacity >= Inscrições ------------------- */
 
     public function test_capacity_below_enrollments_should_be_invalid_on_edit(): void
