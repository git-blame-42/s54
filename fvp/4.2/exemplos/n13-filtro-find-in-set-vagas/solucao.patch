From 12e6ca7812c68859b9099da216642a6b678a87ec Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:05:20 -0300
Subject: [PATCH] feat: Filter events by audience and available spots

Event::searchFiltered uses FIND_IN_SET on the audience SET and a COUNT subquery on enrollments; filtered results are not paginated.
---
 app/Controllers/Admin/EventsController.php    | 29 ++++++--
 app/Models/Event.php                          | 40 +++++++++++
 app/views/admin/events/index.phtml            | 40 ++++++++++-
 .../admin/events/FilterEventsCest.php         | 52 ++++++++++++++
 .../Admin/EventsControllerTest.php            | 71 +++++++++++++++++++
 tests/Unit/Models/Events/EventTest.php        | 70 ++++++++++++++++++
 6 files changed, 293 insertions(+), 9 deletions(-)
 create mode 100644 tests/Acceptance/admin/events/FilterEventsCest.php

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..e1f77cc 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -15,15 +15,30 @@ class EventsController extends Controller
 
     public function index(Request $request): void
     {
-        $paginator = Event::paginate(
-            page: max(1, (int) $request->getParam('page', 1)),
-            per_page: self::PER_PAGE,
-            route: 'admin.events.paginate'
-        );
-        $events = $paginator->registers();
+        // Valor fora da lista fechada é ignorado (cai em "todos").
+        $audience = $request->getParam('audience');
+        $audience = is_string($audience) && array_key_exists($audience, Event::AUDIENCES) ? $audience : null;
+        $onlyAvailable = $request->getParam('available') === '1';
+        $filtering = $audience !== null || $onlyAvailable;
+
+        if ($filtering) {
+            // Com filtro, a lista vem inteira, sem paginação (o Paginator só aceita condições de igualdade).
+            $events = Event::searchFiltered($audience, $onlyAvailable);
+            $paginator = null;
+        } else {
+            $paginator = Event::paginate(
+                page: max(1, (int) $request->getParam('page', 1)),
+                per_page: self::PER_PAGE,
+                route: 'admin.events.paginate'
+            );
+            $events = $paginator->registers();
+        }
 
         $title = 'Eventos';
-        $this->render('admin/events/index', compact('events', 'paginator', 'title'));
+        $this->render(
+            'admin/events/index',
+            compact('events', 'paginator', 'title', 'audience', 'onlyAvailable', 'filtering')
+        );
     }
 
     public function show(Request $request): void
diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..6134be8 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -4,6 +4,8 @@ namespace App\Models;
 
 use Core\Database\ActiveRecord\BelongsTo;
 use Core\Database\ActiveRecord\Model;
+use Core\Database\Database;
+use PDO;
 use Lib\Validations;
 use PDOException;
 
@@ -114,6 +116,44 @@ class Event extends Model
         }
     }
 
+    /**
+     * Filtros que o `where` (só igualdade) não expressa:
+     * - $audience: Eventos cujo SET `audience` contém o valor (FIND_IN_SET); null = qualquer público;
+     * - $onlyAvailable: só Eventos com vaga (capacity maior que o total de Inscrições, subconsulta COUNT).
+     * Valores do usuário só entram por bindValue; o SQL é montado com trechos fixos.
+     *
+     * @return array<static>
+     */
+    public static function searchFiltered(?string $audience, bool $onlyAvailable): array
+    {
+        $conditions = [];
+
+        if ($audience !== null) {
+            $conditions[] = 'FIND_IN_SET(:audience, audience) > 0';
+        }
+
+        if ($onlyAvailable) {
+            $conditions[] = 'capacity > (SELECT COUNT(*) FROM event_user WHERE event_user.event_id = events.id)';
+        }
+
+        $where = $conditions === [] ? '' : 'WHERE ' . implode(' AND ', $conditions);
+        $columns = implode(', ', static::$columns);
+
+        $sql = <<<SQL
+            SELECT id, {$columns} FROM events
+            {$where}
+            ORDER BY id
+        SQL;
+
+        $stmt = Database::getDatabaseConn()->prepare($sql);
+        if ($audience !== null) {
+            $stmt->bindValue(':audience', $audience);
+        }
+        $stmt->execute();
+
+        return array_map(fn(array $row) => new static($row), $stmt->fetchAll(PDO::FETCH_ASSOC));
+    }
+
     public function user(): BelongsTo
     {
         return $this->belongsTo(User::class, 'user_id');
