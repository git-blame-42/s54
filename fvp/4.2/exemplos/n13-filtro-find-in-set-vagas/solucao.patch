diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..4298c2b 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -385,6 +385,76 @@ class EventTest extends TestCase
         $this->assertFalse(Event::exists(['title' => 'Outro']));
     }
 
+    /* ------------------- N13: FIND_IN_SET e "só com vagas" ------------------- */
+
+    /**
+     * @param array<int, Event> $events
+     * @return array<int, string>
+     */
+    private function titlesOf(array $events): array
+    {
+        return array_map(fn(Event $event) => $event->title, $events);
+    }
+
+    public function test_search_filtered_by_audience_should_match_only_events_with_that_audience(): void
+    {
+        $this->createEvent(['title' => 'Só estudantes', 'audience' => 'students']);
+        $this->createEvent(['title' => 'Estudantes e professores', 'audience' => 'students,professors']);
+        $this->createEvent(['title' => 'Só servidores', 'audience' => 'staff']);
+        $this->createEvent(['title' => 'Comunidade', 'audience' => 'community,staff']);
+
+        $this->assertSame(
+            ['Só estudantes', 'Estudantes e professores'],
+            $this->titlesOf(Event::searchFiltered('students', false))
+        );
+        $this->assertSame(
+            ['Só servidores', 'Comunidade'],
+            $this->titlesOf(Event::searchFiltered('staff', false))
+        );
+        $this->assertSame([], Event::searchFiltered('aliens', false));
+    }
+
+    public function test_search_filtered_by_audience_should_not_match_parts_of_a_value(): void
+    {
+        // LIKE '%staff%' casaria "staff" dentro de outro texto; FIND_IN_SET compara o item inteiro.
+        $this->createEvent(['title' => 'Professores', 'audience' => 'professors']);
+
+        $this->assertSame([], Event::searchFiltered('professor', false));
+        $this->assertSame([], Event::searchFiltered('students,professors', false));
+    }
+
+    public function test_search_filtered_only_available_should_exclude_full_events(): void
+    {
+        $full = $this->createEvent(['title' => 'Lotado', 'capacity' => 2]);
+        $this->enroll($full, 2);
+        $almost = $this->createEvent(['title' => 'Quase lotado', 'capacity' => 2]);
+        $this->enroll($almost, 1);
+        $this->createEvent(['title' => 'Vazio', 'capacity' => 2]);
+
+        $this->assertSame(['Quase lotado', 'Vazio'], $this->titlesOf(Event::searchFiltered(null, true)));
+    }
+
+    public function test_search_filtered_should_combine_both_filters(): void
+    {
+        $full = $this->createEvent(['title' => 'Estudantes lotado', 'audience' => 'students', 'capacity' => 1]);
+        $this->enroll($full, 1);
+        $this->createEvent(['title' => 'Estudantes com vaga', 'audience' => 'students']);
+        $this->createEvent(['title' => 'Servidores com vaga', 'audience' => 'staff']);
+
+        $this->assertSame(['Estudantes com vaga'], $this->titlesOf(Event::searchFiltered('students', true)));
+    }
+
+    public function test_search_filtered_without_filters_should_return_all_events_in_id_order(): void
+    {
+        $this->createEvent(['title' => 'Primeiro']);
+        $this->createEvent(['title' => 'Segundo']);
+
+        $events = Event::searchFiltered(null, false);
+
+        $this->assertSame(['Primeiro', 'Segundo'], $this->titlesOf($events));
+        $this->assertContainsOnlyInstancesOf(Event::class, $events);
+    }
+
