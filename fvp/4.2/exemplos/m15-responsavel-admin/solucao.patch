+    /**
+     * O responsável (user_id) vem do formulário: tem de existir e ser administrador. Sem isso, um POST
+     * forjado poderia dar o Evento a um Participante, e um id inexistente estouraria a FK (500).
+     */
+    private function validatesUserIsAdmin(): void
+    {
+        $user = User::findById((int) $this->user_id);
+
+        if ($user === null || !$user->isAdmin()) {
+            $this->addError('user_id', 'deve ser um administrador existente!');
+        }
+    }
+
