                <tr>
                    <td><?= htmlspecialchars((string) $participant?->name) ?></td>
                    <td><?= htmlspecialchars((string) $participant?->email) ?></td>
                    <td><?= date('d/m/Y H:i', strtotime((string) $enrollment->created_at)) ?></td>
                </tr>
            <?php endforeach; ?>
