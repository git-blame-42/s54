        <a href="<?= route('admin.events.enrollments.index', ['id' => $event->id]) ?>">Ir para a primeira página</a>.
    </p>
<?php else : ?>
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Inscrito em</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($enrollments as $enrollment) : ?>
