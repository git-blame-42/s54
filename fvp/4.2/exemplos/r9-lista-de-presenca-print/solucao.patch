diff --git a/public/assets/css/print.css b/public/assets/css/print.css
new file mode 100644
index 0000000..5d00f1c
--- /dev/null
+++ b/public/assets/css/print.css
@@ -0,0 +1,60 @@
+/* Layout de impressão (lista de presença): sem navbar, preto no branco. */
+body.print-layout {
+  font-family: Arial, Helvetica, sans-serif;
+  color: #000;
+  background: #fff;
+  margin: 2rem;
+}
+
+.print-layout h1 {
+  font-size: 1.5rem;
+  margin-bottom: 0.25rem;
+}
+
+.print-layout h2 {
+  font-size: 1.2rem;
+  margin: 0.5rem 0;
+}
+
+.actions {
+  margin: 1rem 0;
+}
+
+table.attendance {
+  width: 100%;
+  border-collapse: collapse;
+}
+
+table.attendance th,
+table.attendance td {
+  border: 1px solid #000;
+  padding: 0.5rem;
+  text-align: left;
+}
+
+table.attendance td {
+  height: 2rem;
+}
+
+table.attendance .number {
+  width: 2.5rem;
+  text-align: center;
+}
+
+table.attendance .signature {
+  width: 35%;
+}
+
+@media print {
+  body.print-layout {
+    margin: 0;
+  }
+
+  .no-print {
+    display: none;
+  }
+
+  table.attendance tr {
+    page-break-inside: avoid;
+  }
+}
diff --git a/public/assets/js/print.js b/public/assets/js/print.js
new file mode 100644
index 0000000..0e10dd9
--- /dev/null
+++ b/public/assets/js/print.js
@@ -0,0 +1,10 @@
+// Botão "Imprimir" da lista de presença (layouts/print.phtml).
+document.addEventListener("DOMContentLoaded", function () {
+  const button = document.getElementById("print_button");
+
+  if (!button) return;
+
+  button.addEventListener("click", function () {
+    window.print();
+  });
+});
