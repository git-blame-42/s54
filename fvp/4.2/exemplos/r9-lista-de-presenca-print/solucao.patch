@@ -4,6 +4,8 @@ namespace App\Models;
 
 use Core\Database\ActiveRecord\BelongsTo;
 use Core\Database\ActiveRecord\Model;
+use Core\Database\Database;
+use PDO;
 use Lib\Validations;
 use PDOException;
 
@@ -119,6 +121,33 @@ class Event extends Model
         return $this->belongsTo(User::class, 'user_id');
     }
 
+    /**
+     * Participantes inscritos neste Evento, em ordem alfabética (lista de presença).
+     * Uma consulta só (JOIN com a pivô event_user), sem N+1.
+     *
+     * @return array<int, User>
+     */
+    public function participants(): array
+    {
+        if ($this->newRecord()) {
+            return [];
+        }
+
+        $sql = <<<SQL
+            SELECT users.id, users.name, users.email, users.role
+            FROM users
+            INNER JOIN event_user ON event_user.user_id = users.id
+            WHERE event_user.event_id = :event_id
+            ORDER BY users.name, users.id
+        SQL;
+
+        $stmt = Database::getDatabaseConn()->prepare($sql);
+        $stmt->bindValue(':event_id', $this->id, PDO::PARAM_INT);
+        $stmt->execute();
+
+        return array_map(fn(array $row) => new User($row), $stmt->fetchAll(PDO::FETCH_ASSOC));
+    }
+
     /**
      * Total de Inscrições (linhas em event_user) deste Evento.
      */
