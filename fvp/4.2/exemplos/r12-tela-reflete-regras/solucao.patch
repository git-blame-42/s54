From 7505f60abdda7c30e9cb1a55f07e0025c706f9e1 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:38:13 -0300
Subject: [PATCH] feat: Reflect enrollment rules in the events screens

Hide the Remove button of events with enrollments (Event::isRemovable,
same rule as safeDestroy) and set the capacity field minimum to the
enrollments count (Event::minCapacity), with a hint when there are
enrollments. The server-side rules stay in the model.
---
 app/Models/Event.php                          | 18 ++++++++
 app/views/admin/events/_form.phtml            |  6 ++-
 app/views/admin/events/index.phtml            | 13 ++++--
 .../admin/events/DeleteEventCest.php          | 12 +++--
 .../admin/events/ListEventsCest.php           |  3 +-
 .../events/UpdateWithInvalidDataCest.php      |  3 ++
 .../Admin/EventsControllerTest.php            | 45 +++++++++++++++++++
 tests/Unit/Models/Events/EventTest.php        | 45 +++++++++++++++++++
 8 files changed, 132 insertions(+), 13 deletions(-)

diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..4d0d970 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -144,6 +144,24 @@ class Event extends Model
         return $this->enrollmentsCount() > 0;
     }
 
+    /**
+     * Mesma regra de safeDestroy(): só Evento salvo e sem Inscrições pode ser removido.
+     * Serve para a tela esconder o Remover; quem barra a remoção continua sendo safeDestroy().
+     */
+    public function isRemovable(): bool
+    {
+        return !$this->newRecord() && !$this->hasEnrollments();
+    }
+
+    /**
+     * Menor capacidade aceita: 1, ou o total de Inscrições se for maior
+     * (mesma regra de validatesCapacityAgainstEnrollments()).
+     */
+    public function minCapacity(): int
+    {
+        return max(1, $this->enrollmentsCount());
+    }
+
     /**
      * Remove o Evento sem lançar exceção (P03): se houver Inscrições, não remove,
      * retorna false e registra o motivo em errors('base').
diff --git a/app/views/admin/events/_form.phtml b/app/views/admin/events/_form.phtml
index 2e98c21..c6ac66f 100644
--- a/app/views/admin/events/_form.phtml
+++ b/app/views/admin/events/_form.phtml
@@ -83,9 +83,13 @@ $feedback = fn(string $field, string $extra = ''): string => $event->errors($fie
 
     <div class="mb-3">
         <label for="event_capacity" class="form-label">Vagas</label>
+        <?php $minCapacity = $event->minCapacity(); ?>
         <input type="number" class="form-control<?= $invalid('capacity') ?>" id="event_capacity" name="event[capacity]"
-            min="1" value="<?= htmlspecialchars((string) $event->capacity) ?>">
+            min="<?= $minCapacity ?>" value="<?= htmlspecialchars((string) $event->capacity) ?>">
         <?= $feedback('capacity') ?>
+        <?php if ($event->hasEnrollments()) : ?>
+            <div class="form-text">Mínimo: <?= $minCapacity ?> (total de inscrições).</div>
+        <?php endif; ?>
     </div>
 
     <button type="submit" class="btn btn-primary">Salvar</button>
diff --git a/app/views/admin/events/index.phtml b/app/views/admin/events/index.phtml
