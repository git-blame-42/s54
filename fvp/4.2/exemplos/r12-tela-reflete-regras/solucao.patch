diff --git a/tests/Integration/Controllers/Admin/EventsControllerTest.php b/tests/Integration/Controllers/Admin/EventsControllerTest.php
index bc62d1d..4cea142 100644
--- a/tests/Integration/Controllers/Admin/EventsControllerTest.php
+++ b/tests/Integration/Controllers/Admin/EventsControllerTest.php
@@ -160,6 +160,51 @@ class EventsControllerTest extends ControllerTestCase
         $this->assertStringContainsString("/admin/events/{$event->id}/edit", $response);
     }
 
+    public function test_index_hides_remove_button_of_event_with_enrollments(): void
+    {
+        $free = $this->createEvent(['title' => 'Sem inscrições']);
+        $taken = $this->createEvent(['title' => 'Com inscritos']);
+        $this->enroll($taken);
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        // O link Ver usa href; só o form de Remover usa action.
+        $this->assertStringContainsString("action=\"/admin/events/{$free->id}\"", $response);
+        $this->assertStringNotContainsString("action=\"/admin/events/{$taken->id}\"", $response);
+        $this->assertSame(1, substr_count($response, '>Remover</button>'));
+        $this->assertStringContainsString('Com inscrições', $response);
+    }
+
+    public function test_edit_sets_min_capacity_to_enrollments_count(): void
+    {
+        $event = $this->createEvent(['capacity' => 10]);
+        $this->enroll($event, 'p1@example.com');
+        $this->enroll($event, 'p2@example.com');
+
+        $response = $this->get(action: 'edit', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertStringContainsString('min="2"', $response);
+        $this->assertStringContainsString('Mínimo: 2 (total de inscrições).', $response);
+    }
+
+    public function test_edit_without_enrollments_keeps_min_one_and_no_hint(): void
+    {
+        $event = $this->createEvent();
+
+        $response = $this->get(action: 'edit', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertStringContainsString('min="1"', $response);
+        $this->assertStringNotContainsString('Mínimo:', $response);
+    }
+
+    public function test_new_form_has_min_capacity_one(): void
+    {
+        $response = $this->get(action: 'new', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString('min="1"', $response);
+        $this->assertStringNotContainsString('Mínimo:', $response);
+    }
+
     public function test_show_with_unknown_id_redirects_to_index(): void
     {
         $response = $this->get(action: 'show', controllerName: self::CONTROLLER, params: ['id' => 9999]);
diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..4d388f7 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -490,6 +490,51 @@ class EventTest extends TestCase
         $this->assertEquals(3, $event->availableSpots());
     }
 
+    /* ------------------- regras expostas para a tela ------------------- */
+
+    public function test_new_event_should_not_be_removable(): void
+    {
+        $event = new Event($this->params());
+
+        $this->assertFalse($event->isRemovable());
+    }
+
+    public function test_saved_event_without_enrollments_should_be_removable(): void
+    {
+        $event = $this->createEvent();
+
+        $this->assertTrue($event->isRemovable());
+    }
+
+    public function test_event_with_enrollments_should_not_be_removable(): void
+    {
+        $event = $this->createEvent();
+        $this->enroll($event, 1);
+
+        $this->assertFalse($event->isRemovable());
+        $this->assertFalse($event->safeDestroy());
+    }
+
+    public function test_min_capacity_should_be_one_without_enrollments(): void
+    {
+        $this->assertSame(1, (new Event($this->params()))->minCapacity());
+        $this->assertSame(1, $this->createEvent()->minCapacity());
+    }
+
+    public function test_min_capacity_should_be_the_enrollments_count(): void
+    {
+        $event = $this->createEvent(['capacity' => 5]);
+        $this->enroll($event, 3);
+
+        $this->assertSame(3, $event->minCapacity());
+
+        // A capacidade mínima informada é aceita; uma a menos, não.
+        $event->capacity = $event->minCapacity();
+        $this->assertTrue($event->isValid());
+        $event->capacity = $event->minCapacity() - 1;
+        $this->assertFalse($event->isValid());
+    }
+
     /* ------------------- starts_on: "não passada" só no create e quando a data muda ------------------- */
 
