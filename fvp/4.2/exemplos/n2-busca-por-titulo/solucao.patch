+    public function test_index_searches_by_title_without_pagination(): void
+    {
+        // 7 Eventos com "Git" no título: com busca, todos aparecem numa página só.
+        for ($i = 1; $i <= 7; $i++) {
+            $this->createEvent(['title' => sprintf('Oficina de Git %02d', $i)]);
+        }
+        $this->createEvent(['title' => 'Palestra de Segurança']);
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['q' => ' git ']);
+
+        $this->assertStringContainsString('Oficina de Git 01', $response);
+        $this->assertStringContainsString('Oficina de Git 07', $response);
+        $this->assertStringNotContainsString('Palestra de Segurança', $response);
+        $this->assertStringContainsString('value="git"', $response);
+        $this->assertStringNotContainsString('class="pagination', $response);
+    }
+
+    public function test_index_search_without_results_shows_message_and_escapes_term(): void
+    {
+        $this->createEvent(['title' => 'Oficina de Git']);
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['q' => '<b>x</b>']);
+
+        $this->assertStringContainsString('Nenhum evento encontrado para "&lt;b&gt;x&lt;/b&gt;".', $response);
+        $this->assertStringContainsString('value="&lt;b&gt;x&lt;/b&gt;"', $response);
+        $this->assertStringNotContainsString('<b>x</b>', $response);
+        $this->assertStringNotContainsString('Oficina de Git', $response);
+    }
+
+    public function test_index_with_empty_or_invalid_search_lists_paginated(): void
+    {
+        for ($i = 1; $i <= 7; $i++) {
+            $this->createEvent(['title' => sprintf('Evento %02d', $i)]);
+        }
+
+        foreach (['', '   ', ['git']] as $q) {
+            $response = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['q' => $q]);
+
+            $this->assertStringContainsString('Evento 05', $response);
+            $this->assertStringNotContainsString('Evento 06', $response);
+            $this->assertStringContainsString('/admin/events/page/2', $response);
+            $this->assertStringContainsString('value=""', $response);
+        }
+    }
+
