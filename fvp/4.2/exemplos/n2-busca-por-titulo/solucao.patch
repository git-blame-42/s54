 app/Models/Event.php                          | 23 ++++++++
 app/views/admin/events/index.phtml            | 17 +++++-
 .../admin/events/SearchEventsCest.php         | 54 +++++++++++++++++++
 .../Admin/EventsControllerTest.php            | 45 ++++++++++++++++
 tests/Unit/Models/Events/EventTest.php        | 21 ++++++++
 6 files changed, 174 insertions(+), 9 deletions(-)
 create mode 100644 tests/Acceptance/admin/events/SearchEventsCest.php

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..7b04c72 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -15,15 +15,24 @@ class EventsController extends Controller
 
     public function index(Request $request): void
     {
-        $paginator = Event::paginate(
-            page: max(1, (int) $request->getParam('page', 1)),
-            per_page: self::PER_PAGE,
-            route: 'admin.events.paginate'
-        );
-        $events = $paginator->registers();
+        $q = $request->getParam('q');
+        $q = is_string($q) ? trim($q) : '';
+
+        if ($q !== '') {
+            // Com busca, sem paginação: todos os Eventos cujo título contém o termo.
+            $events = Event::searchByTitle($q);
+            $paginator = null;
+        } else {
+            $paginator = Event::paginate(
+                page: max(1, (int) $request->getParam('page', 1)),
+                per_page: self::PER_PAGE,
+                route: 'admin.events.paginate'
+            );
+            $events = $paginator->registers();
+        }
 
         $title = 'Eventos';
-        $this->render('admin/events/index', compact('events', 'paginator', 'title'));
+        $this->render('admin/events/index', compact('events', 'paginator', 'q', 'title'));
     }
 
     public function show(Request $request): void
