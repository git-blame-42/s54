 use PDOException;
 
 /**
@@ -144,6 +146,27 @@ class Event extends Model
         return $this->enrollmentsCount() > 0;
     }
 
+    /**
+     * Eventos cujo título contém o termo (LIKE). O termo vai por bindValue, nunca concatenado no SQL.
+     *
+     * @return array<static>
+     */
+    public static function searchByTitle(string $term): array
+    {
+        $columns = implode(', ', static::$columns);
+        $table = static::$table;
+
+        $stmt = Database::getDatabaseConn()->prepare(
+            "SELECT id, {$columns} FROM {$table} WHERE title LIKE :term"
+        );
+        $stmt->bindValue(':term', "%{$term}%");
+        $stmt->execute();
+
+        $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
+
+        return array_map(fn($row) => new static($row), $rows);
+    }
+
