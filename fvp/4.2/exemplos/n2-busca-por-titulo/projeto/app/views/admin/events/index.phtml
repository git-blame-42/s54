<div class="mb-3">
    <a class="btn btn-primary" href="<?= route('admin.events.new') ?>">Novo Evento</a>
</div>

<form class="row g-2 align-items-center mb-3" method="get" action="<?= route('admin.events.index') ?>">
    <div class="col-auto">
        <label class="visually-hidden" for="search_q">Buscar por título</label>
        <input class="form-control" type="search" id="search_q" name="q" placeholder="Buscar por título"
               value="<?= htmlspecialchars($q) ?>">
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
</form>

<?php if (empty($events)) : ?>
    <p><?= $q !== '' ? 'Nenhum evento encontrado para "' . htmlspecialchars($q) . '".' : 'Nenhum evento cadastrado.' ?></p>
<?php else : ?>
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Tipo</th>
                <th>Data</th>
                <th>Local</th>
                <th>Vagas</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($events as $event) : ?>
                <tr>
                    <td><?= htmlspecialchars($event->title) ?></td>
                    <td><?= \App\Models\Event::KINDS[$event->kind] ?? htmlspecialchars($event->kind) ?></td>
                    <td><?= date('d/m/Y', strtotime($event->starts_on)) ?></td>
                    <td><?= htmlspecialchars($event->location) ?></td>
                    <td><?= $event->enrollmentsCount() ?>/<?= (int) $event->capacity ?></td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" href="<?= route('admin.events.show', ['id' => $event->id]) ?>">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" href="<?= route('admin.events.edit', ['id' => $event->id]) ?>">Editar</a>
                        <form class="d-inline" action="<?= route('admin.events.destroy', ['id' => $event->id]) ?>" method="post">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                        </form>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>

    <?php if ($paginator !== null) : ?>
        <?php $paginator->renderPagesNavigation(); ?>
    <?php endif; ?>
<?php endif; ?>
