From 7b2351fe9de69009af25cda676e3f4073ba1fd5d Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:59:41 -0300
Subject: [PATCH] fix: Accept _method override only from POST body

Request read _method from $_REQUEST, so GET /admin/events/16?_method=DELETE
reached destroy. The override now applies only when the real method is
POST, reads $_POST, and accepts only PUT and DELETE.
---
 core/Http/Request.php                         | 27 +++++++-
 tests/Integration/Access/EventsAccessTest.php | 58 ++++++++++++++++
 tests/Unit/Core/Http/RequestTest.php          | 67 +++++++++++++++++++
 3 files changed, 151 insertions(+), 1 deletion(-)

diff --git a/core/Http/Request.php b/core/Http/Request.php
index 2c5fd40..e529ac2 100644
--- a/core/Http/Request.php
+++ b/core/Http/Request.php
@@ -4,6 +4,12 @@ namespace Core\Http;
 
 class Request
 {
+    /**
+     * Métodos que um formulário pode simular com o campo oculto `_method` (HTML só envia GET e POST).
+     * São os únicos além de GET/POST que o Router conhece (Route::put e Route::delete; não há patch).
+     */
+    private const OVERRIDABLE_METHODS = ['PUT', 'DELETE'];
+
     private string $method;
     private string $uri;
 
@@ -15,12 +21,31 @@ class Request
 
     public function __construct()
     {
-        $this->method = $_REQUEST['_method'] ?? $_SERVER['REQUEST_METHOD'];
+        $this->method = $this->resolveMethod();
         $this->uri = $_SERVER['REQUEST_URI'];
         $this->params = $_REQUEST;
         $this->headers = function_exists('getallheaders') ? getallheaders() : [];
     }
 
+    /**
+     * Método HTTP da requisição. O `_method` só troca o método quando a requisição real é POST e o valor
+     * vem do corpo ($_POST), nunca da query string: assim um GET (link, <img>, prefetch) não vira DELETE.
+     * Valores fora de OVERRIDABLE_METHODS são ignorados.
+     */
+    private function resolveMethod(): string
+    {
+        $method = strtoupper((string) $_SERVER['REQUEST_METHOD']);
+        $override = $_POST['_method'] ?? null;
+
+        if ($method !== 'POST' || !is_string($override)) {
+            return $method;
+        }
+
+        $override = strtoupper($override);
+
+        return in_array($override, self::OVERRIDABLE_METHODS, true) ? $override : $method;
+    }
+
     public function getMethod(): string
     {
         return $this->method;
