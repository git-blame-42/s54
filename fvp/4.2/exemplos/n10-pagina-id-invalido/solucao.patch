From c4d5d9353a17d1b34046b68e849c36e600445148 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:42:09 -0300
Subject: [PATCH] fix: Validate page and id params without silent int casts

Invalid page (non digits, 0, leading zero, overflow) redirects to the first
page with a flash; a page after the last redirects to the last one using
the new Paginator::isOutOfRange(). Ids like 'abc' or '1abc' are not found
instead of being cast to 0 or 1.
---
 app/Controllers/Admin/EventsController.php    |  36 ++++++-
 lib/Paginator.php                             |  13 ++-
 .../admin/events/PaginateEventsCest.php       |  17 +++
 tests/Integration/Access/EventsAccessTest.php |  17 +++
 .../Admin/EventsControllerTest.php            | 101 ++++++++++++++++++
 tests/Unit/Lib/PaginatorTest.php              |  58 ++++++++++
 6 files changed, 239 insertions(+), 3 deletions(-)
 create mode 100644 tests/Unit/Lib/PaginatorTest.php

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..08ccf71 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -15,11 +15,23 @@ class EventsController extends Controller
 
     public function index(Request $request): void
     {
+        $page = $request->getParam('page') === null ? 1 : $this->positiveInt($request->getParam('page'));
+        if ($page === null) {
+            FlashMessage::danger('Página inválida!');
+            $this->redirectTo(route('admin.events.index'));
+            return;
+        }
+
         $paginator = Event::paginate(
-            page: max(1, (int) $request->getParam('page', 1)),
+            page: $page,
             per_page: self::PER_PAGE,
             route: 'admin.events.paginate'
         );
+        if ($paginator->isOutOfRange()) {
+            FlashMessage::danger('Página inexistente! Mostrando a última página.');
+            $this->redirectTo(route('admin.events.paginate', ['page' => max(1, $paginator->totalOfPages())]));
+            return;
+        }
         $events = $paginator->registers();
 
         $title = 'Eventos';
@@ -131,7 +143,27 @@ class EventsController extends Controller
 
     private function findEvent(Request $request): ?Event
     {
-        return Event::findById((int) $request->getParam('id'));
+        // Sem (int) silencioso: "abc" viraria 0 e "1abc" viraria 1 (outro Evento!).
+        $id = $this->positiveInt($request->getParam('id'));
+
+        return $id === null ? null : Event::findById($id);
+    }
+
+    /**
+     * Inteiro >= 1 vindo da URL, ou null. Aceita só dígitos (ctype_digit), sem zero à esquerda e sem
+     * estourar PHP_INT_MAX; o int é aceito porque os testes de controller passam `['page' => 2]`.
+     */
+    private function positiveInt(mixed $value): ?int
+    {
+        if (is_int($value)) {
+            return $value >= 1 ? $value : null;
+        }
+
+        if (!is_string($value) || !ctype_digit($value) || $value !== (string) (int) $value) {
+            return null;
+        }
+
+        return (int) $value >= 1 ? (int) $value : null;
     }
 
     private function eventNotFound(): void
diff --git a/lib/Paginator.php b/lib/Paginator.php
