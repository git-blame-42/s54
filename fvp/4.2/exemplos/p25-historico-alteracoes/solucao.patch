+-- Histórico de alterações do Evento: uma linha por campo que mudou em cada edição.
+-- ON DELETE CASCADE em event_id: removido o Evento, o histórico dele vai junto.
+-- user_id é quem editou (vem da sessão); o usuário com histórico não pode ser removido.
+CREATE TABLE event_changes (
+    id         INT AUTO_INCREMENT PRIMARY KEY,
+    event_id   INT NOT NULL,
+    user_id    INT NOT NULL,
+    field      VARCHAR(64) NOT NULL,
+    old_value  TEXT NULL,
+    new_value  TEXT NULL,
+    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    CONSTRAINT fk_event_changes_event FOREIGN KEY (event_id) REFERENCES events (id)
+        ON DELETE CASCADE ON UPDATE CASCADE,
+    CONSTRAINT fk_event_changes_user FOREIGN KEY (user_id) REFERENCES users (id)
+        ON DELETE RESTRICT ON UPDATE CASCADE,
+    INDEX index_event_changes_on_event_id_and_created_at (event_id, created_at)
+);
+
 SET foreign_key_checks = 1;
