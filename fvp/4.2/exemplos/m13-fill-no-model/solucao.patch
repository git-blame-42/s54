From 830d921938c9f41779e64939659aa0b2e13c1f55 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 17:05:18 -0300
Subject: [PATCH] refactor: Move event form filling to the model

Event::FORM_FIELDS and Event::fillFromForm() replace the controller's FIELDS and fill(); create and update now call $event->fillFromForm($this->eventParams($request)).
---
 app/Controllers/Admin/EventsController.php    | 23 ++----
 app/Models/Event.php                          | 25 +++++++
 .../Admin/EventsControllerTest.php            | 25 +++++++
 tests/Unit/Models/Events/EventTest.php        | 74 +++++++++++++++++++
 4 files changed, 131 insertions(+), 16 deletions(-)

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..da97437 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -11,8 +11,6 @@ class EventsController extends Controller
 {
     private const PER_PAGE = 5;
 
-    private const FIELDS = ['title', 'description', 'kind', 'modality', 'starts_on', 'location', 'capacity'];
-
     public function index(Request $request): void
     {
         $paginator = Event::paginate(
@@ -49,7 +47,7 @@ class EventsController extends Controller
     public function create(Request $request): void
     {
         $event = new Event();
-        $this->fill($event, $request);
+        $event->fillFromForm($this->eventParams($request));
         $event->user_id = $this->currentUser()?->id;
 
         if ($event->save()) {
@@ -81,7 +79,7 @@ class EventsController extends Controller
             $this->eventNotFound();
             return;
         }
-        $this->fill($event, $request);
+        $event->fillFromForm($this->eventParams($request));
 
         if ($event->save()) {
             FlashMessage::success('Evento atualizado com sucesso!');
@@ -111,22 +109,15 @@ class EventsController extends Controller
     }
 
     /**
-     * Copia para o Evento só os campos do formulário (nunca user_id nem id).
+     * Parâmetros `event[...]` do formulário; qualquer coisa que não seja array vira [].
+     *
+     * @return array<string, mixed>
      */
-    private function fill(Event $event, Request $request): void
+    private function eventParams(Request $request): array
     {
         $params = $request->getParam('event', []);
-        if (!is_array($params)) {
-            $params = [];
-        }
-
-        foreach (self::FIELDS as $field) {
-            $value = $params[$field] ?? null;
-            $event->$field = is_scalar($value) ? (string) $value : null;
-        }
 
-        $audience = $params['audience'] ?? [];
-        $event->setAudienceList(is_array($audience) ? array_filter($audience, 'is_scalar') : []);
+        return is_array($params) ? $params : [];
     }
 
     private function findEvent(Request $request): ?Event
diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..e475108 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -44,6 +44,9 @@ class Event extends Model
         'community' => 'Comunidade externa',
     ];
 
+    /** Campos que o formulário pode preencher (fillFromForm). Nunca id nem user_id. */
+    public const FORM_FIELDS = ['title', 'description', 'kind', 'modality', 'starts_on', 'location', 'capacity'];
+
     protected static string $table = 'events';
     protected static array $columns = [
         'user_id',
@@ -114,6 +117,28 @@ class Event extends Model
         }
     }
 
+    /**
+     * Copia os dados do formulário para o Evento: só as chaves de FORM_FIELDS (user_id, id e
+     * qualquer outra são ignoradas). Campo ausente ou não escalar vira null, para a validação
+     * acusar. `audience` aceita array (checkboxes `audience[]`) ou string "a,b".
+     *
+     * @param array<string, mixed> $params
+     */
+    public function fillFromForm(array $params): void
+    {
+        foreach (self::FORM_FIELDS as $field) {
+            $value = $params[$field] ?? null;
+            $this->$field = is_scalar($value) ? (string) $value : null;
+        }
+
+        $audience = $params['audience'] ?? [];
+        if (is_string($audience)) {
+            $audience = explode(',', $audience);
+        }
+
+        $this->setAudienceList(is_array($audience) ? array_filter($audience, 'is_scalar') : []);
+    }
+
     public function user(): BelongsTo
     {
         return $this->belongsTo(User::class, 'user_id');
