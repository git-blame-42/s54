diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..d9abb95 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -385,6 +385,80 @@ class EventTest extends TestCase
         $this->assertFalse(Event::exists(['title' => 'Outro']));
     }
 
+    /* ------------------- fillFromForm ------------------- */
+
+    /**
+     * @param array<string, mixed> $overrides
+     * @return array<string, mixed>
+     */
+    private function formParams(array $overrides = []): array
+    {
+        return array_merge([
+            'title' => 'Oficina de Testes',
+            'description' => 'Aprenda a testar.',
+            'kind' => 'workshop',
+            'modality' => 'online',
+            'audience' => ['students', 'staff'],
+            'starts_on' => date('Y-m-d', strtotime('+10 days')),
+            'location' => 'Bloco A',
+            'capacity' => '20',
+        ], $overrides);
+    }
+
+    public function test_fill_from_form_should_copy_the_allowed_fields(): void
+    {
+        $event = new Event(['user_id' => $this->admin->id]);
+        $event->fillFromForm($this->formParams());
+
+        foreach (Event::FORM_FIELDS as $field) {
+            $this->assertSame((string) $this->formParams()[$field], $event->$field, $field);
+        }
+        $this->assertSame('students,staff', $event->audience);
+        $this->assertTrue($event->save());
+    }
+
+    public function test_fill_from_form_should_ignore_user_id_id_and_unknown_keys(): void
+    {
+        $event = new Event(['user_id' => $this->admin->id]);
+        $event->fillFromForm($this->formParams(['user_id' => '999', 'id' => '42', 'created_at' => '2000-01-01']));
+
+        $this->assertEquals($this->admin->id, $event->user_id);
+        $this->assertTrue($event->newRecord());
+        $this->assertTrue($event->save());
+        $this->assertNotEquals(42, $event->id);
+    }
+
+    public function test_fill_from_form_should_turn_missing_or_non_scalar_values_into_null(): void
+    {
+        $params = $this->formParams(['title' => ['array'], 'location' => null]);
+        unset($params['capacity']);
+
+        $event = new Event();
+        $event->fillFromForm($params);
+
+        $this->assertFalse($event->isValid());
+        foreach (['title', 'location', 'capacity'] as $field) {
+            $this->assertEquals('não pode ser vazio!', $event->errors($field), $field);
+        }
+        $this->assertNull($event->errors('description'));
+    }
+
+    public function test_fill_from_form_should_accept_audience_as_array_or_string(): void
+    {
+        $event = new Event();
+
+        $event->fillFromForm($this->formParams(['audience' => ['students', '', 'students', ['x'], 'community']]));
+        $this->assertSame(['students', 'community'], $event->audienceList());
+
+        $event->fillFromForm($this->formParams(['audience' => 'professors,staff']));
+        $this->assertSame(['professors', 'staff'], $event->audienceList());
+
+        $params = $this->formParams();
+        unset($params['audience']);
+        $event->fillFromForm($params);
+        $this->assertSame([], $event->audienceList());
+    }
+
     /* ------------------- paginate ------------------- */
 
     public function test_paginate_should_return_five_events_per_page(): void
