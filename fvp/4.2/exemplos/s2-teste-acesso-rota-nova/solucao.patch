diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..dacc109 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -139,6 +139,19 @@ class Event extends Model
         return max(0, (int) $this->capacity - $this->enrollmentsCount());
     }
 
+    /**
+     * Eventos lotados (sem vagas disponíveis), na ordem do banco.
+     *
+     * @return array<static>
+     */
+    public static function full(): array
+    {
+        return array_values(array_filter(
+            static::all(),
+            fn(Event $event) => $event->availableSpots() === 0
+        ));
+    }
+
     public function hasEnrollments(): bool
     {
         return $this->enrollmentsCount() > 0;
