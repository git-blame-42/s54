+++ b/app/Controllers/Admin/EventsController.php
@@ -26,6 +26,14 @@ class EventsController extends Controller
         $this->render('admin/events/index', compact('events', 'paginator', 'title'));
     }
 
+    public function full(): void
+    {
+        $events = Event::full();
+
+        $title = 'Eventos lotados';
+        $this->render('admin/events/full', compact('events', 'title'));
