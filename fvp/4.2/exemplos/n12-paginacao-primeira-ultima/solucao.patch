         // Última página: só o Evento 16.
         $page->click('4', '.pagination');
@@ -41,6 +47,23 @@ class PaginateEventsCest extends BaseEventsCest
         $this->seeEventsOfPage($page, 3);
     }
 
+    public function jumpToLastAndFirstPages(AcceptanceTester $page): void
+    {
+        $page->wantTo('Paginação dos registros (Primeira e Última)');
+        $page->amOnPage('/admin/events');
+
+        $page->click('Última', '.pagination');
+        $page->seeCurrentUrlEquals('/admin/events/page/4');
+        $this->seeEventsOfPage($page, 4);
+        $page->seeNumberOfElements('.pagination .page-item.disabled', 2);
+        $page->see('2', '.pagination');
+        $page->see('3', '.pagination');
+
+        $page->click('Primeira', '.pagination');
+        $page->seeCurrentUrlEquals('/admin/events/page/1');
+        $this->seeEventsOfPage($page, 1);
+    }
+
     public function openPageTwoAndThreeDirectly(AcceptanceTester $page): void
     {
         $page->wantTo('Paginação dos registros (acesso direto às páginas 2 e 3)');
diff --git a/tests/Integration/Controllers/Admin/EventsControllerTest.php b/tests/Integration/Controllers/Admin/EventsControllerTest.php
index bc62d1d..9be0a2b 100644
--- a/tests/Integration/Controllers/Admin/EventsControllerTest.php
+++ b/tests/Integration/Controllers/Admin/EventsControllerTest.php
@@ -67,6 +67,30 @@ class EventsControllerTest extends ControllerTestCase
         $this->assertStringContainsString('1/10', $response);
     }
 
+    public function test_index_shows_first_and_last_links_and_a_window_of_three_pages(): void
+    {
+        // 21 Eventos, 5 por página = 5 páginas; na página 2 a janela é 1, 2, 3.
+        for ($i = 1; $i <= 21; $i++) {
+            $this->createEvent(['title' => "Evento {$i}"]);
+        }
+
+        $page2 = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['page' => 2]);
+
+        $this->assertStringContainsString('<a class="page-link" href="/admin/events/page/1">Primeira</a>', $page2);
+        $this->assertStringContainsString('<a class="page-link" href="/admin/events/page/1">Anterior</a>', $page2);
+        $this->assertStringContainsString('<a class="page-link" href="/admin/events/page/3">Próxima</a>', $page2);
+        $this->assertStringContainsString('<a class="page-link" href="/admin/events/page/5">Última</a>', $page2);
+        $this->assertStringContainsString('href="/admin/events/page/3">3</a>', $page2);
+        $this->assertStringNotContainsString('>4</a>', $page2);
+        $this->assertMatchesRegularExpression(
+            '/page-item active">\s*<a class="page-link" href="\/admin\/events\/page\/2">2</',
+            $page2
+        );
+
+        $page1 = $this->get(action: 'index', controllerName: self::CONTROLLER, params: ['page' => 1]);
+        $this->assertMatchesRegularExpression('/page-item disabled">\s*<a class="page-link">Primeira<\/a>/', $page1);
+    }
+
     public function test_new_renders_form(): void
     {
         $response = $this->get(action: 'new', controllerName: self::CONTROLLER);
diff --git a/tests/Unit/Lib/PaginatorTest.php b/tests/Unit/Lib/PaginatorTest.php
new file mode 100644
index 0000000..a070827
--- /dev/null
+++ b/tests/Unit/Lib/PaginatorTest.php
@@ -0,0 +1,125 @@
+<?php
+
+namespace Tests\Unit\Lib;
+
+use App\Models\Event;
+use App\Models\User;
+use Lib\Paginator;
+use PHPUnit\Framework\Attributes\DataProvider;
+use Tests\TestCase;
+
+/**
+ * Paginator: firstPage(), lastPage() e pagesWindow() (janela de números em volta da página atual).
+ */
+class PaginatorTest extends TestCase
+{
+    private function createEvents(int $total): void
+    {
+        $admin = new User([
+            'name' => 'Administrador',
+            'email' => 'admin@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456',
+            'role' => 'admin',
+        ]);
+        $admin->save();
+
+        for ($i = 1; $i <= $total; $i++) {
+            $event = new Event([
+                'user_id' => $admin->id,
+                'title' => "Evento {$i}",
+                'description' => 'Descrição.',
+                'kind' => 'lecture',
+                'modality' => 'online',
+                'audience' => 'students',
+                'starts_on' => date('Y-m-d', strtotime('+10 days')),
+                'location' => 'Online',
+                'capacity' => 10,
+            ]);
+            $this->assertTrue($event->save());
+        }
+    }
+
+    private function paginator(int $page, int $perPage): Paginator
+    {
+        return Event::paginate(page: $page, per_page: $perPage, route: 'admin.events.paginate');
+    }
+
+    /**
+     * 7 Eventos, 1 por página = 7 páginas. Página 0 não entra: o Paginator calcula OFFSET negativo e o
+     * MySQL recusa; o controller já usa max(1, page).
+     *
+     * @return array<string, array{int, array<int>}>
+     */
+    public static function windowProvider(): array
+    {
+        return [
+            'início (página 1)' => [1, [1, 2, 3]],
+            'segunda página' => [2, [1, 2, 3]],
+            'meio (página 4)' => [4, [3, 4, 5]],
+            'penúltima' => [6, [5, 6, 7]],
+            'fim (página 7)' => [7, [5, 6, 7]],
+            'página 99 (fora, depois)' => [99, [5, 6, 7]],
+        ];
+    }
+
+    /**
+     * @param array<int> $expected
+     */
+    #[DataProvider('windowProvider')]
+    public function test_pages_window_should_be_centered_and_respect_the_limits(int $page, array $expected): void
+    {
+        $this->createEvents(7);
+
+        $this->assertSame($expected, $this->paginator($page, 1)->pagesWindow());
+    }
+
+    public function test_first_and_last_page(): void
+    {
+        $this->createEvents(16);
+
+        $paginator = $this->paginator(2, 5);
+
+        $this->assertSame(1, $paginator->firstPage());
+        $this->assertSame(4, $paginator->lastPage());
+        $this->assertSame([1, 2, 3], $paginator->pagesWindow());
+        $this->assertSame([2, 3, 4], $this->paginator(4, 5)->pagesWindow());
+    }
+
+    public function test_single_page_should_have_a_window_with_only_page_one(): void
+    {
+        $this->createEvents(3);
+
+        $paginator = $this->paginator(1, 5);
+
+        $this->assertSame(1, $paginator->lastPage());
+        $this->assertSame([1], $paginator->pagesWindow());
+    }
+
+    public function test_without_records_last_page_should_be_one(): void
+    {
+        $paginator = $this->paginator(1, 5);
+
+        $this->assertSame(0, $paginator->totalOfPages());
+        $this->assertSame(1, $paginator->lastPage());
+        $this->assertSame([1], $paginator->pagesWindow());
+    }
+
+    public function test_window_should_not_be_larger_than_the_number_of_pages(): void
+    {
+        $this->createEvents(2);
+
+        $this->assertSame([1, 2], $this->paginator(1, 1)->pagesWindow());
+        $this->assertSame([1, 2], $this->paginator(2, 1)->pagesWindow(5));
+    }
+
+    public function test_window_size_can_be_changed(): void
+    {
+        $this->createEvents(7);
+
+        $this->assertSame([2, 3, 4, 5, 6], $this->paginator(4, 1)->pagesWindow(5));
+        $this->assertSame([3, 4, 5, 6], $this->paginator(4, 1)->pagesWindow(4));
+        $this->assertSame([4], $this->paginator(4, 1)->pagesWindow(1));
+        $this->assertSame([4], $this->paginator(4, 1)->pagesWindow(0));
+    }
+}
