From 29f6bcd2e14683963afbb2bf3e02ba51a7e90fc5 Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:56:31 -0300
Subject: [PATCH] feat: Add first/last links and a three-page window to
 pagination
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Paginator gets firstPage(), lastPage() and pagesWindow(), a window of page numbers centered on the current page and kept inside the limits. _pages.phtml shows Primeira, Anterior, the window, Próxima and Última, building the URLs with a $pageUrl closure.
---
 app/views/paginator/_pages.phtml              |  28 +++-
 lib/Paginator.php                             |  33 +++++
 .../admin/events/PaginateEventsCest.php       |  25 +++-
 .../Admin/EventsControllerTest.php            |  24 ++++
 tests/Unit/Lib/PaginatorTest.php              | 125 ++++++++++++++++++
 5 files changed, 228 insertions(+), 7 deletions(-)
 create mode 100644 tests/Unit/Lib/PaginatorTest.php

diff --git a/app/views/paginator/_pages.phtml b/app/views/paginator/_pages.phtml
index 2ace0d2..10b53e4 100644
--- a/app/views/paginator/_pages.phtml
+++ b/app/views/paginator/_pages.phtml
@@ -1,32 +1,48 @@
+<?php
+/** @var \Lib\Paginator $paginator */
+$pageUrl = fn(int $page): string => route($paginator->getRouteName(), ['page' => $page]);
+?>
 <nav aria-label="Page navigation">
     <ul class="pagination justify-content-end">
 
         <?php if ($paginator->hasPreviousPage()) : ?>
             <li class="page-item">
-                <a class="page-link" href="<?= route($paginator->getRouteName(), ['page' => $paginator->previousPage()]) ?>">Anterior</a>
+                <a class="page-link" href="<?= $pageUrl($paginator->firstPage()) ?>">Primeira</a>
+            </li>
+            <li class="page-item">
+                <a class="page-link" href="<?= $pageUrl($paginator->previousPage()) ?>">Anterior</a>
             </li>
         <?php else : ?>
+            <li class="page-item disabled">
+                <a class="page-link">Primeira</a>
+            </li>
             <li class="page-item disabled">
                 <a class="page-link">Anterior</a>
             </li>
         <?php endif; ?>
 
-        <?php for ($page = 1; $page <= $paginator->totalOfPages(); $page++) : ?>
+        <?php foreach ($paginator->pagesWindow() as $page) : ?>
             <li class="page-item <?= $paginator->isPage($page) ? 'active' : '' ?>">
-                <a class="page-link" href="<?= route($paginator->getRouteName(), ['page' => $page]) ?>"><?= $page ?></a>
+                <a class="page-link" href="<?= $pageUrl($page) ?>"><?= $page ?></a>
             </li>
-        <?php endfor; ?>
+        <?php endforeach; ?>
 
         <?php if ($paginator->hasNextPage()) : ?>
             <li class="page-item">
-                <a class="page-link" href="<?= route($paginator->getRouteName(), ['page' => $paginator->nextPage()]) ?>">Próxima</a>
+                <a class="page-link" href="<?= $pageUrl($paginator->nextPage()) ?>">Próxima</a>
+            </li>
+            <li class="page-item">
+                <a class="page-link" href="<?= $pageUrl($paginator->lastPage()) ?>">Última</a>
             </li>
         <?php else : ?>
             <li class="page-item disabled">
                 <a class="page-link">Próxima</a>
             </li>
+            <li class="page-item disabled">
+                <a class="page-link">Última</a>
+            </li>
         <?php endif; ?>
     </ul>
 </nav>
 
-<div class="d-flex justify-content-end"><?= $paginator->entriesInfo() ?></div>
\ No newline at end of file
+<div class="d-flex justify-content-end"><?= $paginator->entriesInfo() ?></div>
diff --git a/lib/Paginator.php b/lib/Paginator.php
index 065ee46..1bc464e 100644
--- a/lib/Paginator.php
+++ b/lib/Paginator.php
@@ -73,6 +73,39 @@ class Paginator
         return $this->nextPage() <= $this->totalOfPages();
     }
 
+    public function firstPage(): int
+    {
+        return 1;
+    }
+
+    /**
+     * Última página; nunca menor que 1 (sem registros, a única página é a 1).
+     */
+    public function lastPage(): int
+    {
+        return max(1, $this->totalOfPages);
+    }
+
+    /**
+     * Números de página exibidos na navegação: no máximo $size páginas, centradas na atual e
+     * deslocadas para caber entre a primeira e a última (ex.: 4 páginas, atual 1 => [1, 2, 3];
+     * atual 3 => [2, 3, 4]; atual 4 => [2, 3, 4]). Página fora do intervalo usa o limite mais próximo.
+     *
+     * @return array<int>
+     */
+    public function pagesWindow(int $size = 3): array
+    {
+        $size = max(1, $size);
+        $last = $this->lastPage();
+        $current = min(max($this->page, $this->firstPage()), $last);
+
+        $start = $current - intdiv($size - 1, 2);
+        $start = max($this->firstPage(), min($start, $last - $size + 1));
+        $end = min($last, $start + $size - 1);
+
+        return range($start, $end);
+    }
+
     public function isPage(int $page): bool
     {
         return $this->page === $page;
diff --git a/tests/Acceptance/admin/events/PaginateEventsCest.php b/tests/Acceptance/admin/events/PaginateEventsCest.php
