From 75e9e86bfb1a7a9036cf62e7b238def0c24693ee Mon Sep 17 00:00:00 2001
From: blame42 <346530647+git-blame-42@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:04:28 -0300
Subject: [PATCH] feat: Show event title in flash messages and add warning type

Event flash messages carry the raw title and the flash partial escapes it once with htmlspecialchars. FlashMessage gains warning(), used when removal is blocked by enrollments.
---
 app/Controllers/Admin/EventsController.php    | 11 +++--
 app/views/layouts/_flash_message.phtml        |  2 +-
 lib/FlashMessage.php                          |  5 +++
 .../admin/events/CreateSuccessfullyCest.php   |  2 +-
 .../admin/events/DeleteEventCest.php          | 29 ++++++++++--
 .../admin/events/UpdateSuccessfullyCest.php   |  6 +--
 .../Admin/EventsControllerTest.php            | 45 ++++++++++++++++---
 tests/Unit/Lib/FlashMessageTest.php           |  9 ++++
 8 files changed, 92 insertions(+), 17 deletions(-)

diff --git a/app/Controllers/Admin/EventsController.php b/app/Controllers/Admin/EventsController.php
index ca4ada1..68feb44 100644
--- a/app/Controllers/Admin/EventsController.php
+++ b/app/Controllers/Admin/EventsController.php
@@ -53,7 +53,8 @@ class EventsController extends Controller
         $event->user_id = $this->currentUser()?->id;
 
         if ($event->save()) {
-            FlashMessage::success('Evento cadastrado com sucesso!');
+            // Título cru: o escape é feito uma vez só, no partial _flash_message.phtml.
+            FlashMessage::success("Evento \"{$event->title}\" cadastrado com sucesso!");
             $this->redirectTo(route('admin.events.show', ['id' => $event->id]));
         } else {
             FlashMessage::danger('Existem dados incorretos! Por favor, verifique!');
@@ -84,7 +85,7 @@ class EventsController extends Controller
         $this->fill($event, $request);
 
         if ($event->save()) {
-            FlashMessage::success('Evento atualizado com sucesso!');
+            FlashMessage::success("Evento \"{$event->title}\" atualizado com sucesso!");
             $this->redirectTo(route('admin.events.show', ['id' => $event->id]));
         } else {
             FlashMessage::danger('Existem dados incorretos! Por favor, verifique!');
@@ -102,9 +103,11 @@ class EventsController extends Controller
         }
 
         if ($event->safeDestroy()) {
-            FlashMessage::success('Evento removido com sucesso!');
+            FlashMessage::success("Evento \"{$event->title}\" removido com sucesso!");
         } else {
-            FlashMessage::danger($event->errors('base') ?? 'Não foi possível remover o evento!');
+            // Remoção barrada por regra de negócio (Inscrições): aviso, não erro do sistema.
+            $reason = $event->errors('base') ?? 'não foi possível remover o evento!';
+            FlashMessage::warning("Evento \"{$event->title}\" não removido: {$reason}");
         }
 
         $this->redirectTo(route('admin.events.index'));
diff --git a/app/views/layouts/_flash_message.phtml b/app/views/layouts/_flash_message.phtml
index 5e38c31..1c56680 100644
--- a/app/views/layouts/_flash_message.phtml
+++ b/app/views/layouts/_flash_message.phtml
@@ -1,6 +1,6 @@
 <?php foreach (\Lib\FlashMessage::get() as $type => $msg) : ?>
     <div class="alert alert-<?= $type ?> alert-dismissible" role="alert">
-        <div><?= $msg ?></div>
+        <div><?= htmlspecialchars($msg) ?></div>
         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
     </div>
 <? endforeach; ?>
diff --git a/lib/FlashMessage.php b/lib/FlashMessage.php
index 081732f..30b9a6f 100644
--- a/lib/FlashMessage.php
+++ b/lib/FlashMessage.php
@@ -14,6 +14,11 @@ class FlashMessage
         self::message('danger', $value);
     }
 
+    public static function warning(string $value): void
+    {
+        self::message('warning', $value);
+    }
+
     public static function get(): array
     {
         $flash = $_SESSION['flash'] ?? [];
