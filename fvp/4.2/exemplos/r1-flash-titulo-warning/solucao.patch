+    public function test_flash_with_event_title_is_escaped_once_in_the_layout(): void
+    {
+        $event = $this->createEvent(['title' => 'A & "B" <script>alert(1)</script>']);
+        $this->delete(action: 'destroy', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        // O flash guarda o título cru; o partial escapa na próxima página.
+        $this->assertEquals(
+            'Evento "A & "B" <script>alert(1)</script>" removido com sucesso!',
+            $_SESSION['flash']['success']
+        );
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString(
+            'Evento &quot;A &amp; &quot;B&quot; &lt;script&gt;alert(1)&lt;/script&gt;&quot; removido com sucesso!',
+            $response
+        );
+        $this->assertStringNotContainsString('<script>alert(1)</script>', $response);
+        $this->assertStringNotContainsString('&amp;amp;', $response);
+        $this->assertStringContainsString('alert alert-success', $response);
+    }
+
+    public function test_warning_flash_uses_the_warning_alert_class(): void
+    {
+        $event = $this->createEvent();
+        $this->enroll($event);
+        $this->delete(action: 'destroy', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $response = $this->get(action: 'index', controllerName: self::CONTROLLER);
+
+        $this->assertStringContainsString('alert alert-warning', $response);
+        $this->assertStringContainsString('não é possível remover um evento com inscrições (1)!', $response);
     }
 
