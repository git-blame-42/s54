diff --git a/tests/Acceptance/admin/events/UpdateEventWithEnrollmentsCest.php b/tests/Acceptance/admin/events/UpdateEventWithEnrollmentsCest.php
new file mode 100644
index 0000000..f2df95b
--- /dev/null
+++ b/tests/Acceptance/admin/events/UpdateEventWithEnrollmentsCest.php
@@ -0,0 +1,50 @@
+<?php
+
+namespace Tests\Acceptance\admin\events;
+
+use App\Models\Event;
+use PHPUnit\Framework\Assert;
+use Tests\Support\AcceptanceTester;
+
+/**
+ * Evento 01 da base tem 3 Inscrições (3/3): a data e o tipo não podem mudar.
+ */
+class UpdateEventWithEnrollmentsCest extends BaseEventsCest
+{
+    public function startsOnIsLockedAndRejectedWithEnrollments(AcceptanceTester $page): void
+    {
+        $event = $this->events[1];
+
+        $page->wantTo('Tentar mudar a data de um Evento que já tem inscritos');
+        $page->amOnPage("/admin/events/{$event->id}/edit");
+        $page->see('A data não pode mudar: o Evento já tem 3 inscrito(s).');
+        $page->seeElement('#event_starts_on[readonly]');
+        $page->seeElement('#event_kind[disabled]');
+        $page->see('O tipo não pode mudar: o Evento já tem inscritos.');
+
+        // O readonly é só aviso: forçar o valor pelo navegador não passa pelo model.
+        $this->fillEventForm($page, ['starts_on' => date('Y-m-d', strtotime('+90 days'))]);
+        $page->click('Salvar');
+
+        $page->see('Existem dados incorretos! Por favor, verifique!');
+        $page->seeElement('#event_starts_on.is-invalid');
+        $page->see('não pode mudar: já há inscritos!', '#event_starts_on ~ .invalid-feedback');
+        Assert::assertSame($event->starts_on, Event::findById($event->id)->starts_on);
+    }
+
+    public function eventWithEnrollmentsCanBeEditedKeepingTheDate(AcceptanceTester $page): void
+    {
+        $event = $this->events[1];
+
+        $page->wantTo('Editar o título de um Evento com inscritos, sem mudar a data');
+        $page->amOnPage("/admin/events/{$event->id}/edit");
+        $page->fillField('#event_title', 'Evento 01 Revisado');
+        $page->click('Salvar');
+
+        $page->see('Evento atualizado com sucesso!');
+        $stored = Event::findById($event->id);
+        Assert::assertSame('Evento 01 Revisado', $stored->title);
+        // O tipo foi enviado pelo campo oculto e continua o mesmo.
+        Assert::assertSame($event->kind, $stored->kind);
+    }
+}
diff --git a/tests/Integration/Controllers/Admin/EventsControllerTest.php b/tests/Integration/Controllers/Admin/EventsControllerTest.php
index bc62d1d..aef8e25 100644
--- a/tests/Integration/Controllers/Admin/EventsControllerTest.php
+++ b/tests/Integration/Controllers/Admin/EventsControllerTest.php
@@ -239,6 +239,70 @@ class EventsControllerTest extends ControllerTestCase
         $this->assertStringContainsString('não pode ser menor que o total de inscrições (2)!', $response);
     }
 
+    public function test_update_starts_on_of_event_with_enrollments_is_rejected(): void
+    {
+        $event = $this->createEvent(['title' => 'Com Inscritos']);
+        $original = $event->starts_on;
+        $this->enroll($event);
+
+        $response = $this->put(
+            action: 'update',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $event->id, 'event' => $this->validParams([
+                'title' => 'Título Novo',
+                'starts_on' => date('Y-m-d', strtotime('+40 days')),
+            ])]
+        );
+
+        $stored = Event::findById($event->id);
+        $this->assertEquals($original, $stored->starts_on);
+        $this->assertEquals('Com Inscritos', $stored->title);
+        $this->assertMatchesRegularExpression('/<h1>\s*Editar Evento\s*<\/h1>/', $response);
+        $this->assertStringContainsString('não pode mudar: já há inscritos!', $response);
+        $this->assertStringContainsString('Existem dados incorretos! Por favor, verifique!', $response);
+    }
+
+    public function test_update_kind_of_event_with_enrollments_is_rejected(): void
+    {
+        $event = $this->createEvent(['kind' => 'workshop']);
+        $this->enroll($event);
+
+        $response = $this->put(
+            action: 'update',
+            controllerName: self::CONTROLLER,
+            params: ['id' => $event->id, 'event' => $this->validParams(['kind' => 'lecture'])]
+        );
+
+        $this->assertEquals('workshop', Event::findById($event->id)->kind);
+        $this->assertStringContainsString('não pode mudar: já há inscritos!', $response);
+    }
+
+    public function test_edit_shows_starts_on_locked_when_event_has_enrollments(): void
+    {
+        $event = $this->createEvent();
+        $this->enroll($event);
+
+        $response = $this->get(action: 'edit', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertMatchesRegularExpression('/id="event_starts_on"[^>]*readonly/', $response);
+        $this->assertStringContainsString('A data não pode mudar: o Evento já tem 1 inscrito(s).', $response);
+        $this->assertStringContainsString('min="1"', $response);
+        $this->assertMatchesRegularExpression('/id="event_kind"[^>]*disabled/', $response);
+        $this->assertStringContainsString('<input type="hidden" name="event[kind]" value="workshop">', $response);
+    }
+
+    public function test_edit_does_not_lock_starts_on_without_enrollments(): void
+    {
+        $event = $this->createEvent();
+
+        $response = $this->get(action: 'edit', controllerName: self::CONTROLLER, params: ['id' => $event->id]);
+
+        $this->assertDoesNotMatchRegularExpression('/id="event_starts_on"[^>]*readonly/', $response);
+        $this->assertStringNotContainsString('event_starts_on_locked', $response);
+        $this->assertDoesNotMatchRegularExpression('/id="event_kind"[^>]*disabled/', $response);
+        $this->assertStringNotContainsString('type="hidden" name="event[kind]"', $response);
+    }
+
     public function test_destroy_removes_event_without_enrollments(): void
     {
         $event = $this->createEvent();
diff --git a/tests/Unit/Models/Events/EventTest.php b/tests/Unit/Models/Events/EventTest.php
index f961b4c..1a19fe7 100644
--- a/tests/Unit/Models/Events/EventTest.php
+++ b/tests/Unit/Models/Events/EventTest.php
@@ -629,6 +629,104 @@ class EventTest extends TestCase
         $this->assertTrue($event->save());
     }
 
+    /* ------------------- M10: starts_on e kind imutáveis com Inscrições ------------------- */
+
+    public function test_kind_cannot_change_when_the_event_has_enrollments(): void
+    {
+        $event = $this->createEvent(['kind' => 'lecture']);
+        $this->enroll($event, 1);
+
+        $event->kind = 'workshop';
+
+        $this->assertFalse($event->save());
+        $this->assertEquals('não pode mudar: já há inscritos!', $event->errors('kind'));
+        $this->assertCount(1, $this->errorsOf($event));
+        $this->assertEquals('lecture', Event::findById($event->id)->kind);
+    }
+
+    public function test_kind_can_change_when_the_event_has_no_enrollments(): void
+    {
+        $event = $this->createEvent(['kind' => 'lecture']);
+
+        $event->kind = 'workshop';
+
+        $this->assertTrue($event->save());
+        $this->assertEquals('workshop', Event::findById($event->id)->kind);
+    }
+
+    public function test_kind_outside_enum_on_event_with_enrollments_keeps_the_enum_message(): void
+    {
+        $event = $this->createEvent();
+        $this->enroll($event, 1);
+
+        $event->kind = 'concert';
+
+        $this->assertFalse($event->isValid());
+        $this->assertEquals('não é uma opção válida!', $event->errors('kind'));
+    }
+
+
+    public function test_starts_on_cannot_change_when_the_event_has_enrollments(): void
+    {
+        $event = $this->createEvent();
+        $original = $event->starts_on;
+        $this->enroll($event, 2);
+
+        $event->starts_on = date('Y-m-d', strtotime('+40 days'));
+
+        $this->assertFalse($event->save());
+        $this->assertEquals('não pode mudar: já há inscritos!', $event->errors('starts_on'));
+        $this->assertCount(1, $this->errorsOf($event));
+        $this->assertEquals($original, Event::findById($event->id)->starts_on);
+    }
+
+    public function test_starts_on_can_change_when_the_event_has_no_enrollments(): void
+    {
+        $event = $this->createEvent();
+        $future = date('Y-m-d', strtotime('+40 days'));
+
+        $event->starts_on = $future;
+
+        $this->assertTrue($event->save());
+        $this->assertEquals($future, Event::findById($event->id)->starts_on);
+    }
+
+    public function test_event_with_enrollments_can_be_edited_keeping_the_same_starts_on(): void
+    {
+        $event = $this->createEvent(['capacity' => 5]);
+        $this->enroll($event, 3);
+
+        $event->title = 'Título novo';
+        $event->capacity = 3;
+
+        $this->assertTrue($event->save());
+        $this->assertNull($event->errors('starts_on'));
+    }
+
+    public function test_invalid_starts_on_on_event_with_enrollments_keeps_the_date_message(): void
+    {
+        $event = $this->createEvent();
+        $this->enroll($event, 1);
+
+        $event->starts_on = '2030-02-30';
+
+        $this->assertFalse($event->isValid());
+        $this->assertEquals('não é uma data válida!', $event->errors('starts_on'));
+    }
+
+    public function test_starts_on_and_capacity_errors_together_on_event_with_enrollments(): void
+    {
+        $event = $this->createEvent(['capacity' => 5]);
+        $this->enroll($event, 3);
+
+        $event->starts_on = date('Y-m-d', strtotime('+40 days'));
+        $event->capacity = 2;
+
+        $this->assertFalse($event->save());
+        $this->assertEquals('não pode mudar: já há inscritos!', $event->errors('starts_on'));
+        $this->assertEquals('não pode ser menor que o total de inscrições (3)!', $event->errors('capacity'));
+    }
+
