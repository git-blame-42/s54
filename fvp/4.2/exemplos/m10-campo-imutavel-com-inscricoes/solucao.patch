diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..f2a2d67 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -64,7 +64,8 @@ class Event extends Model
         Validations::notEmpty('location', $this);
 
         Validations::notEmpty('kind', $this) &&
-            Validations::inclusion('kind', $this, array_keys(self::KINDS));
+            Validations::inclusion('kind', $this, array_keys(self::KINDS)) &&
+            $this->validatesUnchangedWithEnrollments('kind');
 
         Validations::notEmpty('modality', $this) &&
             Validations::inclusion('modality', $this, array_keys(self::MODALITIES));
@@ -74,6 +75,7 @@ class Event extends Model
 
         Validations::notEmpty('starts_on', $this) &&
             Validations::validDate('starts_on', $this) &&
+            $this->validatesUnchangedWithEnrollments('starts_on') &&
             $this->validatesStartsOnNotPast();
 
         if (Validations::notEmpty('capacity', $this) && Validations::integerMin('capacity', $this, 1)) {
@@ -81,6 +83,26 @@ class Event extends Model
         }
     }
 
+    /**
+     * Com Inscrições, o campo (ex.: `starts_on`, `kind`) não pode mudar: quem se inscreveu contava com ele.
+     * Compara com o valor gravado no banco; Evento novo ou sem Inscrições passa.
+     */
+    private function validatesUnchangedWithEnrollments(string $field): bool
+    {
+        if ($this->newRecord() || !$this->hasEnrollments()) {
+            return true;
+        }
+
+        $original = self::findById($this->id);
+
+        if ($original !== null && $original->$field !== $this->$field) {
+            $this->addError($field, 'não pode mudar: já há inscritos!');
+            return false;
+        }
+
+        return true;
+    }
+
     /**
      * A data não pode estar no passado ao criar. Na edição, só é cobrada quando `starts_on` muda:
      * assim um Evento que já aconteceu ainda pode ter a descrição, o local etc. corrigidos.
diff --git a/app/views/admin/events/_form.phtml b/app/views/admin/events/_form.phtml
index 2e98c21..e16a9d4 100644
--- a/app/views/admin/events/_form.phtml
+++ b/app/views/admin/events/_form.phtml
@@ -8,6 +8,8 @@
  */
 use App\Models\Event;
 
+// Inscrições já gravadas (0 no new). Só para o aviso: a regra está em Event::validates().
+$enrolled = $event->enrollmentsCount();
 $invalid = fn(string $field): string => $event->errors($field) !== null ? ' is-invalid' : '';
 $feedback = fn(string $field, string $extra = ''): string => $event->errors($field) !== null
     ? '<div class="invalid-feedback' . $extra . '">' . htmlspecialchars($event->errors($field)) . '</div>'
@@ -34,12 +36,17 @@ $feedback = fn(string $field, string $extra = ''): string => $event->errors($fie
 
     <div class="mb-3">
         <label for="event_kind" class="form-label">Tipo</label>
-        <select class="form-select<?= $invalid('kind') ?>" id="event_kind" name="event[kind]">
+        <select class="form-select<?= $invalid('kind') ?>" id="event_kind" name="event[kind]"<?= $enrolled > 0 ? ' disabled' : '' ?>>
             <option value="">Selecione</option>
             <?php foreach (Event::KINDS as $value => $label) : ?>
                 <option value="<?= $value ?>" <?= $event->kind === $value ? 'selected' : '' ?>><?= $label ?></option>
             <?php endforeach; ?>
         </select>
+        <?php if ($enrolled > 0) : ?>
+            <?php /* select não tem readonly e o disabled não é enviado: o valor vai pelo campo oculto. */ ?>
+            <input type="hidden" name="event[kind]" value="<?= htmlspecialchars((string) $event->kind) ?>">
+            <div class="form-text" id="event_kind_locked">O tipo não pode mudar: o Evento já tem inscritos.</div>
+        <?php endif; ?>
         <?= $feedback('kind') ?>
     </div>
 
@@ -70,7 +77,12 @@ $feedback = fn(string $field, string $extra = ''): string => $event->errors($fie
     <div class="mb-3">
         <label for="event_starts_on" class="form-label">Data</label>
         <input type="date" class="form-control<?= $invalid('starts_on') ?>" id="event_starts_on" name="event[starts_on]"
-            value="<?= htmlspecialchars((string) $event->starts_on) ?>">
+            value="<?= htmlspecialchars((string) $event->starts_on) ?>"<?= $enrolled > 0 ? ' readonly' : '' ?>>
+        <?php if ($enrolled > 0) : ?>
+            <div class="form-text" id="event_starts_on_locked">
+                A data não pode mudar: o Evento já tem <?= $enrolled ?> inscrito(s).
+            </div>
+        <?php endif; ?>
         <?= $feedback('starts_on') ?>
     </div>
 
@@ -84,7 +96,10 @@ $feedback = fn(string $field, string $extra = ''): string => $event->errors($fie
     <div class="mb-3">
         <label for="event_capacity" class="form-label">Vagas</label>
         <input type="number" class="form-control<?= $invalid('capacity') ?>" id="event_capacity" name="event[capacity]"
-            min="1" value="<?= htmlspecialchars((string) $event->capacity) ?>">
+            min="<?= max(1, $enrolled) ?>" value="<?= htmlspecialchars((string) $event->capacity) ?>">
+        <?php if ($enrolled > 0) : ?>
+            <div class="form-text">Mínimo: <?= $enrolled ?> (número de inscritos).</div>
