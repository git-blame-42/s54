 .../events/UpdateEventWithEnrollmentsCest.php | 50 ++++++++++
 .../Admin/EventsControllerTest.php            | 64 ++++++++++++
 tests/Unit/Models/Events/EventTest.php        | 98 +++++++++++++++++++
