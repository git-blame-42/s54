 app/views/admin/events/index.phtml            |  2 +
 app/views/admin/events/show.phtml             |  3 +
 database/schema.sql                           |  3 +
 .../admin/events/CreateSuccessfullyCest.php   |  5 +
 .../Admin/EventsControllerTest.php            | 51 +++++++++++
 tests/Unit/Models/Events/EventTest.php        | 91 +++++++++++++++++++
 7 files changed, 210 insertions(+)

