diff --git a/app/Models/Event.php b/app/Models/Event.php
index ba66870..a094a9d 100644
--- a/app/Models/Event.php
+++ b/app/Models/Event.php
@@ -59,7 +59,8 @@ class Event extends Model
 
     public function validates(): void
     {
-        Validations::notEmpty('title', $this);
+        Validations::notEmpty('title', $this) &&
+            Validations::maxLength('title', $this, 100);
         Validations::notEmpty('description', $this);
         Validations::notEmpty('location', $this);
 
diff --git a/lib/Validations.php b/lib/Validations.php
index f456148..462ace4 100644
--- a/lib/Validations.php
+++ b/lib/Validations.php
@@ -93,6 +93,21 @@ class Validations
         return true;
     }
 
+    /**
+     * O texto deve ter no máximo $max caracteres (conta caracteres, não bytes: "ç" vale 1).
+     */
+    public static function maxLength($attribute, $obj, int $max)
+    {
+        $value = $obj->$attribute;
+
+        if (is_scalar($value) && mb_strlen((string) $value) > $max) {
+            $obj->addError($attribute, "deve ter no máximo {$max} caracteres!");
+            return false;
+        }
+
+        return true;
+    }
+
     /**
      * A data deve existir no calendário e estar no formato $format (padrão Y-m-d).
      */
