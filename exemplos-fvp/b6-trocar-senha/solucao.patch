--- a/app/Models/User.php
+++ b/app/Models/User.php
@@ -69,6 +69,29 @@ class User extends Model
         return $this->update(['last_login_at' => date('Y-m-d H:i:s')]);
     }
 
+    /**
+     * Troca a senha de um usuário já salvo. O __set só gera o hash em
+     * registro novo; por isso o hash é feito aqui e gravado via update().
+     */
+    public function changePassword(string $password, string $confirmation): bool
+    {
+        $this->errors = [];
+        $this->password = $password;
+        $this->password_confirmation = $confirmation;
+
+        if (!Validations::notEmpty('password', $this)) {
+            return false;
+        }
+
+        if (!Validations::passwordConfirmation($this)) {
+            return false;
+        }
+
+        return $this->update([
+            'encrypted_password' => password_hash($password, PASSWORD_DEFAULT),
+        ]);
+    }
+
     public function __set(string $property, mixed $value): void
     {
         parent::__set($property, $value);
