+    public function test_change_password_should_fail_when_empty(): void
+    {
+        $this->assertFalse($this->user->changePassword('', ''));
+
+        $this->assertEquals('não pode ser vazio!', $this->user->errors('password'));
+        $this->assertTrue(User::findById($this->user->id)->authenticate('123456'));
+    }
