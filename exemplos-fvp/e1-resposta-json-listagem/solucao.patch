diff --git a/app/Controllers/Admin/UsersController.php b/app/Controllers/Admin/UsersController.php
index d85914a..41f66fa 100644
--- a/app/Controllers/Admin/UsersController.php
+++ b/app/Controllers/Admin/UsersController.php
@@ -17,7 +17,13 @@ class UsersController extends Controller
         );
         $users = $paginator->registers();
 
-        $title = 'Usuários';
-        $this->render('admin/users/index', compact('users', 'paginator', 'title'));
+        // Mesma ação, duas representações: JSON quando o cliente pede
+        // (header Accept: application/json), HTML no restante dos casos.
+        if ($request->acceptJson()) {
+            $this->renderJson('admin/users/index', compact('users', 'paginator'));
+        } else {
+            $title = 'Usuários';
+            $this->render('admin/users/index', compact('users', 'paginator', 'title'));
+        }
     }
 }
