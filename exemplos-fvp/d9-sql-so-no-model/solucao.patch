 namespace App\Controllers\Admin;
 
+use App\Models\User;
 use Core\Http\Controllers\Controller;
 
 class DashboardController extends Controller
 {
     public function index(): void
     {
+        $users = User::orderedByName();
+        $totalAdmins = User::countByRole('admin');
