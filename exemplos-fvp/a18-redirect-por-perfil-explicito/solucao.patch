diff --git a/app/Models/User.php b/app/Models/User.php
index ea25224..8b68f03 100644
--- a/app/Models/User.php
+++ b/app/Models/User.php
@@ -72,6 +72,19 @@ class User extends Model
         return $this->role === self::ROLE_PARTICIPANT;
     }
 
+    /**
+     * Nome da rota inicial do perfil. Perfil fora da lista é erro de
+     * programação (ex.: perfil novo sem rota), não erro do usuário.
+     */
+    public function homeRoute(): string
+    {
+        return match ($this->role) {
+            self::ROLE_ADMIN => 'admin.dashboard.index',
+            self::ROLE_PARTICIPANT => 'dashboard.index',
+            default => throw new \DomainException("Perfil desconhecido: {$this->role}"),
+        };
+    }
+
     public function registerLogin(): bool
     {
         return $this->update(['last_login_at' => date('Y-m-d H:i:s')]);
