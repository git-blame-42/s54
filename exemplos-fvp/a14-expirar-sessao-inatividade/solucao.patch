diff --git a/tests/Unit/App/Middleware/AuthenticateDouble.php b/tests/Unit/App/Middleware/AuthenticateDouble.php
new file mode 100644
index 0000000..82e061a
--- /dev/null
+++ b/tests/Unit/App/Middleware/AuthenticateDouble.php
@@ -0,0 +1,19 @@
+<?php
+
+namespace Tests\Unit\App\Middleware;
+
+use App\Middleware\Authenticate;
+
+/**
+ * Dublê de teste: guarda o destino do redirecionamento em vez de chamar
+ * header() + exit, como o redirectTo sobrescrito em ControllerTestCase.
+ */
+class AuthenticateDouble extends Authenticate
+{
+    public ?string $redirectedTo = null;
+
+    protected function redirectTo(string $location): void
+    {
+        $this->redirectedTo = $location;
+    }
+}
diff --git a/tests/Unit/App/Middleware/AuthenticateTest.php b/tests/Unit/App/Middleware/AuthenticateTest.php
new file mode 100644
index 0000000..f528313
--- /dev/null
+++ b/tests/Unit/App/Middleware/AuthenticateTest.php
@@ -0,0 +1,80 @@
+<?php
+
+namespace Tests\Unit\App\Middleware;
+
+use App\Models\User;
+use Core\Constants\Constants;
+use Core\Http\Request;
+use Core\Router\Router;
+use Lib\Authentication\Auth;
+use Lib\FlashMessage;
+use Tests\TestCase;
+
+class AuthenticateTest extends TestCase
+{
+    private Request $request;
+    private User $user;
+
+    public function setUp(): void
+    {
+        parent::setUp();
+        $_SESSION = [];
+        Router::reset();
+        require Constants::rootPath()->join('config/routes.php');
+
+        $_SERVER['REQUEST_METHOD'] = 'GET';
+        $_SERVER['REQUEST_URI'] = '/dashboard';
+        $this->request = new Request();
+
+        $this->user = new User([
+            'name' => 'User 1',
+            'email' => 'fulano@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456'
+        ]);
+        $this->user->save();
+    }
+
+    public function tearDown(): void
+    {
+        unset($_SERVER['REQUEST_METHOD']);
+        unset($_SERVER['REQUEST_URI']);
+        $_SESSION = [];
+        Router::reset();
+        parent::tearDown();
+    }
+
+    public function test_handle_with_recent_activity_should_not_redirect(): void
+    {
+        Auth::login($this->user);
+        $middleware = new AuthenticateDouble();
+
+        $middleware->handle($this->request);
+
+        $this->assertNull($middleware->redirectedTo);
+        $this->assertEmpty(FlashMessage::get());
+    }
+
+    public function test_handle_after_timeout_should_redirect_with_expired_message(): void
+    {
+        Auth::login($this->user);
+        $_SESSION['user']['last_activity'] = time() - Auth::TIMEOUT - 1;
+        $middleware = new AuthenticateDouble();
+
+        $middleware->handle($this->request);
+
+        $this->assertEquals('/login', $middleware->redirectedTo);
+        $this->assertEquals(['danger' => 'Sua sessão expirou. Faça login novamente.'], FlashMessage::get());
+        $this->assertArrayNotHasKey('user', $_SESSION);
+    }
+
+    public function test_handle_without_session_should_redirect_with_login_message(): void
+    {
+        $middleware = new AuthenticateDouble();
+
+        $middleware->handle($this->request);
+
+        $this->assertEquals('/login', $middleware->redirectedTo);
+        $this->assertEquals(['danger' => 'Você deve estar logado para acessar essa página'], FlashMessage::get());
+    }
+}
diff --git a/tests/Unit/Lib/Authentication/AuthTest.php b/tests/Unit/Lib/Authentication/AuthTest.php
index 1394c4e..5da7ac2 100644
--- a/tests/Unit/Lib/Authentication/AuthTest.php
+++ b/tests/Unit/Lib/Authentication/AuthTest.php
@@ -60,4 +60,67 @@ class AuthTest extends TestCase
 
         $this->assertFalse(Auth::check());
     }
+
+    public function test_login_should_store_last_activity(): void
+    {
+        Auth::login($this->user);
+
+        $this->assertEqualsWithDelta(time(), $_SESSION['user']['last_activity'], 1);
+    }
+
+    public function test_check_with_recent_activity_should_be_true(): void
+    {
+        Auth::login($this->user);
+        $_SESSION['user']['last_activity'] = time() - Auth::TIMEOUT + 60;
+
+        $this->assertTrue(Auth::check());
+    }
+
+    public function test_check_after_timeout_should_be_false_and_clear_session(): void
+    {
+        Auth::login($this->user);
+        $_SESSION['user']['last_activity'] = time() - Auth::TIMEOUT - 1;
+
+        $this->assertFalse(Auth::check());
+        $this->assertArrayNotHasKey('user', $_SESSION);
+        $this->assertTrue(Auth::wasExpired());
+    }
+
+    public function test_check_should_renew_last_activity(): void
+    {
+        Auth::login($this->user);
+        $_SESSION['user']['last_activity'] = time() - 600;
+
+        Auth::check();
+
+        $this->assertEqualsWithDelta(time(), $_SESSION['user']['last_activity'], 1);
+    }
+
+    public function test_was_expired_should_be_consumed_after_first_read(): void
+    {
+        Auth::login($this->user);
+        $_SESSION['user']['last_activity'] = time() - Auth::TIMEOUT - 1;
+        Auth::check();
+
+        $this->assertTrue(Auth::wasExpired());
+        $this->assertFalse(Auth::wasExpired());
+    }
+
+    public function test_login_should_clear_expired_flag(): void
+    {
+        $_SESSION['auth_expired'] = true;
+
+        Auth::login($this->user);
+
+        $this->assertFalse(Auth::wasExpired());
+    }
+
+    public function test_logout_should_clear_whole_user_session(): void
+    {
+        Auth::login($this->user);
+        Auth::logout();
+
+        $this->assertArrayNotHasKey('user', $_SESSION);
+        $this->assertFalse(Auth::wasExpired());
+    }
 }
