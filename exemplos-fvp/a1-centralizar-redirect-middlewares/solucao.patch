diff --git a/app/Middleware/Authenticate.php b/app/Middleware/Authenticate.php
index 11872f6..77af4c5 100644
--- a/app/Middleware/Authenticate.php
+++ b/app/Middleware/Authenticate.php
@@ -2,24 +2,15 @@
 
 namespace App\Middleware;
 
-use Core\Http\Middleware\Middleware;
 use Core\Http\Request;
 use Lib\Authentication\Auth;
