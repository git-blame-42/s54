diff --git a/tests/Integration/Controllers/Admin/DashboardControllerTest.php b/tests/Integration/Controllers/Admin/DashboardControllerTest.php
new file mode 100644
index 0000000..0fb08fe
--- /dev/null
+++ b/tests/Integration/Controllers/Admin/DashboardControllerTest.php
@@ -0,0 +1,42 @@
+<?php
+
+namespace Tests\Integration\Controllers\Admin;
+
+use App\Models\User;
+use Lib\Authentication\Auth;
+use Tests\Integration\Controllers\ControllerTestCase;
+
+class DashboardControllerTest extends ControllerTestCase
+{
+    public function test_index_should_show_user_counters(): void
+    {
+        $admin = new User([
+            'name' => 'Admin',
+            'email' => 'admin@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456',
+            'role' => 'admin',
+        ]);
+        $admin->save();
+
+        foreach (['fulano', 'beltrano'] as $name) {
+            (new User([
+                'name' => ucfirst($name),
+                'email' => "{$name}@example.com",
+                'password' => '123456',
+                'password_confirmation' => '123456',
+            ]))->save();
+        }
+
+        Auth::login($admin);
+
+        $response = $this->get(
+            action: 'index',
+            controllerName: 'App\Controllers\Admin\DashboardController'
+        );
+
+        $this->assertStringContainsString('Usuários cadastrados: 3', $response);
+        $this->assertStringContainsString('Administradores: 1', $response);
+        $this->assertStringContainsString('Participantes: 2', $response);
+    }
+}
diff --git a/tests/Unit/Models/Users/UserTest.php b/tests/Unit/Models/Users/UserTest.php
index 5780e2e..d27e1f1 100644
--- a/tests/Unit/Models/Users/UserTest.php
+++ b/tests/Unit/Models/Users/UserTest.php
@@ -165,4 +165,25 @@ class UserTest extends TestCase
         $this->assertTrue($this->user->authenticate('123456'));
         $this->assertFalse($this->user->authenticate('654321'));
     }
+
+    public function test_where_should_filter_by_role(): void
+    {
+        $this->user->role = 'admin';
+        $this->user->save();
+
+        $admins = User::where(['role' => 'admin']);
+
+        $this->assertCount(1, $admins);
+        $this->assertEquals($this->user->id, $admins[0]->id);
+    }
+
+    public function test_count_by_role_should_count_users_with_the_role(): void
+    {
+        $this->user->role = 'admin';
+        $this->user->save();
+
+        $this->assertEquals(1, User::countByRole('admin'));
+        $this->assertEquals(1, User::countByRole('participant'));
+        $this->assertEquals(0, User::countByRole('moderator'));
+    }
 }
