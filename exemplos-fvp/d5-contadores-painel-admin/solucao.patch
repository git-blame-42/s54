diff --git a/app/Controllers/Admin/DashboardController.php b/app/Controllers/Admin/DashboardController.php
index 0a3e62f..1192a8a 100644
--- a/app/Controllers/Admin/DashboardController.php
+++ b/app/Controllers/Admin/DashboardController.php
@@ -2,13 +2,21 @@
 
 namespace App\Controllers\Admin;
 
+use App\Models\User;
 use Core\Http\Controllers\Controller;
 
 class DashboardController extends Controller
 {
     public function index(): void
     {
+        $totalUsers = count(User::all());
+        $totalAdmins = User::countByRole('admin');
+        $totalParticipants = User::countByRole('participant');
+
         $title = 'Painel Administrativo';
-        $this->render('admin/dashboard/index', compact('title'));
+        $this->render(
+            'admin/dashboard/index',
+            compact('title', 'totalUsers', 'totalAdmins', 'totalParticipants')
+        );
     }
 }
diff --git a/app/Models/User.php b/app/Models/User.php
index 9ae08a0..f092c42 100644
--- a/app/Models/User.php
+++ b/app/Models/User.php
@@ -59,6 +59,14 @@ class User extends Model
         return User::findBy(['email' => $email]);
     }
 
+    /**
+     * Conta os usuários de um perfil usando o where() do ActiveRecord.
+     */
+    public static function countByRole(string $role): int
+    {
+        return count(static::where(['role' => $role]));
+    }
+
     public function isAdmin(): bool
     {
         return $this->role === 'admin';
