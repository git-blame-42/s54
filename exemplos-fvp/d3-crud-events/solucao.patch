+
+    public function test_destroy_should_respond_404_for_unknown_event(): void
+    {
+        $this->expectException(HTTPException::class);
+
+        $this->delete(action: 'destroy', controllerName: self::CONTROLLER, params: ['id' => 999]);
+    }
+}
