 tests/Integration/Access/LogoutAccessTest.php | 44 +++++++++++++++++++
 .../AuthenticationsControllerTest.php         |  2 +-
 .../Controllers/ControllerTestCase.php        |  8 ++++
 tests/Unit/Core/Http/RequestTest.php          |  9 ++++
 6 files changed, 69 insertions(+), 3 deletions(-)
 create mode 100644 tests/Integration/Access/LogoutAccessTest.php

