diff --git a/app/Middleware/Authenticate.php b/app/Middleware/Authenticate.php
index 11872f6..80853c7 100644
--- a/app/Middleware/Authenticate.php
+++ b/app/Middleware/Authenticate.php
@@ -12,12 +12,16 @@ class Authenticate implements Middleware
     public function handle(Request $request): void
     {
         if (!Auth::check()) {
+            // Só GET: um POST reproduzido como GET depois do login daria 404.
+            if ($request->getMethod() === 'GET') {
+                Auth::rememberIntendedUrl($request->getUri());
+            }
             FlashMessage::danger('Você deve estar logado para acessar essa página');
             $this->redirectTo(route('users.login'));
         }
     }
 
-    private function redirectTo(string $location): void
+    protected function redirectTo(string $location): void
     {
         header('Location: ' . $location);
         exit;
