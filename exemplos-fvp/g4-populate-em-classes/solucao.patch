diff --git a/database/Populate/UsersPopulate.php b/database/Populate/UsersPopulate.php
new file mode 100644
index 0000000..94a97eb
--- /dev/null
+++ b/database/Populate/UsersPopulate.php
@@ -0,0 +1,30 @@
+<?php
+
+namespace Database\Populate;
+
+use App\Models\User;
+
+class UsersPopulate
+{
+    public static function populate(): void
+    {
+        $admin = new User([
+            'name' => 'Administrador',
+            'email' => 'admin@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456',
+            'role' => 'admin'
+        ]);
+        $admin->save();
+
+        $user = new User([
+            'name' => 'Usuário',
+            'email' => 'user@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456'
+        ]);
+        $user->save();
+
+        echo "Usuários criados: {$admin->email} (admin) e {$user->email} (participant), senha 123456\n";
+    }
+}
