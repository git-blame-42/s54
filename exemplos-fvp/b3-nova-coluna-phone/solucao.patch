diff --git a/tests/Integration/Controllers/DashboardControllerTest.php b/tests/Integration/Controllers/DashboardControllerTest.php
new file mode 100644
index 0000000..757a21d
--- /dev/null
+++ b/tests/Integration/Controllers/DashboardControllerTest.php
@@ -0,0 +1,43 @@
+<?php
+
+namespace Tests\Integration\Controllers;
+
+use App\Models\User;
+use Lib\Authentication\Auth;
+
+class DashboardControllerTest extends ControllerTestCase
+{
+    private User $user;
+
+    public function setUp(): void
+    {
+        parent::setUp();
+        $this->user = new User([
+            'name' => 'User 1',
+            'email' => 'fulano@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456',
+            'phone' => '(46) 99999-0000'
+        ]);
+        $this->user->save();
+    }
+
+    public function test_index_should_show_user_phone(): void
+    {
+        Auth::login($this->user);
+
+        $response = $this->get(action: 'index', controllerName: 'App\Controllers\DashboardController');
+
+        $this->assertStringContainsString('Telefone: (46) 99999-0000', $response);
+    }
+
+    public function test_index_should_show_placeholder_when_phone_is_empty(): void
+    {
+        $this->user->update(['phone' => null]);
+        Auth::login($this->user);
+
+        $response = $this->get(action: 'index', controllerName: 'App\Controllers\DashboardController');
+
+        $this->assertStringContainsString('Telefone: não informado', $response);
+    }
+}
diff --git a/tests/Unit/Models/Users/UserTest.php b/tests/Unit/Models/Users/UserTest.php
index 5780e2e..c12bf03 100644
--- a/tests/Unit/Models/Users/UserTest.php
+++ b/tests/Unit/Models/Users/UserTest.php
@@ -165,4 +165,17 @@ class UserTest extends TestCase
         $this->assertTrue($this->user->authenticate('123456'));
         $this->assertFalse($this->user->authenticate('654321'));
     }
+
+    public function test_phone_should_be_null_by_default(): void
+    {
+        $this->assertNull(User::findById($this->user->id)->phone);
+    }
+
+    public function test_phone_should_be_persisted(): void
+    {
+        $this->user->phone = '(46) 99999-0000';
+        $this->user->save();
+
+        $this->assertEquals('(46) 99999-0000', User::findById($this->user->id)->phone);
+    }
 }
