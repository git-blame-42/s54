--- /dev/null
+++ b/tests/Unit/Core/Router/RecordingMiddleware.php
@@ -0,0 +1,21 @@
+<?php
+
+namespace Tests\Unit\Core\Router;
+
+use Core\Http\Middleware\Middleware;
+use Core\Http\Request;
+
+/**
+ * Middleware de teste: grava o nome da classe em `$calls` quando roda,
+ * para os testes conferirem a ordem real de execução.
+ */
+abstract class RecordingMiddleware implements Middleware
+{
+    /** @var string[] */
+    public static array $calls = [];
+
+    public function handle(Request $request): void
+    {
+        self::$calls[] = static::class;
+    }
+}
diff --git a/tests/Unit/Core/Router/RouteTest.php b/tests/Unit/Core/Router/RouteTest.php
index 7946a53..4fdc009 100644
--- a/tests/Unit/Core/Router/RouteTest.php
+++ b/tests/Unit/Core/Router/RouteTest.php
@@ -206,4 +206,18 @@ class RouteTest extends TestCase
 
         $this->assertContains($middleware, $middlewares);
     }
+
+    public function test_prepend_middleware_should_put_it_before_existing_ones(): void
+    {
+        $route = new Route(method: 'GET', uri: '/test', controllerName: 'MockController', actionName: 'show');
+        $added = $this->createMock(Middleware::class);
+        $prepended = $this->createMock(Middleware::class);
+
+        $route->addMiddleware($added);
+        $route->prependMiddleware($prepended);
+
+        $middlewares = (new \ReflectionObject($route))->getProperty('middlewares')->getValue($route);
+
+        $this->assertSame([$prepended, $added], $middlewares);
+    }
 }
