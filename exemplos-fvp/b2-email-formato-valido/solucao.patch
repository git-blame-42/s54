diff --git a/app/Models/User.php b/app/Models/User.php
index 9ae08a0..3106767 100644
--- a/app/Models/User.php
+++ b/app/Models/User.php
@@ -37,6 +37,7 @@ class User extends Model
     {
         Validations::notEmpty('name', $this);
         Validations::notEmpty('email', $this);
+        Validations::email('email', $this);
 
         Validations::uniqueness('email', $this);
 
diff --git a/lib/Validations.php b/lib/Validations.php
index 6f392ce..c02d7b5 100644
--- a/lib/Validations.php
+++ b/lib/Validations.php
@@ -16,6 +16,26 @@ class Validations
         return true;
     }
 
+    /**
+     * Valida o formato do e-mail. Vazio ou nulo passa: quem acusa campo
+     * vazio é a regra notEmpty, para a mensagem dela não ser sobrescrita.
+     */
+    public static function email(string $attribute, $obj): bool
+    {
+        $value = $obj->$attribute;
+
+        if ($value === null || $value === '') {
+            return true;
+        }
+
+        if (filter_var($value, FILTER_VALIDATE_EMAIL) === false) {
+            $obj->addError($attribute, 'deve ser um e-mail válido!');
+            return false;
+        }
+
+        return true;
+    }
+
     public static function passwordConfirmation($obj)
     {
         if ($obj->password !== $obj->password_confirmation) {
