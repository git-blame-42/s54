diff --git a/tests/Integration/Access/AdminAccessTest.php b/tests/Integration/Access/AdminAccessTest.php
new file mode 100644
index 0000000..8e8dc22
--- /dev/null
+++ b/tests/Integration/Access/AdminAccessTest.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace Tests\Integration\Access;
+
+use App\Models\User;
+use GuzzleHttp\Client;
+use Tests\TestCase;
+
+/**
+ * Acessa /admin com sessão de verdade (cookie do Guzzle) para provar o
+ * status HTTP que o middleware Admin devolve a cada perfil.
+ */
+class AdminAccessTest extends TestCase
+{
+    private Client $client;
+
+    public function setUp(): void
+    {
+        parent::setUp();
+        $this->client = new Client([
+            'allow_redirects' => false,
+            'http_errors' => false,
+            'cookies' => true,
+            'base_uri' => 'http://web:8080',
+        ]);
+    }
+
+    public function test_admin_route_should_respond_403_for_common_user(): void
+    {
+        $this->createUserAndLogin('participant');
+
+        $response = $this->client->get('/admin');
+
+        $this->assertEquals(403, $response->getStatusCode());
+        $this->assertStringContainsString('Acesso restrito a administradores', (string) $response->getBody());
+    }
+
+    public function test_admin_route_should_respond_200_for_admin(): void
+    {
+        $this->createUserAndLogin('admin');
+
+        $response = $this->client->get('/admin');
+
+        $this->assertEquals(200, $response->getStatusCode());
+        $this->assertStringContainsString('Painel Administrativo', (string) $response->getBody());
+    }
+
+    private function createUserAndLogin(string $role): void
+    {
+        $user = new User([
+            'name' => 'Fulano',
+            'email' => 'fulano@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456',
+            'role' => $role,
+        ]);
+        $user->save();
+
+        $this->client->post('/login', [
+            'form_params' => ['user' => ['email' => 'fulano@example.com', 'password' => '123456']],
+        ]);
+    }
+}
diff --git a/tests/Unit/App/Middleware/AdminTest.php b/tests/Unit/App/Middleware/AdminTest.php
new file mode 100644
index 0000000..28b3124
--- /dev/null
+++ b/tests/Unit/App/Middleware/AdminTest.php
@@ -0,0 +1,78 @@
+<?php
+
+namespace Tests\Unit\App\Middleware;
+
+use App\Middleware\Admin;
+use App\Models\User;
+use Core\Exceptions\HTTPException;
+use Core\Http\Request;
+use Lib\Authentication\Auth;
+use Tests\TestCase;
+
+class AdminTest extends TestCase
+{
+    private Admin $middleware;
+    private Request $request;
+
+    public function setUp(): void
+    {
+        parent::setUp();
+        $_SESSION = [];
+        $_SERVER['REQUEST_METHOD'] = 'GET';
+        $_SERVER['REQUEST_URI'] = '/admin';
+
+        $this->middleware = new Admin();
+        $this->request = new Request();
+    }
+
+    public function tearDown(): void
+    {
+        $_SESSION = [];
+        unset($_SERVER['REQUEST_METHOD']);
+        unset($_SERVER['REQUEST_URI']);
+        parent::tearDown();
+    }
+
+    public function test_handle_should_throw_403_for_common_user(): void
+    {
+        Auth::login($this->createUser('participant'));
+
+        try {
+            $this->middleware->handle($this->request);
+            $this->fail('Esperava HTTPException para usuário sem perfil admin');
+        } catch (HTTPException $e) {
+            $this->assertEquals(403, $e->getStatusCode());
+            $this->assertEquals('Acesso restrito a administradores', $e->getMessage());
+        }
+    }
+
+    public function test_handle_should_allow_admin_user(): void
+    {
+        Auth::login($this->createUser('admin'));
+
+        $this->middleware->handle($this->request);
+
+        $this->assertTrue(Auth::check());
+    }
+
+    public function test_handle_should_ignore_request_without_session(): void
+    {
+        $this->middleware->handle($this->request);
+
+        $this->assertFalse(Auth::check());
+    }
+
+    private function createUser(string $role): User
+    {
+        $user = new User([
+            'name' => 'Fulano',
+            'email' => 'fulano@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456',
+            'role' => $role,
+        ]);
+        $user->save();
+
+        return $user;
+    }
+}
