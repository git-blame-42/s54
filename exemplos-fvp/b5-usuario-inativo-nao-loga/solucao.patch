From cee5f93c550d1d8e15232df0ed107bd685c8038c Mon Sep 17 00:00:00 2001
From: thorvi <thorvi@mbp>
Date: Thu, 15 Oct 2026 19:51:42 -0300
Subject: [PATCH] feat: Block login of inactive users

---
 app/Controllers/AuthenticationsController.php   | 11 +++++++----
 app/Models/User.php                             | 14 +++++++++++++-
 database/Populate/populate.php                  | 11 ++++++++++-
 database/schema.sql                             |  1 +
 tests/Acceptance/authentications/LoginCest.php  | 17 +++++++++++++++++
 .../AuthenticationsControllerTest.php           | 14 ++++++++++++++
 tests/Unit/Models/Users/UserTest.php            | 12 ++++++++++++
 7 files changed, 74 insertions(+), 6 deletions(-)

diff --git a/app/Controllers/AuthenticationsController.php b/app/Controllers/AuthenticationsController.php
index cc159e5..01da43d 100644
--- a/app/Controllers/AuthenticationsController.php
+++ b/app/Controllers/AuthenticationsController.php
@@ -21,13 +21,16 @@ class AuthenticationsController extends Controller
         $params = $request->getParam('user');
         $user = User::findByEmail($params['email']);
 
-        if ($user && $user->authenticate($params['password'])) {
+        if ($user === null || !$user->authenticate($params['password'])) {
+            FlashMessage::danger('E-mail ou senha inválidos!');
+            $this->redirectTo(route('users.login'));
+        } elseif (!$user->isActive()) {
+            FlashMessage::danger('Usuário inativo. Procure a administração.');
+            $this->redirectTo(route('users.login'));
+        } else {
             Auth::login($user);
             FlashMessage::success('Login realizado com sucesso!');
             $this->redirectTo(route('dashboard.index'));
-        } else {
-            FlashMessage::danger('E-mail ou senha inválidos!');
-            $this->redirectTo(route('users.login'));
         }
     }
 
diff --git a/app/Models/User.php b/app/Models/User.php
index 9ae08a0..431a9a0 100644
--- a/app/Models/User.php
+++ b/app/Models/User.php
@@ -11,12 +11,13 @@ use Core\Database\ActiveRecord\Model;
  * @property string $email
  * @property string $encrypted_password
  * @property string $role
+ * @property int|string $active
  * @property string|null $last_login_at
  */
 class User extends Model
 {
     protected static string $table = 'users';
-    protected static array $columns = ['name', 'email', 'encrypted_password', 'role', 'last_login_at'];
+    protected static array $columns = ['name', 'email', 'encrypted_password', 'role', 'active', 'last_login_at'];
 
     protected ?string $password = null;
     protected ?string $password_confirmation = null;
@@ -31,6 +32,11 @@ class User extends Model
         if ($this->role === null) {
             $this->role = 'participant';
         }
+
+        // Usuário novo nasce ativo; o schema tem DEFAULT 1, mas o INSERT envia todas as colunas.
+        if ($this->active === null) {
+            $this->active = 1;
+        }
     }
 
     public function validates(): void
@@ -64,6 +70,12 @@ class User extends Model
         return $this->role === 'admin';
     }
 
+    public function isActive(): bool
+    {
+        // TINYINT chega do PDO como string "1" ou "0"; o cast resolve.
+        return (bool) $this->active;
+    }
+
     public function registerLogin(): bool
     {
         return $this->update(['last_login_at' => date('Y-m-d H:i:s')]);
