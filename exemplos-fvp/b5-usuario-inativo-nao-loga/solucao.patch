diff --git a/tests/Acceptance/authentications/LoginCest.php b/tests/Acceptance/authentications/LoginCest.php
index 04eca11..2d0c395 100644
--- a/tests/Acceptance/authentications/LoginCest.php
+++ b/tests/Acceptance/authentications/LoginCest.php
@@ -18,6 +18,15 @@ class LoginCest extends BaseAcceptanceCest
             'password_confirmation' => '123456'
         ]);
         $user->save();
+
+        $inactive = new User([
+            'name' => 'Inativo',
+            'email' => 'inativo@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456',
+            'active' => 0
+        ]);
+        $inactive->save();
     }
 
     public function loginWithInvalidCredentials(AcceptanceTester $page): void
@@ -28,6 +37,14 @@ class LoginCest extends BaseAcceptanceCest
         $page->see('E-mail ou senha inválidos!');
     }
 
+    public function loginWithInactiveUser(AcceptanceTester $page): void
+    {
+        $page->login('inativo@example.com', '123456');
+
+        $page->seeCurrentUrlEquals('/login');
+        $page->see('Usuário inativo. Procure a administração.');
+    }
+
     public function loginWithValidCredentials(AcceptanceTester $page): void
     {
         $page->login('fulano@example.com', '123456');
diff --git a/tests/Integration/Controllers/AuthenticationsControllerTest.php b/tests/Integration/Controllers/AuthenticationsControllerTest.php
index 6a368fe..c128c26 100644
--- a/tests/Integration/Controllers/AuthenticationsControllerTest.php
+++ b/tests/Integration/Controllers/AuthenticationsControllerTest.php
@@ -53,6 +53,20 @@ class AuthenticationsControllerTest extends ControllerTestCase
         $this->assertStringContainsString('Location: /login', $response);
     }
 
+    public function test_authenticate_inactive_user_should_not_login(): void
+    {
+        $this->user->update(['active' => 0]);
+
+        $response = $this->post(
+            action: 'authenticate',
+            controllerName: 'App\Controllers\AuthenticationsController',
+            params: ['user' => ['email' => 'fulano@example.com', 'password' => '123456']]
+        );
+
+        $this->assertFalse(Auth::check());
+        $this->assertStringContainsString('Location: /login', $response);
+    }
+
     public function test_destroy_should_logout(): void
     {
         Auth::login($this->user);
diff --git a/tests/Unit/Models/Users/UserTest.php b/tests/Unit/Models/Users/UserTest.php
index 5780e2e..44c83db 100644
--- a/tests/Unit/Models/Users/UserTest.php
+++ b/tests/Unit/Models/Users/UserTest.php
@@ -150,6 +150,18 @@ class UserTest extends TestCase
         $this->assertNull(User::findById($this->user->id)->last_login_at);
     }
 
+    public function test_is_active_should_return_true_by_default(): void
+    {
+        $this->assertTrue(User::findById($this->user->id)->isActive());
+    }
+
+    public function test_is_active_should_return_false_after_deactivation(): void
+    {
+        $this->user->update(['active' => 0]);
+
+        $this->assertFalse(User::findById($this->user->id)->isActive());
+    }
+
     public function test_register_login_should_set_last_login_at(): void
     {
         $this->user->registerLogin();
