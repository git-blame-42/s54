diff --git a/tests/Integration/Access/LoginAccessTest.php b/tests/Integration/Access/LoginAccessTest.php
new file mode 100644
index 0000000..6f2acff
--- /dev/null
+++ b/tests/Integration/Access/LoginAccessTest.php
@@ -0,0 +1,46 @@
+<?php
+
+namespace Tests\Integration\Access;
+
+use GuzzleHttp\Client;
+use PHPUnit\Framework\TestCase;
+
+class LoginAccessTest extends TestCase
+{
+    private Client $client;
+
+    public function setUp(): void
+    {
+        parent::setUp();
+        $this->client = new Client([
+            'allow_redirects' => false,
+            'base_uri' => 'http://web:8080'
+        ]);
+    }
+
+    public function test_login_form_should_disable_html5_validation(): void
+    {
+        $response = $this->client->get('/login');
+
+        $this->assertEquals(200, $response->getStatusCode());
+        $this->assertStringContainsString('novalidate', (string) $response->getBody());
+    }
+
+    public function test_post_login_without_params_should_redirect_to_login(): void
+    {
+        $response = $this->client->post('/login');
+
+        $this->assertEquals(302, $response->getStatusCode());
+        $this->assertEquals('/login', $response->getHeaderLine('Location'));
+    }
+
+    public function test_post_login_with_empty_fields_should_redirect_to_login(): void
+    {
+        $response = $this->client->post('/login', [
+            'form_params' => ['user' => ['email' => '', 'password' => '']]
+        ]);
+
+        $this->assertEquals(302, $response->getStatusCode());
+        $this->assertEquals('/login', $response->getHeaderLine('Location'));
+    }
+}
diff --git a/tests/Integration/Controllers/AuthenticationsControllerTest.php b/tests/Integration/Controllers/AuthenticationsControllerTest.php
index 6a368fe..3a4788b 100644
--- a/tests/Integration/Controllers/AuthenticationsControllerTest.php
+++ b/tests/Integration/Controllers/AuthenticationsControllerTest.php
@@ -53,6 +53,41 @@ class AuthenticationsControllerTest extends ControllerTestCase
         $this->assertStringContainsString('Location: /login', $response);
     }
 
+    public function test_authenticate_without_params_should_not_login(): void
+    {
+        $response = $this->post(
+            action: 'authenticate',
+            controllerName: 'App\Controllers\AuthenticationsController'
+        );
+
+        $this->assertFalse(Auth::check());
+        $this->assertStringContainsString('Location: /login', $response);
+    }
+
+    public function test_authenticate_with_empty_fields_should_not_login(): void
+    {
+        $response = $this->post(
+            action: 'authenticate',
+            controllerName: 'App\Controllers\AuthenticationsController',
+            params: ['user' => ['email' => '', 'password' => '']]
+        );
+
+        $this->assertFalse(Auth::check());
+        $this->assertStringContainsString('Location: /login', $response);
+    }
+
+    public function test_authenticate_with_spaces_around_email_should_login(): void
+    {
+        $response = $this->post(
+            action: 'authenticate',
+            controllerName: 'App\Controllers\AuthenticationsController',
+            params: ['user' => ['email' => '  fulano@example.com  ', 'password' => '123456']]
+        );
+
+        $this->assertTrue(Auth::check());
+        $this->assertStringContainsString('Location: /dashboard', $response);
+    }
+
     public function test_destroy_should_logout(): void
     {
         Auth::login($this->user);
-- 
