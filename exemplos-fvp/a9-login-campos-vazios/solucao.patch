 app/views/authentications/new.phtml           |  6 +--
 .../Acceptance/authentications/LoginCest.php  |  8 ++++
 tests/Integration/Access/LoginAccessTest.php  | 46 +++++++++++++++++++
 .../AuthenticationsControllerTest.php         | 35 ++++++++++++++
 5 files changed, 98 insertions(+), 6 deletions(-)
 create mode 100644 tests/Integration/Access/LoginAccessTest.php

diff --git a/app/Controllers/AuthenticationsController.php b/app/Controllers/AuthenticationsController.php
index cc159e5..f15d01c 100644
--- a/app/Controllers/AuthenticationsController.php
+++ b/app/Controllers/AuthenticationsController.php
@@ -18,10 +18,13 @@ class AuthenticationsController extends Controller
 
     public function authenticate(Request $request): void
     {
-        $params = $request->getParam('user');
-        $user = User::findByEmail($params['email']);
+        $params = $request->getParam('user', []);
+        $email = trim($params['email'] ?? '');
+        $password = $params['password'] ?? '';
 
-        if ($user && $user->authenticate($params['password'])) {
+        $user = $email !== '' ? User::findByEmail($email) : null;
+
+        if ($user && $user->authenticate($password)) {
             Auth::login($user);
             FlashMessage::success('Login realizado com sucesso!');
             $this->redirectTo(route('dashboard.index'));
