diff --git a/tests/Acceptance/profile/ProfileCest.php b/tests/Acceptance/profile/ProfileCest.php
new file mode 100644
index 0000000..3c5e606
--- /dev/null
+++ b/tests/Acceptance/profile/ProfileCest.php
@@ -0,0 +1,55 @@
+<?php
+
+namespace Tests\Acceptance\profile;
+
+use App\Models\User;
+use Tests\Acceptance\BaseAcceptanceCest;
+use Tests\Support\AcceptanceTester;
+
+class ProfileCest extends BaseAcceptanceCest
+{
+    public function _before(AcceptanceTester $page): void
+    {
+        parent::_before($page);
+        $user = new User([
+            'name' => 'Fulano',
+            'email' => 'fulano@example.com',
+            'password' => '123456',
+            'password_confirmation' => '123456'
+        ]);
+        $user->save();
+    }
+
+    public function editOwnProfileFromNavbar(AcceptanceTester $page): void
+    {
+        $page->login('fulano@example.com', '123456');
+        $page->click('fulano@example.com');
+        $page->click('Editar perfil');
+
+        $page->seeCurrentUrlEquals('/profile/edit');
+        $page->see('Editar Perfil', '//h1');
+        $page->seeInField('user[name]', 'Fulano');
+
+        $page->fillField('user[name]', 'Beltrano');
+        $page->fillField('user[email]', 'beltrano@example.com');
+        $page->click('Salvar');
+
+        $page->seeCurrentUrlEquals('/dashboard');
+        $page->see('Perfil atualizado com sucesso!');
+        $page->see('Bem-vindo(a), Beltrano!');
+        $page->see('beltrano@example.com', '//nav');
+    }
+
+    public function editProfileWithEmptyNameShowsError(AcceptanceTester $page): void
+    {
+        $page->login('fulano@example.com', '123456');
+        $page->amOnPage('/profile/edit');
+
+        $page->fillField('user[name]', '');
+        $page->click('Salvar');
+
+        $page->see('Existem dados incorretos!');
+        $page->see('não pode ser vazio!');
+        $page->seeInField('user[email]', 'fulano@example.com');
+    }
+}
diff --git a/tests/Integration/Access/ProfileAccessTest.php b/tests/Integration/Access/ProfileAccessTest.php
new file mode 100644
index 0000000..6990e1d
--- /dev/null
+++ b/tests/Integration/Access/ProfileAccessTest.php
@@ -0,0 +1,38 @@
+<?php
+
+namespace Tests\Integration\Access;
+
+use GuzzleHttp\Client;
+use PHPUnit\Framework\TestCase;
+
+class ProfileAccessTest extends TestCase
+{
+    private Client $client;
+
+    public function setUp(): void
+    {
+        parent::setUp();
+        $this->client = new Client([
+            'allow_redirects' => false,
+            'base_uri' => 'http://web:8080'
+        ]);
+    }
+
+    public function test_edit_profile_should_redirect_to_login_without_session(): void
+    {
+        $response = $this->client->get('/profile/edit');
+
+        $this->assertEquals(302, $response->getStatusCode());
+        $this->assertEquals('/login', $response->getHeaderLine('Location'));
+    }
+
+    public function test_update_profile_should_redirect_to_login_without_session(): void
+    {
+        $response = $this->client->put('/profile', [
+            'form_params' => ['user' => ['name' => 'Invasor', 'email' => 'invasor@example.com']]
+        ]);
+
+        $this->assertEquals(302, $response->getStatusCode());
+        $this->assertEquals('/login', $response->getHeaderLine('Location'));
+    }
+}
diff --git a/tests/Integration/Controllers/ProfileControllerTest.php b/tests/Integration/Controllers/ProfileControllerTest.php
